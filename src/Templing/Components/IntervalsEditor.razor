@* Work / rest interval settings, shared by the Metronome (its Intervals section) and the Timer (its Countdown). *@
@inject MetronomeService Metro
@inject DataStore Store

@if (Pinned)
{
    <MudAlert Severity="Severity.Info" Dense="true">Set by your plan for this step.</MudAlert>
}
@* while a plan step sets the intervals, show its values, locked; yours come back when the plan ends *@
@{ var iv = Shown; }
@* an action, not a value: it always reads "Load preset" and fills in the fields below *@
@if (Presets.Count > 0)
{
    <MudSelect T="int?" Value="null" ValueChanged="Load" Label="Load preset" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Disabled="Pinned">
        @for (int i = 0; i < Presets.Count; i++)
        {
            var idx = i;
            var label = Label(Presets[i]);
            <MudSelectItem T="int?" Value="idx">@label</MudSelectItem>
        }
    </MudSelect>
}
@* Work · Rounds (a Repeat toggle for "until stopped", else a count), then Rest only when there's more than one round *@
<div class="form-grid interval-grid">
    <DurationInput Seconds="iv.WorkMin * 60" SecondsChanged="async v => { iv.WorkMin = (v ?? 15) / 60; await Apply(); }" Label="Work" MinSeconds="15" MaxSeconds="7200" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="Pinned" />
    <RoundsInput Rounds="iv.Rounds" RoundsChanged="async v => { iv.Rounds = v; await Apply(); }" Disabled="Pinned" />
    @if (iv.Rounds != 1)
    {
        <DurationInput Seconds="iv.RestMin * 60" SecondsChanged="async v => { iv.RestMin = (v ?? 0) / 60; await Apply(); }" Label="Rest" MaxSeconds="3600" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="Pinned" />
    }
</div>
<MudSwitch T="bool" @bind-Value="Settings.VoiceCues" @bind-Value:after="Apply" Color="Color.Primary" Label="Audio cues" Class="rail-line-switch" />

@code {
    public static IReadOnlyList<IntervalPreset> MetronomeDefaults { get; } = new[]
    {
        P(10, 0, 1), P(15, 0, 1), P(5, 1, 2), P(10, 2, 3), P(2, 0.5, 4), P(0.5, 0.25, 8),
    };

    public static IReadOnlyList<IntervalPreset> TimerDefaults { get; } = new[]
    {
        P(5, 0, 1), P(10, 0, 1), P(15, 0, 1), P(20, 0, 1), P(10, 2, 3), P(2, 0.5, 4),
    };

    static IntervalPreset P(double work, double rest, int rounds) => new() { WorkMin = work, RestMin = rest, Rounds = rounds };

    [Parameter, EditorRequired] public IntervalSettings Settings { get; set; } = default!;

    /// <summary>A plan step sets the intervals right now.</summary>
    bool Pinned => Metro.StepPinned;

    /// <summary>What the fields show: the plan step's intervals while it sets them (a copy, never saved), else the user's.</summary>
    IntervalSettings Shown => Pinned && Metro.EffectiveIntervals is var e
        ? new IntervalSettings { Enabled = true, WorkMin = e.WorkSec / 60, RestMin = e.RestSec / 60, Rounds = e.Rounds, VoiceCues = Settings.VoiceCues }
        : Settings;
    /// <summary>The Timer's countdown (its own presets) rather than the Metronome's intervals.</summary>
    [Parameter] public bool Timer { get; set; }

    IReadOnlyList<IntervalPreset> Presets => Timer
        ? Store.Settings.TimerIntervalPresets ?? TimerDefaults
        : Store.Settings.MetronomeIntervalPresets ?? MetronomeDefaults;

    /// <summary>"10 min", "3 × 10 min · 2 min rest", "8 × 30 sec · 15 sec rest", "Endless 5 min · 1 min rest".</summary>
    public static string Label(IntervalPreset p)
    {
        static string D(double min) => min < 1 ? $"{min * 60:0} sec" : $"{min:0.#} min";
        var work = p.Rounds switch { 1 => D(p.WorkMin), 0 => $"Endless {D(p.WorkMin)}", _ => $"{p.Rounds} × {D(p.WorkMin)}" };
        return p.RestMin > 0 && p.Rounds != 1 ? $"{work} · {D(p.RestMin)} rest" : work;
    }

    async Task Load(int? i)
    {
        if (i is not { } idx || idx < 0 || idx >= Presets.Count) return;
        var p = Presets[idx];
        var iv = Settings;
        iv.WorkMin = p.WorkMin; iv.RestMin = p.RestMin; iv.Rounds = p.Rounds;
        await Apply();
    }

    Task Apply() => Metro.ApplyAsync();
}
