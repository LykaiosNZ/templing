@* Pairing a device: shows a QR code of the pairing link and waits for the other device, or (Join) joins the pairing a
   scanned link belongs to. Once connected both show the same six-digit code; the device showing the QR code asks
   "Pair with …?", so a device that got to the code first (or anything in between) is caught by a code that doesn't
   match. Closes with the paired device. *@
@inject Devices Devices
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@implements IAsyncDisposable

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        @if (_failed != null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true">@_failed</MudAlert>
        }
        else if (_check != null)
        {
            <MudText Typo="Typo.body2" Class="mb-3">
                @(_check.Confirming ? $"Check that “{_check.Name}” shows the same number." : $"Check that “{_check.Name}” shows this number, then choose Pair on it.")
            </MudText>
            <div class="pair-number" aria-label="@($"Number {_check.Code}")">@(_check.Code[..3]) @(_check.Code[3..])</div>
            @if (_check.Again)
            {
                <MudText Typo="Typo.caption" Class="muted d-block mt-3">This replaces the pairing you already have with “@_check.Name”.</MudText>
            }
            @if (!_check.Confirming)
            {
                <div class="pair-status mt-3">
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                    <span>Waiting for the other device to confirm…</span>
                </div>
            }
        }
        else if (Join == null && _ready)
        {
            @if (_qr != null)
            {
                @* QR codes stay black on white in both themes: phone cameras read dark modules on a light ground *@
                <div class="pair-qr">
                    <svg viewBox="-4 -4 @(_qr.Size + 8) @(_qr.Size + 8)" role="img" aria-label="QR code of the pairing link" shape-rendering="crispEdges">
                        <rect x="-4" y="-4" width="@(_qr.Size + 8)" height="@(_qr.Size + 8)" fill="#fff" />
                        <path d="@_qr.D" fill="#000" />
                    </svg>
                </div>
            }
            @if (_code != null)
            {
                <div class="pair-code" aria-label="@($"Pairing code {string.Join(" ", _code.ToCharArray())}")">@Formatted</div>
            }
            <div class="pair-status">
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                <span>Waiting for the other device…</span>
            </div>
            <MudText Typo="Typo.caption" Class="muted d-block mt-2">The code works for 10 minutes.</MudText>
        }
        else
        {
            <div class="pair-status">
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                <span>@(Join == null ? "Making a code…" : "Connecting to the other device…")</span>
            </div>
        }
    </DialogContent>
    <DialogActions>
        @if (Join == null && _failed == null && _check == null && _ready && _link != null)
        {
            <MudButton StartIcon="@Icons.Material.Rounded.ContentCopy" OnClick="Copy">Copy link</MudButton>
        }
        @if (Join == null && _failed != null)
        {
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.QrCode2" OnClick="StartAsync">New code</MudButton>
        }
        <MudButton OnClick="Cancel">@(_failed != null ? "Close" : "Cancel")</MudButton>
        @if (_check is { Confirming: true } && _failed == null)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Confirm" Disabled="_confirmed">Pair</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance Dialog { get; set; } = default!;
    /// <summary>The secret from a scanned link, to join that pairing; null to show a new code.</summary>
    [Parameter] public string? Join { get; set; }

    sealed record Qr(int Size, string D);
    Qr? _qr;
    string? _link;
    string? _code;
    // K7Q2M-9XDAH: two groups of five, easier to read out and type
    string Formatted => _code is { Length: 10 } c ? $"{c[..5]}-{c[5..]}" : _code ?? "";
    string? _failed;
    PairCheck? _check;
    bool _confirmed, _done, _ready;
    DateTime _started = DateTime.UtcNow;

    string Title => _check is { Confirming: true } ? $"Pair with “{_check.Name}”?" : Join == null ? "Pair a device" : "Pairing";

    protected override async Task OnInitializedAsync()
    {
        Devices.Paired += OnPaired;
        Devices.PairFailed += OnFailed;
        Devices.PairChecking += OnCheck;
        Devices.PairReady += OnReady;
        if (Join != null)
        {
            if (!await Devices.PairJoinAsync(Join)) _failed = "That isn't a pairing code. Check it against the other device.";
        }
        else await StartAsync();
    }

    async Task StartAsync()
    {
        _failed = null;
        _qr = null;
        _check = null;
        _confirmed = false;
        _ready = false;   // "Making a code…" until the relay room is joined: shows that New code is trying
        _started = DateTime.UtcNow;
        _code = await Devices.PairStartAsync();
        _link = Nav.BaseUri + "pair#" + _code;
        var qr = System.Text.Json.JsonDocument.Parse(await QrPath(_link)).RootElement;
        _qr = new Qr(qr.GetProperty("size").GetInt32(), qr.GetProperty("d").GetString() ?? "");
    }

    async Task<string> QrPath(string text)
    {
        await using var qr = await JS.InvokeAsync<IJSObjectReference>("import", "./js/qr.js");
        return await qr.InvokeAsync<string>("path", text);
    }

    void OnReady() => InvokeAsync(() =>
    {
        _ready = true;
        StateHasChanged();
    });

    void OnCheck(PairCheck check) => InvokeAsync(() =>
    {
        _check = check;
        _link = null;   // nothing to copy any more
        StateHasChanged();
    });

    async Task Confirm()
    {
        _confirmed = true;
        await Devices.PairConfirmAsync(true);
    }

    void OnPaired(PairedDevice d) => InvokeAsync(() =>
    {
        _done = true;
        Dialog.Close(DialogResult.Ok(d));
    });

    void OnFailed(string reason) => InvokeAsync(async () =>
    {
        // an offline device fails in milliseconds: let "Making a code…" show for a moment, so New code visibly tries
        var shown = DateTime.UtcNow - _started;
        if (shown < TimeSpan.FromMilliseconds(600)) await Task.Delay(TimeSpan.FromMilliseconds(600) - shown);
        _check = null;
        _failed = reason switch
        {
            "proof" => "The other device couldn't be verified, so they weren't paired.",
            "self" => "That's this device's own code. Scan it with your other device.",
            "declined" => "Pairing was cancelled on the other device.",
            "unreachable" => "Couldn't reach the relay that devices pair through. This device may be offline.",
            "direct" => "These devices couldn't connect directly. This usually happens when one is on a VPN or a work network.",
            _ when Join == null => "Pairing didn't finish. The code may have run out, or the other device lost its connection.",
            _ => "Pairing didn't finish. The code may have run out: make a new one on the other device and scan it again.",
        };
        StateHasChanged();
    });

    async Task Copy()
    {
        if (_link == null) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _link);
        Snackbar.Add("Pairing link copied", Severity.Info);
    }

    void Cancel() => Dialog.Cancel();

    public async ValueTask DisposeAsync()
    {
        Devices.Paired -= OnPaired;
        Devices.PairFailed -= OnFailed;
        Devices.PairChecking -= OnCheck;
        Devices.PairReady -= OnReady;
        if (!_done) await Devices.PairCancelAsync();
    }

    /// <summary>Shows the code (or joins <paramref name="join"/>). The paired device, or null if it didn't happen.</summary>
    public static async Task<PairedDevice?> ShowAsync(IDialogService dialogs, string? join = null)
    {
        var p = new DialogParameters<PairDialog> { { x => x.Join, join } };
        var r = await dialogs.ShowAsync<PairDialog>(join == null ? "Pair a device" : "Pairing", p,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseButton = true });
        var res = await r.Result;
        return res is { Canceled: false, Data: PairedDevice d } ? d : null;
    }
}
