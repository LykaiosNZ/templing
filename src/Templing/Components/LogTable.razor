@inject DataStore Store
@inject IDialogService Dialogs

@if (Logs.Count == 0)
{
    @if (Empty != null) { @Empty } else { <MudText Class="muted pa-4">No entries yet</MudText> }
}
else
{
    <Pager Total="_ordered.Count" PageSize="PageSize" @bind-Page="_pageNo" @bind-Page:after="ShowPage" Label="Log pages">
    <div class="data-table-wrap hide-phone">
        <table class="data-table log-table">
            <thead>
                <tr>
                    <th scope="col">Date</th>
                    @if (ShowPiece) { <th scope="col">Piece</th> }
                    else if (_hasParts) { <th scope="col">Section</th> }
                    <th scope="col" class="num">Tempo</th>
                    <th scope="col" class="num">Time</th>
                    <th scope="col">Feel</th>
                    <th scope="col">Notes</th>
                    <th scope="col"><span class="sr-only">Edit</span></th>
                </tr>
            </thead>
            <tbody>
                @{ DateTime? prev = null; }
                @foreach (var l in _page)
                {
                    var newDay = prev != l.Date.Date;
                    prev = l.Date.Date;
                    var piece = Store.GetPiece(l.PieceId);
                    var section = piece?.Sections.Count > 1 ? piece.Sections.FirstOrDefault(s => s.Id == l.SectionId)?.Name : null;
                    var log = l;
                    var dayTotal = _dayTotals.GetValueOrDefault(l.Date.Date);
                    <tr class="clickable @(newDay ? "day-start" : "")" @onclick="() => Edit(log)">
                        <td class="date">
                            @if (newDay)
                            {
                                @* the day's total on the same line, so a day's first row is as tall as the rest *@
                                @Stats.Day(l.Date)@if (dayTotal > 0) { <span class="day-total"> · @Stats.Duration(dayTotal)</span> }
                            }
                        </td>
                        @if (ShowPiece)
                        {
                            <td>
                                @if (piece != null) { <a class="row-name" href="library/@piece.Id" @onclick:stopPropagation="true">@l.PieceName</a> } else { <span class="row-name">@l.PieceName</span> }
                                @if (section != null) { <span class="muted small"> · @section</span> }
                            </td>
                        }
                        else if (_hasParts)
                        {
                            <td class="@(section == null ? "muted" : "row-name")">@(section ?? "Full run-through")</td>
                        }
                        <td class="num mono">@l.ValueText</td>
                        <td class="num mono">@(l.DurationSec is { } d ? Stats.Duration(d) : "—")</td>
                        <td>
                            @if (Effort.Get(l.Effort) is { } feel)
                            {
                                <span class="feel-pill" style="--feel:@feel.Color" title="@feel.Advice">@feel.Label</span>
                            }
                        </td>
                        <td class="notes">@l.Notes</td>
                        <td class="act" @onclick:stopPropagation="true"><MudTooltip Text="Edit entry"><MudIconButton Size="Size.Small" Icon="@Icons.Material.Rounded.Edit" Class="row-edit" aria-label="@($"Edit entry {l.PieceName} {l.Date:d MMM}")" OnClick="() => Edit(log)" /></MudTooltip></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @* phones: compact rows instead of a wide table *@
    <div class="log-cards show-phone-block">
        @foreach (var day in _page.GroupBy(l => l.Date.Date))
        {
            var dt = _dayTotals.GetValueOrDefault(day.Key);
            <div class="log-day">
                <div class="log-day-head">@Stats.Day(day.Key)@if (dt > 0) { <span class="day-total"> · @Stats.Duration(dt)</span> }</div>
                @foreach (var l in day)
                {
                    var piece = Store.GetPiece(l.PieceId);
                    var section = piece?.Sections.Count > 1 ? piece.Sections.FirstOrDefault(s => s.Id == l.SectionId)?.Name : null;
                    var what = ShowPiece ? l.PieceName + (section != null ? $" · {section}" : "") : _hasParts ? section ?? "Full run-through" : null;
                    var log = l;
                    <div class="log-row clickable" @onclick="() => Edit(log)">
                        <div class="log-row-main">
                            @if (what != null) { <span class="log-what">@what</span> }
                            <span class="mono">@l.ValueText</span>
                            <span class="mono muted">@(l.DurationSec is { } d ? Stats.Duration(d) : "—")</span>
                            <span class="log-edit" @onclick:stopPropagation="true"><MudTooltip Text="Edit entry"><MudIconButton Size="Size.Small" Icon="@Icons.Material.Rounded.Edit" aria-label="@($"Edit entry {l.PieceName} {l.Date:d MMM}")" OnClick="() => Edit(log)" /></MudTooltip></span>
                        </div>
                        @if (Effort.Get(l.Effort) is { } feel || !string.IsNullOrWhiteSpace(l.Notes))
                        {
                            <div class="log-row-sub">
                                @if (Effort.Get(l.Effort) is { } f2) { <span class="feel-pill" style="--feel:@f2.Color">@f2.Label</span> }
                                @if (!string.IsNullOrWhiteSpace(l.Notes)) { <span class="muted">@l.Notes</span> }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
    </Pager>
}

@code {
    [Parameter] public List<PracticeLog> Logs { get; set; } = new();
    [Parameter] public bool ShowPiece { get; set; } = true;
    [Parameter] public int PageSize { get; set; } = 25;
    /// <summary>Shown instead of the default "No entries yet" when the list is empty (e.g. filtered to nothing).</summary>
    [Parameter] public RenderFragment? Empty { get; set; }
    Dictionary<DateTime, int> _dayTotals = new();
    // days newest first; within a day, in the order they were logged
    List<PracticeLog> _ordered = new();
    // the page shown (from 1) and its entries
    int _pageNo = 1;
    List<PracticeLog> _page = new();

    bool _hasParts;

    // single-piece view: show a Part column when the piece is split into sections
    protected override void OnParametersSet()
    {
        _hasParts = !ShowPiece && Logs.Select(l => l.PieceId).Distinct().Any(id => Store.GetPiece(id)?.Sections.Count > 1);
        _ordered = Logs.OrderByDescending(l => l.Date.Date).ThenBy(l => l.Logged ?? DateTime.MinValue).ThenBy(l => l.PieceName).ToList();
        _dayTotals = Logs.GroupBy(l => l.Date.Date).ToDictionary(g => g.Key, g => g.Sum(l => l.DurationSec ?? 0));
        // the same page after an edit, unless the list got shorter than it (the parent's @key starts a new list on page 1)
        _pageNo = Pager.Clamp(_pageNo, _ordered.Count, PageSize);
        ShowPage();
    }

    void ShowPage() => _page = Pager.Slice(_ordered, _pageNo, PageSize).ToList();

    async Task Edit(PracticeLog l)
    {
        // edit a copy so cancel is clean
        var copy = System.Text.Json.JsonSerializer.Deserialize<PracticeLog>(System.Text.Json.JsonSerializer.Serialize(l, DataStore.Json), DataStore.Json)!;
        await LogDialog.ShowAsync(Dialogs, copy, false);
    }
}
