@* A section of the options rail. With OnChanged (e.g. @bind-On) the whole header is the feature's on/off switch:
   its icon sits in a circle that's lit while on (the same look as the hidden rail's strip buttons), and the fields
   show only while it's on. Without OnChanged it's always open (Sound, Time signature, Countdown): plain icon and title.
   Switches inside a section are its own options (Stop at end, Audio cues). *@

<section class="rail-sec @(Switchable ? (On ? "on" : "off") : "always")" aria-label="@Title">
    @if (Switchable)
    {
        <h3 class="rail-sec-heading">
            <button type="button" class="rail-sec-head rail-sec-toggle" role="switch" aria-checked="@(On ? "true" : "false")" disabled="@Disabled" @onclick="Toggle">
                <span class="rail-sec-dot" aria-hidden="true"><MudIcon Icon="@Icon" Size="Size.Small" /></span>
                <span class="rail-sec-title">@Title</span>
            </button>
        </h3>
    }
    else
    {
        <div class="rail-sec-head">
            <MudIcon Icon="@Icon" Size="Size.Small" Class="rail-sec-icon" />
            <h3 class="rail-sec-title">@Title</h3>
        </div>
    }
    @if (ChildContent != null && (!Switchable || On))
    {
        <div class="rail-sec-body">@ChildContent</div>
    }
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string Icon { get; set; } = "";
    [Parameter] public bool On { get; set; }
    [Parameter] public EventCallback<bool> OnChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>The switch can't be used (e.g. a plan step sets this feature); the fields stay visible while on.</summary>
    [Parameter] public bool Disabled { get; set; }

    bool Switchable => OnChanged.HasDelegate;

    Task Toggle() => OnChanged.InvokeAsync(!On);
}
