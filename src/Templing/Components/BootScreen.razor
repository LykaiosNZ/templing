@* The second half of the loading screen: same look as the one in wwwroot/index.html (which covers the download),
   shown by MainLayout while the library loads from IndexedDB. Keep the two in step. *@

<div class="boot" role="status" aria-live="polite">
    <div class="boot-card">
        <div class="boot-mark" aria-hidden="true"><LogoMark /></div>
        <div class="boot-name">Templing</div>
        <div class="boot-tag">Practice tracker</div>
        <div class="boot-bar indeterminate" aria-hidden="true"><div class="boot-bar-fill"></div></div>
        <div class="boot-status">Opening your library…</div>
    </div>
    <div class="boot-foot">Everything stays on this device</div>
</div>
