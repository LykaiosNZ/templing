@* A duration as one h:mm:ss field: three numbers with fixed colons (like MeterInput), so a colon can't be deleted.
   Type into each; ":" moves on, and a digit typed into a full number starts the next one (so "4530" is 45:30);
   ←/→ move between them at the edges, Backspace at the start goes back. ↑/↓ step the number you're in (Shift ×5;
   with StepSeconds, minutes step by that instead). Each
   number commits as you leave it, overflow carries (75 minutes → 1:15:00) and the total is clamped to Min/Max.
   Value in seconds. *@

<MudField Label="@Label" Variant="Variant" Margin="Margin" InnerPadding="false" HelperText="@HelperText" Disabled="Disabled"
          Class="@($"duration-input {Class}")" Style="@Style">
    <span class="seg-parts @(Variant == Variant.Text ? "seg-text" : null)" role="group" aria-label="@($"{AriaLabel ?? Label} (hours:minutes:seconds)")"
          onkeydown="@SegmentKeys">
        <input class="seg-part" style="@($"width:{HourDigits + 0.3}ch")" inputmode="numeric" autocomplete="off" maxlength="@HourDigits" aria-label="Hours" disabled="@Disabled"
               @bind="_h" @bind:event="oninput" @onchange="Commit" @onkeydown="e => Step(e, 3600)" onfocus="this.select()" />
        <span class="seg-colon" aria-hidden="true">:</span>
        <input class="seg-part" style="width:2.2ch" inputmode="numeric" autocomplete="off" maxlength="2" aria-label="Minutes" disabled="@Disabled"
               @bind="_m" @bind:event="oninput" @onchange="Commit" @onkeydown="e => Step(e, 60)" onfocus="this.select()" />
        <span class="seg-colon" aria-hidden="true">:</span>
        <input class="seg-part" style="width:2.2ch" inputmode="numeric" autocomplete="off" maxlength="2" aria-label="Seconds" disabled="@Disabled"
               @bind="_s" @bind:event="oninput" @onchange="Commit" @onkeydown="e => Step(e, 1)" onfocus="this.select()" />
    </span>
</MudField>

@code {
    [Parameter] public string? Label { get; set; }
    /// <summary>Accessible name when there's no visible <see cref="Label"/> (e.g. a settings row names the field).</summary>
    [Parameter] public string? AriaLabel { get; set; }
    /// <summary>Duration in seconds; null = empty (only when <see cref="Nullable"/>).</summary>
    [Parameter] public double? Seconds { get; set; }
    [Parameter] public EventCallback<double?> SecondsChanged { get; set; }
    /// <summary>Emptying all three numbers means "no value" (otherwise blanks read as 0).</summary>
    [Parameter] public bool Nullable { get; set; }
    [Parameter] public double MinSeconds { get; set; }
    [Parameter] public double MaxSeconds { get; set; } = 24 * 3600;
    /// <summary>What ↑/↓ step on the minutes (e.g. 900 = 15 min); hours and seconds always step by 1.</summary>
    [Parameter] public double? StepSeconds { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public Variant Variant { get; set; } = Variant.Text;
    [Parameter] public Margin Margin { get; set; } = Margin.None;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    // Plain DOM, so it's instant. Digits only; ":" moves right; ←/→ at an edge and Backspace at the
    // start move between numbers (the colons stay put). Leaving a number fires its change, which commits it.
    const string SegmentKeys = "const ins = [...this.querySelectorAll('input')], t = event.target, i = ins.indexOf(t), k = event.key;"
        + "if (i < 0 || event.ctrlKey || event.metaKey || event.altKey) return;"
        + "const go = n => { const x = ins[n]; if (!x) return; event.preventDefault(); x.focus(); x.select(); };"
        + "if (k === ':' ) go(i + 1);"
        + "else if (k === 'ArrowRight' && t.selectionEnd === t.value.length) go(i + 1);"
        + "else if (k === 'ArrowLeft' && t.selectionStart === 0) go(i - 1);"
        + "else if (k === 'Backspace' && t.selectionStart === 0 && t.selectionEnd === 0 && i > 0) { event.preventDefault(); const p = ins[i - 1]; p.focus(); p.setSelectionRange(p.value.length, p.value.length); }"
        + "else if (k.length === 1 && !/[0-9]/.test(k)) event.preventDefault();"
        // a digit typed into a full number (cursor at the end, nothing selected) starts the next one, so "4530" types 45:30
        + "else if (k.length === 1 && t.value.length >= t.maxLength && t.selectionStart === t.selectionEnd && t.selectionEnd === t.value.length && i < ins.length - 1)"
        + " { event.preventDefault(); const n = ins[i + 1]; n.focus(); n.value = k; n.setSelectionRange(1, 1); n.dispatchEvent(new Event('input', { bubbles: true })); }";


    string _h = "", _m = "", _s = "";
    double? _shown = double.NaN;

    int HourDigits => Math.Max(1, ((int)(MaxSeconds / 3600)).ToString().Length);

    protected override void OnParametersSet()
    {
        // reflect outside changes (presets, plan steps); typing doesn't change Seconds until it's committed
        if (Seconds != _shown) Show(Seconds);
    }

    void Show(double? seconds)
    {
        _shown = seconds;
        if (seconds is not { } sec) { _h = _m = _s = ""; return; }
        var ts = TimeSpan.FromSeconds(Math.Max(0, Math.Round(sec)));
        _h = ((int)ts.TotalHours).ToString(); _m = ts.Minutes.ToString("00"); _s = ts.Seconds.ToString("00");
    }

    /// <summary>The three numbers as seconds (blanks are 0), or null when all are blank and the field allows it.</summary>
    double? Typed()
    {
        if (Nullable && string.IsNullOrWhiteSpace(_h + _m + _s)) return null;
        static int N(string t) => int.TryParse(t, out var n) ? Math.Max(0, n) : 0;
        return N(_h) * 3600 + N(_m) * 60 + N(_s);
    }

    async Task Commit() => await Set(Typed());

    async Task Set(double? v)
    {
        if (v is { } x) v = Math.Clamp(Math.Round(x), MinSeconds, MaxSeconds);
        var changed = v != Seconds;
        Show(v); // tidy: zero-pad, carry overflow, apply the clamp
        if (changed) await SecondsChanged.InvokeAsync(v);
    }

    async Task Step(KeyboardEventArgs e, int unit)
    {
        if (e.Key is not ("ArrowUp" or "ArrowDown") || Disabled) return;
        var step = unit == 60 && StepSeconds is >= 60 ? StepSeconds.Value : unit;
        if (e.ShiftKey) step *= 5;
        await Set((Typed() ?? Seconds ?? 0) + (e.Key == "ArrowUp" ? step : -step));
    }
}
