@* Sticky banner for a running practice plan: where you are, what's next, and step controls.
   Also owns logging when a step finishes (ask by default, or auto-log per settings). *@
@implements IDisposable
@inject PlanRunner Runner
@inject MetronomeService Metro
@inject DataStore Store
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject Shortcuts Keys

@if (Runner.Active && Runner.Plan is { } plan && Runner.Current is { } step)
{
    <section class="plan-bar @(step.Kind == PlanStepKind.Rest ? "rest" : "")" aria-label="Practice plan">
        <div class="plan-bar-main">
            <div class="plan-bar-info">
                <span class="plan-name">@plan.Name <span class="plan-left">· step @(Runner.Index + 1) of @plan.Steps.Count · about @Stats.Duration((int)(Runner.MinutesLeft * 60)) left</span></span>
                <span class="plan-step">
                    <strong>@Runner.Describe(step)</strong>
                    <span class="muted plan-step-meta"> · @step.IntervalText@(step.Kind == PlanStepKind.Piece ? $" · {(step.Mode == StepMode.Timer ? "timer" : "metronome")}" : "")@(step.TempoText(Store.GetPiece(step.PieceId)?.Unit ?? TempoUnit.Bpm) is { Length: > 0 } tt ? $" · {tt}" : "")</span>
                </span>
                <span class="plan-next muted">@(Runner.NextStep is { } next ? $"Next: {Runner.Describe(next)} · {next.IntervalText}" : "Last step")</span>
            </div>
            <div class="plan-bar-actions">
                @if (Runner.State == StepState.Ready)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.PlayArrow" OnClick="() => Runner.StartStepAsync()">
                        @(step.Kind == PlanStepKind.Rest ? "Start rest" : Metro.SessionActiveSec >= 1 ? "Resume" : "Start step")
                    </MudButton>
                    @if (step.Kind == PlanStepKind.Piece && Metro.SessionActiveSec >= 1)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.Done" OnClick="FinishEarly">Finish step</MudButton>
                    }
                }
                <span class="plan-nav" role="group" aria-label="Step navigation">
                    <MudTooltip Text="Back">
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Rounded.SkipPrevious" aria-label="Previous step" Disabled="Runner.Index == 0" OnClick="Back" />
                    </MudTooltip>
                    <MudTooltip Text="@(Runner.IsLast ? "Finish" : "Skip")">
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Rounded.SkipNext" aria-label="@(Runner.IsLast ? "Finish the plan" : "Skip to the next step")" OnClick="Skip" />
                    </MudTooltip>
                </span>
                <MudTooltip Text="Edit plan">
                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Rounded.Edit" aria-label="@($"Edit {plan.Name}")" OnClick="EditPlan" />
                </MudTooltip>
                <MudTooltip Text="End plan">
                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Rounded.Close" Class="plan-end" aria-label="@($"End {plan.Name}")" OnClick="End" />
                </MudTooltip>
            </div>
        </div>
        <div class="plan-dots" role="group" aria-label="Steps">
            @for (int i = 0; i < plan.Steps.Count; i++)
            {
                var idx = i;
                var s = plan.Steps[i];
                var state = i == Runner.Index ? "on" : Runner.Completed.Contains(s.Id) ? "done" : i < Runner.Index ? "skipped" : "";
                var label = $"Step {i + 1}: {Runner.Describe(s)} · {s.IntervalText}{(state == "done" ? " (done)" : state == "skipped" ? " (skipped)" : state == "on" ? " (current)" : "")}";
                <button type="button" class="plan-dot @state @(s.Kind == PlanStepKind.Rest ? "rest" : "")" title="@label" aria-label="@label"
                        aria-current="@(state == "on" ? "step" : null)" @onclick="() => JumpTo(idx)"></button>
            }
        </div>
    </section>
}
else if (Runner.Summary is { } sum)
{
    <section class="plan-bar done" aria-label="Plan finished" role="status">
        <div class="plan-bar-main">
            <div class="plan-bar-info">
                <span class="plan-name">@sum.Name</span>
                <span class="plan-step">
                    <strong>@(sum.Logs > 0 || sum.Done > 0 ? "Plan complete." : "Plan ended.")</strong>
                    <span class="muted"> @sum.Done of @sum.Steps steps · @(sum.Logs == 1 ? "1 log" : $"{sum.Logs} logs") · @Stats.Duration(sum.LoggedSec) practised</span>
                </span>
            </div>
            <div class="plan-bar-actions">
                <MudTooltip Text="View history">
                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Rounded.History" Href="history" aria-label="View history" OnClick="() => Runner.DismissSummary()" />
                </MudTooltip>
                <MudTooltip Text="Dismiss">
                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Rounded.Close" aria-label="Dismiss" OnClick="() => Runner.DismissSummary()" />
                </MudTooltip>
            </div>
        </div>
    </section>
}

@code {
    protected override void OnInitialized()
    {
        Runner.Changed += OnChanged;
        Metro.Changed += OnChanged;
        Runner.StepFinished += OnStepFinished;
        Runner.EditRequested += OnEditRequested;
        Keys.Register(this, Hotkeys.PrevPlanStep, async () => { if (Runner.Active && Runner.Index > 0) await Back(); });
        Keys.Register(this, Hotkeys.NextPlanStep, async () => { if (Runner.Active) await Skip(); });
    }

    void OnChanged() => InvokeAsync(StateHasChanged);

    async Task OnStepFinished(PlanStep step) => await InvokeAsync(() => LogAndAdvance(step));

    Task OnEditRequested() => InvokeAsync(EditPlan);

    /// <summary>Edit the running plan, for this session or saved to the plan.</summary>
    async Task EditPlan()
    {
        if (Runner.Plan is not { } plan) return;
        await PlanDialog.EditRunningAsync(Dialogs, plan, Runner.Current?.Id, ApplyEdit);
    }

    /// <summary>A changed current step starts again, so its practice time is logged or discarded first (backing out keeps the editor open).</summary>
    async Task<bool> ApplyEdit(PracticePlan edited, bool toPlan)
    {
        if (Runner.ChangesCurrentStep(edited) && !await ConfirmLeave("Change this step")) return false;
        await Runner.ApplyEditAsync(edited, toPlan);
        return true;
    }

    bool HasUnlogged => Metro.SessionActiveSec >= 1 && Runner.Current is { Kind: PlanStepKind.Piece };

    /// <summary>Logs the current step's session (auto or via the dialog). Returns false if the user backed out of the dialog.</summary>
    async Task<bool> LogCurrent(PlanStep step, bool ask)
    {
        var log = Metro.BuildSessionLog();
        log.Source = "plan";
        if (step.SectionId != null) log.SectionId = step.SectionId;
        bool saved;
        if (!ask)
        {
            await Store.SaveLogAsync(log);
            Snackbar.Add($"Logged {Stats.Clock(Metro.SessionActiveSec)} of {Runner.Describe(step)}", Severity.Success);
            saved = true;
        }
        else saved = await LogDialog.ShowAsync(Dialogs, log, isNew: true);
        if (saved)
        {
            await Runner.RecordLoggedAsync(log.DurationSec);
            Metro.ResetSession();
        }
        return saved;
    }

    /// <summary>The step reached its end: log it (asking, unless auto-log is on) and move on. Backing out of the dialog discards it.</summary>
    async Task LogAndAdvance(PlanStep step)
    {
        if (Metro.SessionActiveSec >= 1 && !await LogCurrent(step, ask: !Store.Settings.AutoLogPlanSteps)) Metro.ResetSession();
        await Runner.AdvanceAsync();
    }

    /// <summary>Finish step before its end: always asks, even with auto-log on, since the step didn't run its course. Backing out stays.</summary>
    async Task FinishEarly()
    {
        if (Runner.Current is not { } s) return;
        if (Metro.SessionActiveSec >= 1 && !await LogCurrent(s, ask: true)) return;
        await Runner.AdvanceAsync();
    }

    /// <summary>
    /// Before leaving a step that's running or has practice time: log it, discard it, or keep going. Logging always
    /// shows the log dialog (auto-log is only for steps that reach their end); backing out of it stays. Returns false to stay.
    /// </summary>
    async Task<bool> ConfirmLeave(string verb)
    {
        if (Runner.Current is not { } step) return true;
        if (HasUnlogged)
        {
            var r = await ConfirmDialog.ShowAsync(Dialogs, $"{verb}?",
                $"You have {Stats.Duration((int)Metro.SessionActiveSec)} on {Runner.Describe(step)} that hasn't been logged.",
                "Log it", cancel: "Keep going", alt: "Discard", altDestructive: true);
            if (r == null) return false;
            await Metro.StopAsync();
            if (r == true) return await LogCurrent(step, ask: true);
            Metro.ResetSession();
            return true;
        }
        if (Metro.IsRunning)
        {
            var ok = await ConfirmDialog.ShowAsync(Dialogs, $"{verb}?",
                $"{(step.Kind == PlanStepKind.Rest ? "Your rest" : "This step")} is still running.", verb, cancel: "Keep going");
            if (ok != true) return false;
            await Metro.StopAsync();
        }
        return true;
    }

    async Task JumpTo(int index)
    {
        if (index == Runner.Index || index < 0) return;
        if (!await ConfirmLeave("Leave this step")) return;
        await Runner.GoToAsync(index);
    }

    async Task Back()
    {
        if (Runner.Index == 0 || !await ConfirmLeave("Leave this step")) return;
        await Runner.BackAsync();
    }

    async Task Skip()
    {
        if (!await ConfirmLeave(Runner.IsLast ? "Finish the plan" : "Skip this step")) return;
        if (Runner.IsLast) await Runner.EndAsync(finished: true);
        else await Runner.SkipAsync();
    }

    async Task End()
    {
        if (HasUnlogged || Metro.IsRunning)
        {
            if (!await ConfirmLeave("End plan")) return;
        }
        else
        {
            var ok = await ConfirmDialog.ShowAsync(Dialogs, "End plan?",
                $"You're on step {Runner.Index + 1} of {Runner.Plan?.Steps.Count}. Logs already saved are kept.",
                "End plan", cancel: "Keep going");
            if (ok != true) return;
        }
        await Runner.EndAsync();
    }

    public void Dispose()
    {
        Runner.Changed -= OnChanged;
        Metro.Changed -= OnChanged;
        Runner.StepFinished -= OnStepFinished;
        Runner.EditRequested -= OnEditRequested;
        Keys.Unregister(this);
    }
}
