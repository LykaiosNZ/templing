@* Tempo over time (ECharts via ChartBase): each day's top tempo, a whisker down to its lowest, dots coloured by feel,
   dashed goal line. *@
@inherits ChartBase

<div class="viz" role="img" aria-label="@AriaLabel">
    @if (Points.Count == 0)
    {
        <div class="viz-empty">No tempo data yet</div>
    }
    else
    {
        @if (Goal is { } g)
        {
            <div class="viz-key" aria-hidden="true"><span class="viz-key-goal"></span>Goal @Value(g)</div>
        }
        <div @ref="El" style="height:@(Height)px"></div>
    }
</div>

@code {
    [Parameter] public List<TempoPoint> Points { get; set; } = new();
    [Parameter] public double? Goal { get; set; }
    [Parameter] public TempoUnit Unit { get; set; }
    [Parameter] public int Height { get; set; } = 260;
    [Parameter] public string AriaLabel { get; set; } = "Tempo progress chart";

    protected override string Kind => "tempo";

    string Value(double v) => $"{v:0}{Unit.Suffix()}";

    protected override object? BuildSpec()
    {
        if (Points.Count == 0) return null;
        var vals = Points.Select(p => p.Value).Concat(Points.Where(p => p.Min.HasValue).Select(p => p.Min!.Value)).ToList();
        if (Goal.HasValue) vals.Add(Goal.Value);
        var lo = vals.Min(); var hi = vals.Max();
        var span = Math.Max(10, hi - lo);
        var step = NiceStep(span / 4);
        var min = Math.Max(0, Math.Floor((lo - span * 0.05) / step) * step);
        var (_, max, _, labels) = Ticks(min, hi + span * 0.05, step, v => $"{v:0}{(Unit == TempoUnit.Percent ? "%" : "")}");
        return new
        {
            points = Points.Select(p =>
            {
                var feel = Effort.Get(p.Effort);
                var range = p.Min is { } mn && mn < p.Value ? $"{mn:0}–{Value(p.Value)}" : Value(p.Value);
                return new
                {
                    date = IsoDate(p.Date),
                    value = p.Value,
                    min = p.Min,
                    color = feel?.Color,
                    tip = feel is null ? range : $"{range} · {feel.Label}",
                    sub = Stats.Day(p.Date),
                    note = string.IsNullOrWhiteSpace(p.Note) ? null : p.Note!.Length > 80 ? p.Note[..80] + "…" : p.Note,
                };
            }).ToList(),
            yMin = min,
            yMax = max,
            yStep = step,
            yLabels = labels,
            goal = Goal,
        };
    }
}
