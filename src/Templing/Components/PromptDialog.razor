@* Asks for one name (save / rename). The field is focused with its text selected, Enter saves, and Save says why
   it's disabled (empty, or a name that's already taken). *@
<MudDialog>
    <DialogContent>
        <MudTextField @ref="_field" T="string" @bind-Value="_value" Label="@Label" Placeholder="@Placeholder" Immediate="true" OnKeyDown="KeyDown" OnKeyUp="KeyUp" />
    </DialogContent>
    <DialogActions>
        @if (Blocker is { } why)
        {
            <MudText Typo="Typo.body2" Class="muted ml-2">@why</MudText>
        }
        <MudSpacer />
        <MudButton OnClick="() => Dialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(Blocker != null)" OnClick="Ok">@OkText</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public string Label { get; set; } = "Name";
    [Parameter] public string? Value { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string OkText { get; set; } = "Save";
    /// <summary>Names already in use (compared ignoring case); the current <see cref="Value"/> is always allowed.</summary>
    [Parameter] public IEnumerable<string> Taken { get; set; } = [];

    MudTextField<string>? _field;
    string? _value;

    string? Blocker
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_value)) return "Add a name";
            var name = _value.Trim();
            if (string.Equals(name, Value?.Trim(), StringComparison.OrdinalIgnoreCase)) return null;
            var clash = Taken.FirstOrDefault(t => string.Equals(t.Trim(), name, StringComparison.OrdinalIgnoreCase));
            return clash is null ? null : $"You already have “{clash.Trim()}”";
        }
    }

    protected override void OnInitialized() => _value = Value;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _field is null) return;
        await Task.Yield(); // after the dialog has taken focus for itself
        await _field.FocusAsync();
        if (!string.IsNullOrEmpty(_value)) await _field.SelectAsync();
    }

    void Ok()
    {
        if (Blocker != null) return;
        Dialog.Close(DialogResult.Ok(_value!.Trim()));
    }

    // Enter acts on its keyup: closing on the keydown hands focus back to the button that opened the dialog, and the
    // same key's keypress then clicks it, opening the dialog again. Only an Enter that went down here counts, so
    // opening the dialog with Enter doesn't close it as the key comes up.
    bool _enterDown;
    void KeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") _enterDown = true; }
    void KeyUp(KeyboardEventArgs e) { if (e.Key == "Enter" && _enterDown) Ok(); }

    public static async Task<string?> ShowAsync(IDialogService d, string title, string label, string? value = null, string ok = "Save",
        string? placeholder = null, IEnumerable<string>? taken = null)
    {
        var p = new DialogParameters<PromptDialog>
        {
            { x => x.Label, label }, { x => x.Value, value }, { x => x.OkText, ok },
            { x => x.Placeholder, placeholder }, { x => x.Taken, taken ?? [] },
        };
        var r = await d.ShowAsync<PromptDialog>(title, p, new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseButton = true });
        var res = await r.Result;
        return res is { Canceled: false } ? res.Data as string : null;
    }
}
