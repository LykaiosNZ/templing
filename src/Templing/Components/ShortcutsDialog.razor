@* Generated from Hotkeys.All, the same entries the key handlers bind to, so the list can't drift from what works. *@
<MudDialog>
    <DialogContent>
        @* one grid for every group, so the descriptions line up down the whole list *@
        <dl class="shortcut-list">
            @foreach (var g in Hotkeys.All.GroupBy(h => h.Group))
            {
                var note = Hotkeys.GroupNote(g.Key);
                <dt class="shortcut-group stat-label">@g.Key@if (note != null) {<span class="shortcut-note"> · @note</span>}</dt>
                @foreach (var h in g)
                {
                    <dt>
                        @for (int i = 0; i < h.Combos.Count; i++)
                        {
                            if (i > 0)
                            {
                                <span class="muted sep">or</span>
                            }
                            foreach (var (text, key) in Hotkeys.Display(h.Combos[i]))
                            {
                                if (key)
                                {
                                    <kbd>@text</kbd>
                                }
                                else
                                {
                                    <span class="muted sep">@text</span>
                                }
                            }
                        }
                    </dt>
                    <dd>@h.Description</dd>
                }
            }
        </dl>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance Dialog { get; set; } = default!;
}
