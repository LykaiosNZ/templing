@inject DataStore Store
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsNew ? "Log practice" : "Edit log entry")</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Class="d-flex flex-column gap-3">
            <div class="d-flex gap-3">
                <SourcePicker Label="Piece" BrowseTitle="Choose a piece" FreeLabel="Free practice" Key="@PieceKey" Sections="true" Form="true"
                              OnPick="PickPiece" Style="flex:2 1 0" />
                <MudDatePicker Label="Date" @bind-Date="_date" DateFormat="ddd d MMM yyyy" Editable="true" MaxDate="DateTime.Today" Style="flex:1 1 0; min-width:150px" />
            </div>
            @if (_piece == null)
            {
                <MudTextField @bind-Value="_name" Label="What did you practise?" />
            }
            else if (_piece.Sections.Count > 1)
            {
                <MudSelect T="string" Label="Section" @bind-Value="SectionPick">
                    <MudSelectItem T="string" Value="@("")">Full run-through</MudSelectItem>
                    @foreach (var s in _piece.Sections)
                    {
                        <MudSelectItem T="string" Value="@s.Id">@s.Name (@s.Bpm.ToString("0") bpm, @s.Meter)</MudSelectItem>
                    }
                </MudSelect>
            }
            <div class="d-flex gap-3">
                <MudTextField @bind-Value="_tempo" Label="@($"Tempo reached{(_piece != null ? $" ({(_piece.Unit == TempoUnit.Percent ? "%" : "bpm")})" : "")}")"
                              Placeholder="120, 65–145 or 85%" Class="flex-1" Immediate="true" AutoFocus="true" />
                <DurationInput Seconds="_seconds" SecondsChanged="v => _seconds = v" Nullable="true" Label="Active time" Class="flex-1" />
            </div>
            <EffortSlider @bind-Value="_effort" />
            <MudTextField @bind-Value="_notes" Label="Notes" Lines="2" Sizing="InputSizing.Auto" MaxLines="6" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        @if (!IsNew)
        {
            <MudButton Color="Color.Error" OnClick="Delete" StartIcon="@Icons.Material.Rounded.Delete">Delete</MudButton>
            <MudSpacer />
        }
        <MudButton OnClick="() => Dialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="@(_piece == null && string.IsNullOrWhiteSpace(_name))">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public PracticeLog Log { get; set; } = new();
    [Parameter] public bool IsNew { get; set; }

    MudForm? _form;
    DateTime? _date;
    string? _pieceId, _sectionId, _name, _tempo, _notes;
    double? _seconds;
    int? _effort;
    Piece? _piece;
    // the piece picker's key: "free" is Free practice
    string PieceKey => _pieceId is null ? "free" : $"piece:{_pieceId}";
    // the Section select shows "Full run-through" as an explicit "" option rather than an empty field
    string SectionPick { get => _sectionId ?? ""; set => _sectionId = string.IsNullOrEmpty(value) ? null : value; }

    public static async Task<bool> ShowAsync(IDialogService dialogs, PracticeLog log, bool isNew)
    {
        var p = new DialogParameters<LogDialog> { { x => x.Log, log }, { x => x.IsNew, isNew } };
        var r = await dialogs.ShowAsync<LogDialog>(isNew ? "Log practice" : "Edit entry", p,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
        var res = await r.Result;
        return res is { Canceled: false };
    }

    protected override void OnInitialized()
    {
        _date = Log.Date;
        _pieceId = Log.PieceId;
        _piece = Store.GetPiece(_pieceId);
        _sectionId = Log.SectionId;
        _name = Log.PieceName;
        _notes = Log.Notes;
        _effort = Log.Effort;
        _seconds = Log.DurationSec;
        if (Log.Value is { } v)
        {
            var suf = Log.Unit == TempoUnit.Percent ? "%" : "";
            _tempo = Log.ValueMin is { } mn && mn != v ? $"{mn:0} - {v:0}{suf}" : $"{v:0}{suf}";
        }
    }

    // "free", "piece:<id>" or, from the browse dialog, "piece:<id>/<sectionId>"
    void PickPiece(string key)
    {
        var (kind, id) = SourceOption.Split(key);
        string? section = null;
        if (kind == "piece" && id.IndexOf('/') is var slash and > 0) (id, section) = (id[..slash], id[(slash + 1)..]);
        _pieceId = kind == "piece" ? id : null;
        _piece = Store.GetPiece(_pieceId);
        _sectionId = _piece?.Sections.Any(s => s.Id == section) == true ? section : null;
        if (_piece != null) _name = _piece.Name;
    }

    async Task Save()
    {
        var (min, max, unit) = LogCsv.ParseSpeed(_tempo);
        if (_piece != null && !(_tempo ?? "").Contains('%') && !(_tempo ?? "").Contains("bpm", StringComparison.OrdinalIgnoreCase))
            unit = _piece.Unit;
        Log.Date = (_date ?? DateTime.Today).Date;
        Log.PieceId = _piece?.Id;
        Log.PieceName = _piece?.Name ?? _name?.Trim() ?? "Practice";
        Log.SectionId = _piece != null ? _sectionId : null;
        Log.Unit = unit;
        Log.Value = max;
        Log.ValueMin = min;
        Log.DurationSec = _seconds is { } sec ? (int)Math.Round(sec) : null;
        Log.Notes = string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim();
        Log.Effort = _effort;
        await Store.SaveLogAsync(Log);
        Dialog.Close(DialogResult.Ok(Log));
    }

    async Task Delete()
    {
        var what = $"{Log.PieceName} on {Stats.Day(Log.Date)}";
        if (!await ConfirmDialog.DeleteAsync(Dialogs, "entry", what, quote: false)) return;
        await Store.DeleteLogAsync(Log);
        Snackbar.Add($"Deleted {what}", Severity.Info);
        Dialog.Close(DialogResult.Ok(Log));
    }
}
