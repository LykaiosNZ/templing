<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <!-- the app's version, shown in Settings > About (AppInfo); the build adds the commit (+sha) to the informational version -->
    <Version>0.1.0</Version>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);BL0016</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <StaticWebAssetSpaFallbackEnabled>true</StaticWebAssetSpaFallbackEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Gateway" Version="11.0.0" PrivateAssets="all" />
    <PackageReference Include="MudBlazor" Version="9.14.0" />
  </ItemGroup>

  <!-- version.json beside the published app: the running app compares it with its own version to notice a newer
       deployment (Services/UpdateCheck.cs). Written after publishing, when the commit is already in the version. -->
  <Target Name="WriteVersionFile" AfterTargets="Publish">
    <WriteLinesToFile File="$(PublishDir)wwwroot/version.json" Lines="{&quot;version&quot;:&quot;$(InformationalVersion)&quot;}" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

</Project>
