<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <!-- the app's version, shown in Settings > About (AppInfo); the build adds the commit (+sha) to the informational version -->
    <Version>0.1.0</Version>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);BL0016</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <StaticWebAssetSpaFallbackEnabled>true</StaticWebAssetSpaFallbackEnabled>
  </PropertyGroup>

  <!-- Fingerprint every .js file (name.<hash>.js) and list it in index.html's import map. GitHub Pages lets browsers
       cache files for 10 minutes, so an unfingerprinted module could stay old after a release while the new app code
       calls functions it doesn't have yet. JS imports go through the map; plain script tags must use #[.{fingerprint}]
       (index.html) or import.meta.resolve (charts.js, score.js), as the old names aren't published. -->
  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="AppJs" Pattern="*.js" Expression="#[.{fingerprint}]!" />
  </ItemGroup>

  <!-- The relay devices meet through to pair and send backups (relay/ in the repo, AppInfo.RelayUrl). A local one
       for development: -p:RelayUrl=ws://localhost:8787 with `npm run dev` in relay/ (.claude/launch.json has both). -->
  <PropertyGroup>
    <RelayUrl Condition="'$(RelayUrl)' == ''">wss://templing-relay.lykaiosnz.workers.dev</RelayUrl>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="RelayUrl" Value="$(RelayUrl)" />
  </ItemGroup>

  <!-- -p:Demo=true builds the demo: see Directory.Build.props (DEMO_MODE). Its in-memory stores aren't published otherwise. -->
  <ItemGroup Condition="'$(Demo)' != 'true'">
    <Content Remove="wwwroot\js\memorydb.js" />
    <None Include="wwwroot\js\memorydb.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Gateway" Version="11.0.0" PrivateAssets="all" />
    <PackageReference Include="MudBlazor" Version="9.14.0" />
  </ItemGroup>

  <!-- version.json beside the published app: the running app compares it with its own version to notice a newer
       deployment (Services/UpdateCheck.cs). Written after publishing, when the commit is already in the version. -->
  <Target Name="WriteVersionFile" AfterTargets="Publish">
    <WriteLinesToFile File="$(PublishDir)wwwroot/version.json" Lines="{&quot;version&quot;:&quot;$(InformationalVersion)&quot;}" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

</Project>
