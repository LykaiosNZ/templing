@page "/history"
@implements IDisposable
@inject DataStore Store
@inject IDialogService Dialogs

<PageTitle>History · Templing</PageTitle>

<div class="page-head">
    <div>
        <h1 class="page-title" tabindex="-1">History</h1>
        <MudText Typo="Typo.body2" Class="muted">@(_logs.Count == 1 ? "1 entry" : $"{_logs.Count} entries") · @Stats.Duration(_logs.Sum(l => l.DurationSec ?? 0)) logged</MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.AddTask" OnClick="Add">Log practice</MudButton>
</div>

<div class="toolbar">
    <MudTextField @bind-Value="_search" @bind-Value:after="Refresh" Placeholder="Search" Immediate="true" DebounceInterval="150" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Search" Class="search-box" aria-label="Search notes and pieces" />
    <MudSpacer />
    <div class="toolbar-end">
    <MudSelect T="string" @bind-Value="_piece" @bind-Value:after="Refresh" Label="Piece" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="toolbar-select">
        <MudSelectItem T="string" Value="@("")">All pieces</MudSelectItem>
        @foreach (var i in Store.PiecesByRecent(includeArchived: true)) { <MudSelectItem T="string" Value="@i.Id">@i.Name</MudSelectItem> }
    </MudSelect>
    <MudSelect T="int" @bind-Value="_range" @bind-Value:after="Refresh" Label="Period" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="toolbar-select">
        <MudSelectItem T="int" Value="7">Last 7 days</MudSelectItem>
        <MudSelectItem T="int" Value="30">Last 30 days</MudSelectItem>
        <MudSelectItem T="int" Value="90">Last 90 days</MudSelectItem>
        <MudSelectItem T="int" Value="0">All time</MudSelectItem>
    </MudSelect>
    </div>
</div>

@if (_logs.Count == 0)
{
    @if (Filtered)
    {
        <div class="empty-state">
            <MudText Typo="Typo.h6">No matching entries</MudText>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ClearFilters">Clear filters</MudButton>
        </div>
    }
    else
    {
        <div class="empty-state">
            <MudText Typo="Typo.h6">No entries yet</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.AddTask" OnClick="Add">Log practice</MudButton>
        </div>
    }
}
else
{
    @* on the page, not in a card, like the Library list; the key starts again on page 1 when the filters change *@
    <LogTable @key="_version" Logs="_logs" ShowPiece="true" PageSize="50" />
}

@code {
    string _piece = "";
    string? _search;
    bool Filtered => _piece != "" || _range > 0 || !string.IsNullOrWhiteSpace(_search);
    void ClearFilters() { _piece = ""; _range = 0; _search = null; Refresh(); }
    int _range;
    int _version;
    List<PracticeLog> _logs = new();

    protected override void OnInitialized() { Store.Changed += OnChanged; Refresh(); }
    void OnChanged() { Load(); InvokeAsync(StateHasChanged); }

    // the filters changed: back to page 1
    void Refresh() { Load(); _version++; }

    // after an entry was added, edited or deleted the log stays on its page
    void Load()
    {
        IEnumerable<PracticeLog> q = Store.Logs;
        if (_piece != "") q = q.Where(l => l.PieceId == _piece);
        if (_range > 0) q = q.Where(l => l.Date > DateTime.Today.AddDays(-_range));
        if (!string.IsNullOrWhiteSpace(_search)) q = q.Where(l => (l.Notes ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase) || l.PieceName.Contains(_search, StringComparison.OrdinalIgnoreCase));
        _logs = q.OrderByDescending(l => l.Date).ThenBy(l => l.PieceName).ToList();
    }

    async Task Add()
    {
        var piece = Store.GetPiece(_piece);
        await LogDialog.ShowAsync(Dialogs, new PracticeLog { PieceId = piece?.Id, PieceName = piece?.Name ?? "", Unit = piece?.Unit ?? TempoUnit.Bpm }, true);
    }

    public void Dispose() => Store.Changed -= OnChanged;
}
