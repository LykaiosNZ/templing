@page "/library"
@implements IAsyncDisposable
@inject DataStore Store
@inject IJSRuntime JS
@inject IDialogService Dialogs
@inject NavigationManager Nav

<PageTitle>Library · Templing</PageTitle>

<div class="page-head">
    <h1 class="page-title" tabindex="-1">Library</h1>
    <MudButtonGroup Color="Color.Primary" Variant="Variant.Filled" OverrideStyles="true" Class="split-button" aria-label="Add to library">
        <MudButton StartIcon="@Icons.Material.Rounded.Add" OnClick="Add">Add piece</MudButton>
        <MudTooltip Text="More ways to add">
            <MudMenu Icon="@Icons.Material.Rounded.ArrowDropDown" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" AriaLabel="More ways to add">
                <MudMenuItem Icon="@Icons.Material.Rounded.QueueMusic" OnClick="() => AfterMenu(ImportScore)">@(ScoreImportDialog.Title)…</MudMenuItem>
            </MudMenu>
        </MudTooltip>
    </MudButtonGroup>
</div>

<div class="toolbar">
    <MudTextField @bind-Value="_search" @bind-Value:after="Refresh" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Search"
                  Immediate="true" DebounceInterval="150" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="search-box" InputId="library-search" aria-label="Search library" />
    <MudChipSet T="string" @bind-SelectedValue="_type" @bind-SelectedValue:after="Refresh" SelectionMode="SelectionMode.SingleSelection" CheckMark="false" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" aria-label="Filter by type">
        <MudChip T="string" Value="@("all")" Default="true">All</MudChip>
        @foreach (var t in PieceTypeExt.Ordered)
        {
            <MudChip T="string" Value="@t.ToString()" Icon="@t.Icon()">@t.Label()</MudChip>
        }
    </MudChipSet>
    <MudSpacer />
    <div class="toolbar-end">
    @if (Store.Groups.Count > 0)
    {
        @* several groups at once; none picked shows every piece *@
        <MudSelect T="string" MultiSelection="true" SelectedValues="_groups" SelectedValuesChanged="GroupsChanged" MultiSelectionTextFunc="GroupsText" RelativeWidth="DropdownWidth.Adaptive" Clearable="true" OnClearButtonClick="ClearGroups"
                   Label="Group" Variant="Variant.Outlined" Margin="Margin.Dense" Class="toolbar-select" Dense="true">
            @foreach (var g in Store.Groups)
            {
                var group = g;
                @* the pencil edits the group without picking it (CSS hides it in the field once picked) *@
                <MudSelectItem T="string" Value="@g.Id">
                    <span class="group-option">
                        <GroupTag Group="group" />
                        <span class="group-option-edit" @onclick:stopPropagation="true">
                            <MudTooltip Text="Edit group">
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Rounded.Edit" aria-label="@($"Edit group {group.Name}")" OnClick="() => EditGroup(group)" />
                            </MudTooltip>
                        </span>
                    </span>
                </MudSelectItem>
            }
            <MudSelectItem T="string" Value="@NoGroup">No group</MudSelectItem>
        </MudSelect>
    }
    <MudToggleGroup T="bool" Value="Store.Settings.LibraryList" ValueChanged="SetListView" Color="Color.Primary" Size="Size.Small" Outlined="true" CheckMark="false"
                    Class="view-toggle" aria-label="View">
        <MudToggleItem Value="false"><MudTooltip Text="Cards"><MudIcon Icon="@Icons.Material.Rounded.GridView" Size="Size.Small" aria-label="Cards" /></MudTooltip></MudToggleItem>
        <MudToggleItem Value="true"><MudTooltip Text="List"><MudIcon Icon="@Icons.Material.Rounded.ViewList" Size="Size.Small" aria-label="List" /></MudTooltip></MudToggleItem>
    </MudToggleGroup>
    <MudSelect T="string" @bind-Value="_sort" @bind-Value:after="Refresh" Label="Sort" Variant="Variant.Outlined" Margin="Margin.Dense" Class="toolbar-select" Dense="true">
        <MudSelectItem T="string" Value="@("recent")">Recently practised</MudSelectItem>
        <MudSelectItem T="string" Value="@("name")">Name</MudSelectItem>
        <MudSelectItem T="string" Value="@("progress")">Progress</MudSelectItem>
        <MudSelectItem T="string" Value="@("time")">Total time</MudSelectItem>
    </MudSelect>
    <MudSwitch T="bool" @bind-Value="_showArchived" @bind-Value:after="Refresh" Label="Show archived" Color="Color.Primary" />
    </div>
</div>

@if (Store.Pieces.Count == 0)
{
    <div class="empty-state">
        <MudIcon Icon="@Icons.Material.Rounded.LibraryMusic" Style="font-size:3rem" />
        <MudText Typo="Typo.h6">Your library is empty</MudText>
        <MudText Class="muted">Add songs, exercises and riffs, import a Guitar Pro file, or restore a backup in <a href="settings">Settings &amp; data</a>.</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Add" Class="mt-2">Add your first piece</MudButton>
    </div>
}
else if (_rows.Count == 0)
{
    <div class="empty-state">
        <MudText Typo="Typo.h6">No matching pieces</MudText>
        <MudButton Variant="Variant.Outlined" OnClick="ClearFilters">Clear filters</MudButton>
    </div>
}
else
{
    @if (Store.Settings.LibraryList)
    {
        var withGroups = Store.Groups.Count > 0;
        <div class="piece-list @(withGroups ? "with-groups" : "")" role="list">
            <div class="piece-list-head" aria-hidden="true">
                <span class="pr-cols"><span></span><span>Piece</span>@if (withGroups)
                {<span class="pr-wide">Group</span>}<span>Tempo</span><span class="pr-wide">Progress</span><span class="pr-wide">Last practised</span><span class="pr-wide pr-time">Practice time</span></span>
                <span></span>
            </div>
            @if (_rows.Count > 0)
            {
                @* plain outlines until the first rows are drawn, a moment later (CSS hides them then); they cost nothing to draw *@
                <div class="row-placeholders" aria-hidden="true">
                    @for (var i = 0; i < Math.Min(_rows.Count, 15); i++)
                    {
                        <div class="row-placeholder"><span class="ph-line ph-icon"></span><span class="ph-line ph-name"></span><span class="ph-line ph-tempo"></span></div>
                    }
                </div>
            }
            @* only the rows near the screen are drawn: a big library has hundreds, each with a dozen components *@
            @* @key: Virtualize reuses elements as you scroll, so without it a bar animated from the last piece's progress *@
            <Virtualize Items="_rows" Context="row" ItemSize="41" OverscanCount="5">
                @{ var piece = row.Piece; var st = row.Stats; }
                <div class="piece-row @(piece.Archived ? "archived" : "")" role="listitem" @key="piece.Id">
                    <div class="pr-main">
                    <a class="piece-row-link pr-cols" href="library/@piece.Id" aria-label="@($"{piece.Name} details")">
                        <MudIcon Icon="@piece.Type.Icon()" Size="Size.Small" Class="fav-kind" title="@piece.Type.Label()" />
                        <span class="pr-name">@piece.Name</span>
                        @if (withGroups)
                        {
                            @* drawn by the overlay below: a menu can't sit inside the row's link *@
                            <span class="pr-group pr-wide"></span>
                        }
                        <span class="pr-tempo">
                            @* "150 / 180 bpm": the unit once, so it fits *@
                            <span class="mono">@(st.Sessions == 0 ? "—" : st.Last?.ToString("0") ?? "—")</span>@if (piece.Goal is { } g)
                            {<span class="muted"> / @g.ToString("0")</span>}<span class="muted">@piece.Unit.Suffix()</span>
                        </span>
                        <span class="pr-progress pr-wide">
                            @if (st.Sessions > 0 && st.Progress is { } pr)
                            {
                                <GoalBar Progress="pr" AriaLabel="@($"{piece.Name} progress: {pr:P0}")" />
                                @if (GoalChip.Reached(piece, st.Last))
                                {
                                    <GoalChip Piece="piece" Last="st.Last" />
                                }
                                else
                                {
                                    <span class="mono small">@pr.ToString("P0")</span>
                                }
                            }
                        </span>
                        <span class="muted small pr-wide">@(st.Sessions > 0 ? Stats.Ago(st.LastDate, DateTime.Today) : "Not started yet")</span>
                        <span class="muted small pr-wide pr-time" title="@(st.Sessions == 1 ? "1 session" : $"{st.Sessions} sessions")">@(st.Sessions > 0 ? Stats.Duration(st.TotalSec) : "")</span>
                    </a>
                    @if (withGroups)
                    {
                        @* the Group column's menu, laid over the link on the same columns (only that cell takes clicks) *@
                        <div class="pr-cols pr-overlay"><span></span><span></span><span class="pr-group pr-wide"><GroupPicker Piece="piece" /></span></div>
                    }
                    </div>
                    <span class="pr-actions">
                        @PracticeActions(piece)
                        @ManageActions(piece)
                    </span>
                </div>
            </Virtualize>
        </div>
    }
    else
    {
    @* drawn a row of cards at a time, and only the rows near the screen (each card is about 20 components) *@
    <div class="piece-grid" role="list" @ref="_grid" style="--cols:@_columns">
        @if (_rows.Count > 0)
        {
            @* plain card outlines until the first cards are drawn, a moment later (CSS hides them then); they cost nothing to draw *@
            <div class="piece-grid-row card-placeholders" aria-hidden="true">
                @for (var i = 0; i < Math.Min(_rows.Count, 12); i++)
                {
                    <div class="piece-card card-placeholder"><span class="ph-line ph-pill"></span><span class="ph-line ph-title"></span><span class="ph-line ph-big"></span><span class="ph-line ph-bar"></span></div>
                }
            </div>
        }
        @if (_columns > 0)
        {
        <Virtualize Items="_cardRows" Context="cardRow" ItemSize="232" OverscanCount="2">
        @* @key: Virtualize reuses elements as you scroll, so without it a bar animated from the last piece's progress *@
        <div @key="cardRow[0].Piece.Id">@CardRowContent(cardRow)</div>
        </Virtualize>
        }
    </div>
    }
}

@code {
    RenderFragment CardRowContent(Row[] cards) =>
        @<div class="piece-grid-row">
        @foreach (var row in cards)
        {
            var piece = row.Piece; var st = row.Stats;
            var cardGroup = Store.GetGroup(piece.GroupId);
            @* a piece in a group is tinted with its colour *@
            <article class="piece-card @(piece.Archived ? "archived" : "") @(cardGroup is null ? "" : "in-group")" role="listitem" @key="piece.Id"
                     style="@(cardGroup is null ? null : $"--group:{GroupColours.Hex(cardGroup.Colour)}")">
                <a class="piece-card-link" href="library/@piece.Id" aria-label="@($"{piece.Name} details")">
                    <div class="piece-card-top">
                        @* the type as just its icon, named by the tooltip, to keep the card light *@
                        <MudTooltip Text="@piece.Type.Label()"><span class="type-icon type-@piece.Type" role="img" aria-label="@piece.Type.Label()"><MudIcon Icon="@piece.Type.Icon()" Size="Size.Small" /></span></MudTooltip>
                        <span class="card-top-right">
                            @if (Store.LastRatedFor(piece) is { } rated && Effort.Get(rated.Effort) is { } feel)
                            {
                                var stale = rated.Date.Date < st.LastDate?.Date;
                                <span class="feel-pill @(stale ? "stale" : "")" style="--feel:@feel.Color"
                                      title="@($"{(stale ? "Last rated" : "Last session")} ({rated.Date:d MMM}): {feel.Label}. {feel.Advice}")">@feel.Label</span>
                            }
                            @if (st.Sessions > 0)
                            {
                                <span class="muted small">@Stats.Ago(st.LastDate, DateTime.Today)</span>
                            }
                        </span>
                    </div>
                    <h2 class="piece-name">@piece.Name</h2>
                    <div class="piece-tempo">
                        @if (st.Sessions == 0)
                        {
                            <span class="not-started">Not started yet</span>
                            @if (piece.Goal is { } g0)
                            {
                                <span class="muted"> · goal @g0.ToString("0")@piece.Unit.Suffix()</span>
                            }
                        }
                        else
                        {
                            <span class="big">@(st.Last?.ToString("0") ?? "—")</span><span class="muted">@(st.Last.HasValue ? piece.Unit.Suffix() : "")</span>
                            @if (piece.Goal is { } g)
                            {
                                <span class="muted"> / @g.ToString("0")@piece.Unit.Suffix()</span>
                            }
                            <GoalChip Piece="piece" Last="st.Last" />
                        }
                    </div>
                    <GoalBar Progress="st.Progress" Class="@(st.Sessions == 0 ? "d-none" : null)" AriaLabel="Progress to goal" />
                    @if (piece.HasParts() && Store.PartsFor(piece) is { Count: > 1 } parts)
                    {
                        <div class="part-bars" aria-label="Progress by section">
                            @foreach (var ps in parts)
                            {
                                var tip = $"{ps.Section.Name}: {(ps.Progress is { } pp ? pp.ToString("P0") : "not practised")}";
                                <GoalBar Progress="ps.Progress" Size="Size.Small" Class="section-bar" AriaLabel="@tip" Title="@tip" />
                            }
                        </div>
                    }
                    @if (st.Sessions > 0)
                    {
                        <div class="piece-meta">
                            <span>@(st.Progress is { } p ? $"{p:P0}" : "No goal")</span>
                            <span>@(st.Sessions == 1 ? "1 session" : $"{st.Sessions} sessions") · @Stats.Duration(st.TotalSec)</span>
                        </div>
                    }
                </a>
                <div class="piece-card-actions">
                    @PracticeActions(piece)
                    @if (Store.Groups.Count > 0)
                    {
                        <span class="card-group"><GroupPicker Piece="piece" /></span>
                    }
                    else
                    {
                        <MudSpacer />
                    }
                    @ManageActions(piece)
                </div>
            </article>
        }
        </div>;

    async Task SetListView(bool list) { Store.Settings.LibraryList = list; await Store.SaveSettingsAsync(); }

    // the same buttons on cards and list rows
    RenderFragment PracticeActions(Piece piece) =>
        @<text>
            <MudTooltip Text="Practise with metronome">
                <MudIconButton Size="Size.Small" Icon="@Mdi.Metronome" Color="Color.Primary" Href="@($"metronome/piece/{piece.Id}")" aria-label="@($"Practise {piece.Name} with the metronome")" />
            </MudTooltip>
            <MudTooltip Text="Practise with timer (no click)">
                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Rounded.HourglassBottom" Color="Color.Primary" Href="@($"timer/piece/{piece.Id}")" aria-label="@($"Practise {piece.Name} with the timer")" />
            </MudTooltip>
        </text>;

    RenderFragment ManageActions(Piece piece) =>
        @<text>
            <FavouriteToggle On="piece.Favourite" Name="@piece.Name" OnToggle="() => ToggleFavourite(piece)" />
            <MudTooltip Text="Log practice">
                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Rounded.AddTask" aria-label="@($"Log practice for {piece.Name}")" OnClick="() => Log(piece)" />
            </MudTooltip>
            <MudTooltip Text="Edit">
                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Rounded.Edit" aria-label="@($"Edit {piece.Name}")" OnClick="() => Edit(piece)" />
            </MudTooltip>
        </text>;

    async Task ToggleFavourite(Piece p) { p.Favourite = !p.Favourite; await Store.SavePieceAsync(p); }

    // MudMenu only closes once a menu item's handler finishes; start dialogs after it closes instead of awaiting them inside the click
    void AfterMenu(Func<Task> action) => _ = InvokeAsync(action);
    string? _search;
    string? _type = "all";
    string _sort = "recent";
    const string NoGroup = "none";
    // the groups picked in the filter (NoGroup for the pieces in none); empty = every piece
    IReadOnlyCollection<string> _groups = [];

    void GroupsChanged(IEnumerable<string> picked) { _groups = picked.ToList(); Refresh(); }
    // the field's × goes back to All groups
    void ClearGroups() { _groups = []; Refresh(); }

    string GroupsText(IReadOnlyList<string> picked) => picked.Count switch
    {
        0 => "All groups",
        1 => picked[0] == NoGroup ? "No group" : Store.GetGroup(picked[0])?.Name ?? "All groups",
        var n => $"{n} groups",
    };
    bool _showArchived;
    // the stats sort and filter needs; a card's feel rating and section bars come from Store as it's drawn
    record Row(Piece Piece, PieceStats Stats);
    List<Row> _rows = new();

    // card view: _rows in rows of as many cards as fit (js/columns.js reports the count)
    List<Row[]> _cardRows = new();
    int _columns;
    ElementReference _grid;
    ElementReference? _watched;
    IJSObjectReference? _columnsJs;
    DotNetObjectReference<Library>? _self;

    void ChunkRows() => _cardRows = _columns > 0 ? _rows.Chunk(_columns).ToList() : new();

    void ClearFilters() { _search = null; _type = "all"; _groups = []; Refresh(); }

    async Task EditGroup(PieceGroup g) => await GroupDialog.ShowAsync(Dialogs, g);

    [JSInvokable]
    public void OnColumns(int columns)
    {
        if (columns == _columns) return;
        _columns = columns;
        ChunkRows();
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // watch the grid's width while it's shown; the list view has no grid
        var grid = Store.Settings.LibraryList || Store.Pieces.Count == 0 || _rows.Count == 0 ? (ElementReference?)null : _grid;
        if (grid?.Id == _watched?.Id) return;
        _columnsJs ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/columns.js");
        if (_watched is { } old) await _columnsJs.InvokeVoidAsync("unwatch", old);
        _watched = grid;
        if (grid is { } g) await _columnsJs.InvokeVoidAsync("watch", g, _self ??= DotNetObjectReference.Create(this));
        else _columns = 0; // a grid shown again starts from its own measurement
    }

    protected override void OnInitialized()
    {
        Store.Changed += OnStoreChanged;
        Refresh();
    }

    void OnStoreChanged() { Refresh(); InvokeAsync(StateHasChanged); }

    void Refresh()
    {
        if (_groups.Any(id => id != NoGroup && Store.GetGroup(id) is null))   // a group was deleted
            _groups = _groups.Where(id => id == NoGroup || Store.GetGroup(id) is not null).ToList();
        var q = Store.Pieces.Where(i => _showArchived || !i.Archived);
        // the search finds a group's pieces by its name too
        if (!string.IsNullOrWhiteSpace(_search))
            q = q.Where(i => i.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || Store.GetGroup(i.GroupId)?.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) == true);
        if (_type is { } t && t != "all") q = q.Where(i => i.Type.ToString() == t);
        if (_groups.Count > 0)
        {
            var picked = _groups.ToHashSet();
            q = q.Where(i => Store.GetGroup(i.GroupId) is { } g ? picked.Contains(g.Id) : picked.Contains(NoGroup));
        }
        var rows = q.Select(i => new Row(i, Store.StatsFor(i)));
        _rows = (_sort switch
        {
            "name" => rows.OrderBy(r => r.Piece.Name),
            "progress" => rows.OrderByDescending(r => r.Stats.Progress ?? -1),
            "time" => rows.OrderByDescending(r => r.Stats.TotalSec),
            _ => rows.OrderByDescending(r => r.Stats.LastDate ?? DateTime.MinValue).ThenBy(r => r.Piece.Name)
        }).ToList();
        ChunkRows();
    }

    async Task Add()
    {
        var piece = await PieceDialog.ShowAsync(Dialogs);
        if (piece != null) Nav.NavigateTo($"library/{piece.Id}");
    }

    async Task Edit(Piece piece) => await PieceDialog.ShowAsync(Dialogs, piece);

    async Task ImportScore()
    {
        var r = await ScoreImportDialog.ShowAsync(Dialogs, forExisting: false);
        if (r == null) return;
        var piece = new Piece
        {
            Name = r.Name, Type = PieceType.Song, Unit = TempoUnit.Percent, Goal = 100,
            Sections = r.Sections, ScoreFileId = r.FileId, ScoreFileName = r.FileName, ScoreTrack = r.Track,
            Notes = string.IsNullOrWhiteSpace(r.Artist) ? null : r.Artist.Trim()
        };
        await Store.SavePieceAsync(piece);
        Nav.NavigateTo($"library/{piece.Id}");
    }

    async Task Log(Piece piece) =>
        await LogDialog.ShowAsync(Dialogs, new PracticeLog { PieceId = piece.Id, PieceName = piece.Name, Unit = piece.Unit }, true);

    public async ValueTask DisposeAsync()
    {
        Store.Changed -= OnStoreChanged;
        try { if (_columnsJs != null && _watched is { } g) await _columnsJs.InvokeVoidAsync("unwatch", g); }
        catch (JSDisconnectedException) { }
        _self?.Dispose();
    }
}
