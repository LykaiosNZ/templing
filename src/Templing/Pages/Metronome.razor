@page "/metronome"
@page "/metronome/free"
@page "/metronome/piece/{PieceId}"
@page "/metronome/piece/{PieceId}/{SectionId}"
@page "/metronome/preset/{PresetId}"
@implements IDisposable
@inject MetronomeService Metro
@inject DataStore Store
@inject NavigationManager Nav
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject PlanRunner Runner

<PageTitle>@(Metro.Source == MetronomeSource.Free ? "Free metronome" : $"{Metro.Title} · Metronome") · Templing</PageTitle>

<PracticeGuard Route="metronome" />
<PracticeKeys />

<div class="page-head">
    <div>
        @if (Metro.Source != MetronomeSource.Free)
        {
            <MudText Typo="Typo.overline" Class="muted">@SourceLabel</MudText>
        }
        <h1 class="page-title" tabindex="-1">@(Metro.Source == MetronomeSource.Free ? "Free metronome" : Metro.Title)</h1>
        @if (Metro.Piece is { } piece && Metro.Source == MetronomeSource.Piece)
        {
            var st = Stats.ForPiece(piece, Store.Logs);
            <MudText Typo="Typo.body2" Class="muted">
                Last @(st.Last?.ToString("0") ?? "—")@piece.Unit.Suffix() · Best @(st.Best?.ToString("0") ?? "—")@piece.Unit.Suffix()
                @if (piece.Goal is { } g) { <span> · Goal @g.ToString("0")@piece.Unit.Suffix()</span> }
                · <a href="library/@piece.Id">View progress</a>
            </MudText>
            <FeelHint Piece="piece" />
        }
    </div>
    <MudHidden Breakpoint="Breakpoint.LgAndUp">
        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Rounded.Tune" OnClick="() => _rail?.OpenSheet()">Options</MudButton>
    </MudHidden>
</div>

<div class="practice-col">
    <section class="stage @(Metro.IsRunning ? "running" : "") phase-@Metro.State.phase" aria-label="Metronome controls">
        @if (Metro.Sections.Count > 1)
        {
            <div class="section-picker">
                <MudTooltip Text="Previous section">
                    <MudIconButton Icon="@Icons.Material.Rounded.SkipPrevious" aria-label="Previous section" OnClick="() => Metro.PrevStepAsync()" />
                </MudTooltip>
                <MudSelect T="int" Value="CurStep" ValueChanged="i => Metro.SetStepAsync(i)" ToStringFunc="SectionLabel" Label="Section"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="section-select" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
                    @for (int i = 0; i < Metro.Sections.Count; i++)
                    {
                        var idx = i;
                        var sec = Metro.Sections[i];
                        <MudSelectItem T="int" Value="idx">
                            <div class="sec-opt">
                                <span class="sec-opt-name">@(idx + 1). @sec.Name</span>
                                <span class="sec-opt-meta">@sec.Bpm.ToString("0") bpm · @sec.Meter@(sec.Length > 0 ? $" · {sec.Length} bars" : "")</span>
                            </div>
                        </MudSelectItem>
                    }
                </MudSelect>
                <MudTooltip Text="Next section">
                    <MudIconButton Icon="@Icons.Material.Rounded.SkipNext" aria-label="Next section" OnClick="() => Metro.NextStepAsync()" />
                </MudTooltip>
                <MudTooltip Text="@PlaybackLabel">
                    <MudIconButton Icon="@PlaybackIcon" Size="Size.Small" Class="@(Metro.PlayThrough ? "opt-toggle on" : "opt-toggle")"
                                   aria-label="@($"Section playback: {PlaybackLabel}")" OnClick="CyclePlayback" />
                </MudTooltip>
            </div>
        }

        <div class="tempo-row">
            <MudTooltip Text="Slower">
                <MudIconButton Icon="@Icons.Material.Rounded.Remove" Variant="Variant.Outlined" Size="Size.Large" aria-label="Slower" OnClick="() => Metro.NudgeAsync(-1)" />
            </MudTooltip>
            <div class="tempo-display" aria-live="polite">
                <div id="metro-pulse" class="pulse" aria-hidden="true"></div>
                <div class="tempo-value">@Metro.Value.ToString("0")<span class="tempo-unit">@(Metro.Unit == TempoUnit.Percent ? "%" : "")</span></div>
                <div class="tempo-sub">
                    @if (Metro.Unit == TempoUnit.Percent)
                    {
                        <span>@Metro.PlayingBpm.ToString("0") bpm</span>
                    }
                    else
                    {
                        <span>bpm</span>
                    }
                    <span> · @Meter</span>
                    <span> · <DivisionIcon Subdivision="Metro.PlayingSection.Subdivision" BeatUnit="Metro.PlayingSection.BeatUnit" /></span>
                    @if (Metro.Source != MetronomeSource.Piece && Metro.Sections.Count > 1 && Math.Abs(Metro.Factor - 1) > 0.001 && !Metro.IsRunning)
                    {
                        <MudLink Class="ml-2" OnClick="() => Metro.ResetFactorAsync()" Typo="Typo.body2">reset ×@Metro.Factor.ToString("0.00")</MudLink>
                    }
                </div>
            </div>
            <MudTooltip Text="Faster">
                <MudIconButton Icon="@Icons.Material.Rounded.Add" Variant="Variant.Outlined" Size="Size.Large" aria-label="Faster" OnClick="() => Metro.NudgeAsync(1)" />
            </MudTooltip>
        </div>

        <div class="tempo-slider">
            <MudSlider T="double" Value="Metro.Value" ValueChanged="v => Metro.SetValueAsync(v)" Min="Metro.Min" Max="@(Metro.Unit == TempoUnit.Percent ? 150 : 300)" Step="1"
                       Color="Color.Primary" aria-label="Tempo" />
        </div>

        <div id="metro-beats" class="beats" aria-hidden="true">
            @for (int b = 0; b < (Metro.IsRunning ? Metro.State.beats : Metro.PlayingSection.BeatsPerBar); b++)
            {
                <span class="beat-dot @(b == 0 && Metro.Settings.AccentFirst ? "accent" : "")"></span>
            }
        </div>

        <div class="status-line" role="status" aria-live="polite">
            @if (Metro.IsRunning)
            {
                @switch (Metro.State.phase)
                {
                    case "countin":
                        <span class="phase countin">Count-in @Metro.State.count</span>
                        break;
                    case "rest":
                        <span class="phase rest">Rest · @Stats.Clock(Metro.State.remaining ?? 0)</span>
                        break;
                    default:
                        <span class="phase work">Playing</span>
                        <span class="muted">Bar @(Metro.State.barInPart + 1)@(Metro.PlayingSection.Length > 0 ? $"/{Metro.PlayingSection.Length}" : "")</span>
                        @if (Metro.State.remaining is { } rem)
                        {
                            <span class="muted">· @Stats.Clock(rem) left</span>
                        }
                        break;
                }
                @if (Metro.EffectiveIntervals.Enabled)
                {
                    <span class="muted">· Round @Metro.State.round@(Metro.EffectiveIntervals.Rounds > 0 ? $"/{Metro.EffectiveIntervals.Rounds}" : "")</span>
                }
            }
        </div>

        @if (Metro.Training.Enabled)
        {
            var tr = Metro.Training;
            var prog = Metro.IsRunning ? (Metro.State.trainingProgress ?? 0) : 0;
            <div class="training-bar">
                <span>@tr.Start.ToString("0")</span>
                <MudProgressLinear Value="@(prog * 100)" Color="Color.Primary" Rounded="true" Size="Size.Medium" aria-label="Speed trainer progress" />
                <span>@tr.End.ToString("0")@(Metro.Unit == TempoUnit.Percent ? "%" : "")</span>
            </div>
            @if (TrainingNextText is { } next)
            {
                <div class="training-next">@next</div>
            }
        }

        <div class="transport">
            @* restarting does nothing during a rest, so skipping it takes the slot *@
            @if (Metro.Resting)
            {
                <MudTooltip Text="Skip rest">
                    <MudIconButton Icon="@Icons.Material.Rounded.SkipNext" aria-label="Skip rest" OnClick="() => Metro.SkipRestAsync()" />
                </MudTooltip>
            }
            else
            {
                <MudTooltip Text="Restart section">
                    <MudIconButton Icon="@Icons.Material.Rounded.Replay" aria-label="Restart section" OnClick="() => Metro.RestartSectionAsync()" />
                </MudTooltip>
            }
            <button class="play-btn @(Metro.IsRunning ? "on" : "")" @onclick="() => Metro.ToggleAsync()" aria-label="@(Metro.IsRunning ? "Stop" : "Start")">
                <MudIcon Icon="@(Metro.IsRunning ? Icons.Material.Rounded.Stop : Icons.Material.Rounded.PlayArrow)" Style="font-size:2.6rem" />
            </button>
            <MudTooltip Text="Tap tempo">
                <MudButton Variant="Variant.Outlined" OnClick="() => Metro.TapAsync()" aria-label="Tap tempo" Class="tap-btn">Tap</MudButton>
            </MudTooltip>
        </div>

        <SessionPanel Ended="SessionEnded" Detail="@SessionDetail" />

    </section>

    @if (Metro.Source == MetronomeSource.Piece && Metro.Piece is { ScoreFileId: not null } scorePiece)
    {
        <div>
            <TabView Piece="scorePiece" Part="Metro.PlayingSection" Dark="Store.Settings.DarkMode" />
        </div>
    }
</div>

<OptionsRail @ref="_rail">
    <Strip>
        <RailToggle Title="Speed trainer" Icon="@Icons.Material.Rounded.TrendingUp" On="Metro.Training.Enabled" OnToggle="() => SetTraining(!Metro.Training.Enabled)" Disabled="Metro.TrainingPinned" />
        <RailToggle Title="Intervals" Icon="@Icons.Material.Rounded.Timelapse" On="Metro.EffectiveIntervals.Enabled" OnToggle="() => SetIntervals(!Metro.Settings.Interval.Enabled)" Disabled="Metro.StepPinned" />
        <RailToggle Title="Count-in" Icon="@Icons.Material.Rounded.HourglassTop" On="Metro.Settings.CountIn" OnToggle="() => SetCountIn(!Metro.Settings.CountIn)" />
        <MudDivider Class="rail-strip-divider" />
        <RailVolume />
    </Strip>
    <ChildContent>
        <div class="rail-src">
            <MudSelect T="string" Value="@SourceKey" ValueChanged="LoadSource" Label="Metronome" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                <MudSelectItem T="string" Value="@("free")">Free metronome</MudSelectItem>
                @if (Store.Presets.Count > 0)
                {
                    <MudSelectItem T="string" Value="@("group:custom")" Disabled="true" Class="select-group">Custom metronomes</MudSelectItem>
                    @foreach (var p in Store.Presets.OrderBy(p => p.Name))
                    {
                        <MudSelectItem T="string" Value="@($"preset:{p.Id}")">@p.Name</MudSelectItem>
                    }
                }
                <MudSelectItem T="string" Value="@("group:library")" Disabled="true" Class="select-group">Library</MudSelectItem>
                @foreach (var i in Store.PiecesByRecent())
                {
                    <MudSelectItem T="string" Value="@($"piece:{i.Id}")">@i.Name</MudSelectItem>
                }
            </MudSelect>
            @if (Metro.Source == MetronomeSource.Preset)
            {
                <MudTooltip Text="More" Placement="Placement.Left">
                    <MudMenu Icon="@Icons.Material.Rounded.MoreVert" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" AriaLabel="@($"More for {Metro.Title}")">
                        <MudMenuItem Icon="@Icons.Material.Rounded.Save" OnClick="() => AfterMenu(SavePreset)">Save changes</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Rounded.ViewAgenda" OnClick="() => AfterMenu(EditPresetSections)">Edit sections…</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Rounded.Edit" OnClick="() => AfterMenu(RenamePreset)">Rename…</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Rounded.Delete" IconColor="Color.Error" OnClick="() => AfterMenu(DeletePreset)">Delete…</MudMenuItem>
                    </MudMenu>
                </MudTooltip>
            }
            else if (Metro.Source == MetronomeSource.Free)
            {
                <MudTooltip Text="Save as custom metronome" Placement="Placement.Left">
                    <MudIconButton Icon="@Icons.Material.Rounded.Save" Variant="Variant.Outlined" aria-label="Save as custom metronome" OnClick="SavePreset" />
                </MudTooltip>
            }
        </div>

        @if (Metro.Source == MetronomeSource.Free)
        {
            var fs = Metro.Sections[0];
            <RailSection Title="Time signature" Icon="@Icons.Material.Rounded.MusicNote">
                <div class="form-grid">
                    <MeterInput Section="fs" OnChanged="Apply" />
                    <MudSelect T="int" @bind-Value="fs.Subdivision" @bind-Value:after="Apply" Label="Division" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        @foreach (var (v, _) in Section.Divisions(fs.BeatUnit, fs.Subdivision)) { <MudSelectItem T="int" Value="v"><DivisionIcon Subdivision="v" BeatUnit="fs.BeatUnit" ShowLabel="true" Tooltip="false" /></MudSelectItem> }
                    </MudSelect>
                </div>
            </RailSection>
        }

        <RailSection Title="Speed trainer" Icon="@Icons.Material.Rounded.TrendingUp" On="Metro.Training.Enabled" OnChanged="SetTraining" Disabled="Metro.TrainingPinned">
            @{ var tr = Metro.Training; var u = Metro.Unit == TempoUnit.Percent ? "%" : "bpm"; }
            @if (Metro.TrainingPinned)
            {
                <MudAlert Severity="Severity.Info" Dense="true">Set by your plan for this step.</MudAlert>
            }
            <div class="form-grid">
                <MudNumericField Disabled="Metro.TrainingPinned" T="double" @bind-Value="tr.Start" @bind-Value:after="Apply" Label="@($"Start ({u})")" Min="Metro.Min" Max="Metro.Max" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudNumericField Disabled="Metro.TrainingPinned" T="double" @bind-Value="tr.End" @bind-Value:after="Apply" Label="@($"End ({u})")" Min="Metro.Min" Max="Metro.Max" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </div>
            <MudToggleGroup Disabled="Metro.TrainingPinned" T="RampMode" @bind-Value="tr.Mode" @bind-Value:after="Apply" Color="Color.Primary" Size="Size.Small" Outlined="true" CheckMark="false" Class="rail-seg">
                <MudToggleItem Value="RampMode.OverTime" Text="Over time" />
                <MudToggleItem Value="RampMode.EveryNBars" Text="Every N bars" />
            </MudToggleGroup>
            <div class="form-grid">
                <MudNumericField Disabled="Metro.TrainingPinned" T="int" Value="tr.StepCount" ValueChanged="async v => { tr.Steps = v; await Apply(); }" Label="Increments" Min="1" Max="tr.MaxSteps"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" />
                @if (tr.Mode == RampMode.OverTime)
                {
                    <DurationInput Disabled="Metro.TrainingPinned" Seconds="tr.DurationMin * 60" SecondsChanged="async v => { tr.DurationMin = (v ?? 300) / 60; await Apply(); }" Label="Over"
                                   MinSeconds="15" MaxSeconds="7200" Variant="Variant.Outlined" Margin="Margin.Dense" />
                }
                else
                {
                    <MudNumericField Disabled="Metro.TrainingPinned" T="int" @bind-Value="tr.EveryBars" @bind-Value:after="Apply" Label="Every (bars)" Min="1" Max="64" Variant="Variant.Outlined" Margin="Margin.Dense" />
                }
            </div>
            <MudSwitch Disabled="Metro.TrainingPinned" T="bool" @bind-Value="tr.StopAtEnd" @bind-Value:after="Apply" Color="Color.Primary" Label="Stop at end" Class="rail-line-switch" />
        </RailSection>

        <RailSection Title="Intervals" Icon="@Icons.Material.Rounded.Timelapse" On="Metro.EffectiveIntervals.Enabled" OnChanged="SetIntervals" Disabled="Metro.StepPinned">
            <IntervalsEditor Settings="Metro.Settings.Interval" />
        </RailSection>

        <RailSection Title="Count-in" Icon="@Icons.Material.Rounded.HourglassTop" On="Metro.Settings.CountIn" OnChanged="SetCountIn">
            <MudNumericField T="int" @bind-Value="Metro.Settings.CountInBars" @bind-Value:after="Apply" Label="Bars" Min="1" Max="16" Variant="Variant.Outlined" Margin="Margin.Dense" Class="rail-num" />
        </RailSection>


        <RailSection Title="Sound" Icon="@Icons.Material.Rounded.VolumeUp">
            @{ var s = Metro.Settings; }
            <ClickSoundPicker Value="@Metro.SourceSound" ValueChanged="Metro.SetSoundAsync" DefaultOption="true" Label="Click sound" />
            <VolumeControl />
            <MudSwitch T="bool" @bind-Value="s.AccentFirst" @bind-Value:after="Apply" Color="Color.Primary" Label="Accent the first beat" Class="rail-line-switch" />
            <MudSwitch T="bool" @bind-Value="s.Flash" @bind-Value:after="Apply" Color="Color.Primary" Label="Flash on each beat" Class="rail-line-switch" />
        </RailSection>
    </ChildContent>
</OptionsRail>


@code {
    [Parameter] public string? PieceId { get; set; }
    [Parameter] public string? SectionId { get; set; }
    [Parameter] public string? PresetId { get; set; }
    OptionsRail? _rail;

    int CurStep => Metro.PlayingStep;
    string SectionLabel(int i) => i >= 0 && i < Metro.Sections.Count ? $"{i + 1}. {Metro.Sections[i].Name}" : "";

    double Factor => Metro.IsRunning ? Metro.State.factor : Metro.Factor;

    string SourceLabel => Metro.Source switch
    {
        MetronomeSource.Piece => Metro.Piece?.Type.Label() ?? "",
        MetronomeSource.Preset => "Custom",
        _ => "Free"
    };

    bool SessionEnded => !Runner.Active && !Metro.IsRunning && Metro.SessionActiveSec >= 1;
    string? SessionDetail => Metro.SessionMax is null ? null : SessionRange + (Metro.Unit == TempoUnit.Percent ? "" : " bpm");

    string SessionRange
    {
        get
        {
            if (Metro.SessionMax is null) return "—";
            var suf = Metro.Unit == TempoUnit.Percent ? "%" : "";
            var lo = Math.Round(Metro.SessionMin ?? 0); var hi = Math.Round(Metro.SessionMax.Value);
            return lo < hi ? $"{lo:0}–{hi:0}{suf}" : $"{hi:0}{suf}";
        }
    }

    string? TrainingNextText
    {
        get
        {
            var n = Metro.IsRunning ? Metro.State.trainingNext : null;
            if (n is null) return null;
            var tr = Metro.Training; var u = Metro.Unit == TempoUnit.Percent ? "%" : "";
            var dir = tr.End >= tr.Start ? "+" : "−";
            // steps are whole numbers but not all the same size (+5, +6, +5…), and over time a bar line can take
            // several at once when they're shorter than a bar: the engine says which level comes next
            var cur = Math.Round(Metro.Value);
            var up = tr.End >= tr.Start;
            var levels = tr.Levels();
            var nextLevel = n.level is int li && li >= 0 && li < levels.Count ? levels[li]
                          : levels.FirstOrDefault(l => up ? l > cur : l < cur, cur);
            var step = $"{dir}{Math.Abs(nextLevel - cur):0}{u}";
            string when = n.bars is int b && b > 1 ? $"{b} bars"
                        : n.beats is int bt ? $"{bt} beat{(bt == 1 ? "" : "s")}"
                        : Stats.Clock(Math.Ceiling(n.sec ?? 0));
            return $"Next {step} in {when}";
        }
    }

    /// <summary>The meter under the tempo: the bar that's playing (score bars can change meter mid-section), else the section's.</summary>
    string Meter => Metro.IsRunning && Metro.State.beats > 0 ? $"{Metro.State.beats}/{Metro.State.unit}" : Metro.PlayingSection.Meter;


    protected override async Task OnParametersSetAsync()
    {
        if (PieceId != null)
        {
            var piece = Store.GetPiece(PieceId);
            if (piece == null) { Nav.NavigateTo("metronome"); return; }
            await Metro.LoadPieceAsync(piece, SectionId);
        }
        else if (PresetId != null)
        {
            var p = Store.Presets.FirstOrDefault(x => x.Id == PresetId);
            if (p == null) { Nav.NavigateTo("metronome"); return; }
            if (Metro.Preset?.Id != p.Id || Metro.Source != MetronomeSource.Preset) await Metro.LoadPresetAsync(p);
        }
        else if (Nav.Uri.EndsWith("/metronome/free")) await Metro.LoadFreeAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        Metro.Changed += OnChanged;
        // coming back from the practice timer: turn the click back on
        if (!Metro.IsRunning && Metro.Silent) await Metro.SetSilentAsync(false);
    }
    void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Metro.Changed -= OnChanged;

    Task Apply() => Metro.ApplyAsync();

    async Task Toggle(Action a) { a(); await Metro.ApplyAsync(); }
    Task SetTraining(bool on) => Metro.SetTrainingEnabledAsync(on);
    Task SetIntervals(bool on) => Toggle(() => Metro.Settings.Interval.Enabled = on);
    Task SetCountIn(bool on) => Toggle(() => Metro.Settings.CountIn = on);

    // section playback cycles like a music player's repeat button: loop this section → play through → play through and repeat
    string PlaybackLabel => !Metro.PlayThrough ? "Loop section" : Metro.Loop ? "Play through and repeat" : "Play through";
    string PlaybackIcon => !Metro.PlayThrough ? Icons.Material.Rounded.RepeatOne : Metro.Loop ? Icons.Material.Rounded.Repeat : Icons.Material.Rounded.PlaylistPlay;
    Task CyclePlayback() => !Metro.PlayThrough ? Metro.SetPlaybackAsync(true, false)
        : !Metro.Loop ? Metro.SetPlaybackAsync(true, true)
        : Metro.SetPlaybackAsync(false, Metro.Loop);


    async Task SavePreset()
    {
        if (Metro.Source == MetronomeSource.Preset && Metro.Preset is { } p)
        {
            p.Sections = Metro.Sections.Select(s => s.Clone()).ToList();
            p.PlayThrough = Metro.PlayThrough; p.Loop = Metro.Loop;
            await Store.SavePresetAsync(p);
            Snackbar.Add($"Saved “{p.Name}”", Severity.Success);
            return;
        }
        var name = await PromptDialog.ShowAsync(Dialogs, "Save as custom metronome", "Name",
            placeholder: SuggestedName(), taken: Store.Presets.Select(x => x.Name));
        if (name == null) return;
        var preset = Metro.ToPreset(name);
        await Store.SavePresetAsync(preset);
        Snackbar.Add($"Saved “{name}”", Severity.Success);
        Nav.NavigateTo($"metronome/preset/{preset.Id}");
    }

    async Task RenamePreset()
    {
        if (Metro.Preset is not { } p) return;
        var name = await PromptDialog.ShowAsync(Dialogs, "Rename custom metronome", "Name", p.Name, "Rename",
            taken: Store.Presets.Where(x => x.Id != p.Id).Select(x => x.Name));
        if (name == null || name == p.Name) return;
        p.Name = name;
        await Store.SavePresetAsync(p);
        Metro.NotifyTitleChanged();
        StateHasChanged();
        Snackbar.Add($"Renamed to “{name}”", Severity.Success);
    }

    /// <summary>What's set up now, as a name: "128 bpm · 4/4", or "3 sections · 128 bpm".</summary>
    string SuggestedName()
    {
        var first = Metro.Sections.FirstOrDefault();
        if (first is null) return "My metronome";
        return Metro.Sections.Count == 1 ? $"{first.Bpm:0} bpm · {first.Meter}" : $"{Metro.Sections.Count} sections · {first.Bpm:0} bpm";
    }

    /// <summary>The select's value for what's loaded.</summary>
    string SourceKey => Metro.Source switch
    {
        MetronomeSource.Preset => $"preset:{Metro.Preset?.Id}",
        MetronomeSource.Piece => $"piece:{Metro.Piece?.Id}",
        _ => "free",
    };

    void LoadSource(string key)
    {
        if (key == SourceKey || key.StartsWith("group:")) return;
        var (kind, id) = key.IndexOf(':') is var c and > 0 ? (key[..c], key[(c + 1)..]) : (key, "");
        Nav.NavigateTo(kind switch { "preset" => $"metronome/preset/{id}", "piece" => $"metronome/piece/{id}", _ => "metronome/free" });
    }

    void AfterMenu(Func<Task> action) => _ = InvokeAsync(action);

    async Task DeletePreset()
    {
        if (Metro.Preset is not { } p) return;
        if (!await ConfirmDialog.DeleteAsync(Dialogs, "custom metronome", p.Name)) return;
        await Store.DeletePresetAsync(p);
        Snackbar.Add($"Deleted “{p.Name}”", Severity.Info);
        Nav.NavigateTo("metronome/free");
    }

    async Task EditPresetSections()
    {
        var r = await SectionsDialog.ShowAsync(Dialogs, Metro.Sections, Metro.PlayThrough, Metro.Loop);
        if (r == null) return;
        await Metro.ReplaceSectionsAsync(r.Sections, r.PlayThrough, r.Loop);
    }
}
