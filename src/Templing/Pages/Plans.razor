@page "/plans"
@implements IDisposable
@inject DataStore Store
@inject PlanRunner Runner
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Plans · Templing</PageTitle>

<div class="page-head">
    <h1 class="page-title" tabindex="-1">Plans</h1>
    <div class="page-head-actions">
        @if (Store.Plans.Count > 0)
        {
            <MudToggleGroup T="bool" Value="Store.Settings.PlansList" ValueChanged="SetListView" Color="Color.Primary" Size="Size.Small" Outlined="true" CheckMark="false"
                            Class="view-toggle" aria-label="View">
                <MudToggleItem Value="false"><MudTooltip Text="Cards"><MudIcon Icon="@Icons.Material.Rounded.GridView" Size="Size.Small" aria-label="Cards" /></MudTooltip></MudToggleItem>
                <MudToggleItem Value="true"><MudTooltip Text="List"><MudIcon Icon="@Icons.Material.Rounded.ViewList" Size="Size.Small" aria-label="List" /></MudTooltip></MudToggleItem>
            </MudToggleGroup>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="New">New plan</MudButton>
    </div>
</div>

@if (Store.Plans.Count == 0)
{
    <div class="empty-state">
        <MudIcon Icon="@Icons.Material.Rounded.ChecklistRtl" Style="font-size:3rem" />
        <MudText Typo="Typo.h6">No plans yet</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="New" Class="mt-2">Create a plan</MudButton>
    </div>
}
else if (Store.Settings.PlansList)
{
    @* One row per plan, like the Library list: the row opens the plan's editor, actions at the end *@
    <div class="plan-table" role="list">
        <div class="plan-table-head" aria-hidden="true">
            <span class="plt-cols"><span>Plan</span><span class="plt-strip-head"></span><span class="plt-wide plt-num">Steps</span><span class="plt-num">Length</span><span class="plt-wide">Last run</span></span>
            <span></span>
        </div>
        @foreach (var plan in Ordered)
        {
            var running = IsRunning(plan);
            var shown = running ? Runner.Plan! : plan;
            var p = plan;
            <div class="plan-trow @(running ? "running" : "")" role="listitem">
                <button type="button" class="plt-open plt-cols" aria-label="@($"Edit {shown.Name}")" @onclick="() => Edit(p, running)">
                    <span class="plt-name">@shown.Name</span>
                    <PlanStrip Plan="shown" Current="@(running ? Runner.Index : null)" Class="slim" />
                    <span class="plt-wide plt-num mono">@shown.Steps.Count</span>
                    <span class="plt-num mono">@Stats.DurationMin(shown.TotalMinutes)</span>
                    <span class="plt-wide small @(running ? "plt-on" : "muted")">@LastRun(shown, running)</span>
                </button>
                <span class="plt-actions">
                    <FavouriteToggle On="plan.Favourite" Name="@plan.Name" OnToggle="() => ToggleFavourite(p)" />
                    @More(p)
                    @if (running)
                    {
                        <MudTooltip Text="End plan">
                            <MudIconButton Size="Size.Small" Color="Color.Primary" Icon="@Icons.Material.Rounded.Stop" aria-label="@($"End {plan.Name}")" OnClick="() => Runner.EndAsync()" />
                        </MudTooltip>
                    }
                    else
                    {
                        <MudTooltip Text="Run plan">
                            <MudIconButton Size="Size.Small" Color="Color.Primary" Icon="@Icons.Material.Rounded.PlayArrow" aria-label="@($"Run {plan.Name}")" OnClick="() => Run(p)" />
                        </MudTooltip>
                    }
                </span>
            </div>
        }
    </div>
}
else
{
    @* A card per plan: name, totals and the steps as a strip; the card opens the plan's editor, Steps opens the list of steps.
       The running plan is outlined and its steps are open. *@
    <div class="plan-grid" role="list">
        @foreach (var plan in Ordered)
        {
            var running = IsRunning(plan);
            var open = IsOpen(plan, running);
            var bodyId = $"plan-steps-{plan.Id}";
            var p = plan;
            // the run's own steps, which may have been changed for this session only
            var shown = running ? Runner.Plan! : plan;
            <article class="plan-card @(running ? "running" : "")" role="listitem">
                <button type="button" class="plan-card-open" aria-label="@($"Edit {shown.Name}")" @onclick="() => Edit(p, running)">
                    <span class="plan-card-name">@shown.Name</span>
                    <span class="plan-card-meta">@Meta(shown, running)</span>
                    <PlanStrip Plan="shown" Current="@(running ? Runner.Index : null)" />
                </button>
                <span class="plan-card-star"><FavouriteToggle On="plan.Favourite" Name="@plan.Name" OnToggle="() => ToggleFavourite(p)" /></span>
                @if (open)
                {
                    <ol class="plan-list" id="@bodyId">
                        @for (int i = 0; i < shown.Steps.Count; i++)
                        {
                            var s = shown.Steps[i];
                            var idx = i;
                            var missing = PlanStepSummary.IsMissing(s, Store);
                            <li class="@(s.Kind == PlanStepKind.Rest ? "rest" : "") @(missing ? "missing" : "") @(running && Runner.Index == idx ? "on" : "")">
                                <PlanStepSummary Step="s" Index="idx" />
                                @if (!running)
                                {
                                    <MudTooltip Text="Start from this step" RootClass="pl-start">
                                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Rounded.PlayArrow" aria-label="@($"Run {plan.Name} from step {idx + 1}")" OnClick="() => Run(p, idx)" />
                                    </MudTooltip>
                                }
                            </li>
                        }
                    </ol>
                }
                <div class="plan-card-actions">
                    <button type="button" class="plan-card-toggle @(open ? "open" : "")" aria-expanded="@(open ? "true" : "false")" aria-controls="@bodyId" @onclick="() => Toggle(p, running)">
                        <MudIcon Icon="@Icons.Material.Rounded.ExpandMore" Size="Size.Small" Class="er-chevron" />
                        Steps
                    </button>
                    @More(p)
                    @if (running)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Rounded.Stop" OnClick="() => Runner.EndAsync()" Class="plr-run" aria-label="@($"End {plan.Name}")">End plan</MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Rounded.PlayArrow" OnClick="() => Run(p)" Class="plr-run" aria-label="@($"Run {plan.Name}")">Run plan</MudButton>
                    }
                </div>
            </article>
        }
    </div>
}

@code {
    IEnumerable<PracticePlan> Ordered => Store.Plans.OrderByDescending(p => p.LastRun ?? p.Created);
    bool IsRunning(PracticePlan p) => Runner.Active && Runner.Plan?.Id == p.Id;

    RenderFragment More(PracticePlan p) =>
        @<MudTooltip Text="More">
            <MudMenu Icon="@Icons.Material.Rounded.MoreVert" Size="Size.Small" Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" AriaLabel="@($"More for {p.Name}")">
                <MudMenuItem Icon="@Icons.Material.Rounded.ContentCopy" OnClick="() => Duplicate(p)">Duplicate</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Rounded.Delete" OnClick="() => AfterMenu(() => Delete(p))">Delete…</MudMenuItem>
            </MudMenu>
        </MudTooltip>;

    async Task SetListView(bool list) { Store.Settings.PlansList = list; await Store.SaveSettingsAsync(); }

    // Cards the user opened or closed this visit; anything not listed follows the default (only the running plan is open)
    readonly Dictionary<string, bool> _open = new();
    bool IsOpen(PracticePlan p, bool running) => _open.TryGetValue(p.Id, out var o) ? o : running;
    void Toggle(PracticePlan p, bool running) => _open[p.Id] = !IsOpen(p, running);

    async Task ToggleFavourite(PracticePlan p) { p.Favourite = !p.Favourite; await Store.SavePlanAsync(p); }

    // MudMenu only closes once a menu item's handler finishes; start dialogs after it closes instead of awaiting them inside the click
    void AfterMenu(Func<Task> action) => _ = InvokeAsync(action);
    protected override void OnInitialized() { Store.Changed += OnChanged; Runner.Changed += OnChanged; }
    void OnChanged() => InvokeAsync(StateHasChanged);

    string Meta(PracticePlan p, bool running)
    {
        var n = p.Steps.Count;
        var parts = new List<string> { $"{n} step{(n == 1 ? "" : "s")}", Stats.DurationMin(p.TotalMinutes) };
        if (running) parts.Add($"Step {Runner.Index + 1} of {n}{(Runner.EditedForSession ? " · changed for this session" : "")}");
        else parts.Add(p.LastRun is null ? "Not run yet" : $"Last run {Stats.Ago(p.LastRun, DateTime.Today)}");
        return string.Join(" · ", parts);
    }

    // the list's Last run column: the running plan shows where it is instead
    string LastRun(PracticePlan p, bool running) => running ? $"Step {Runner.Index + 1} of {p.Steps.Count}"
        : p.LastRun is null ? "Not run yet" : Stats.Ago(p.LastRun, DateTime.Today);

    async Task Duplicate(PracticePlan p)
    {
        var copy = System.Text.Json.JsonSerializer.Deserialize<PracticePlan>(System.Text.Json.JsonSerializer.Serialize(p, DataStore.Json), DataStore.Json)!;
        copy.Id = Guid.NewGuid().ToString("N");
        copy.Name = $"{p.Name} (copy)";
        copy.Created = DateTime.Now;
        copy.LastRun = null;
        await Store.SavePlanAsync(copy);
    }


    async Task New() => await PlanDialog.ShowAsync(Dialogs);
    // the running plan is edited through the plan bar, which can apply it to this session only
    async Task Edit(PracticePlan p, bool running)
    {
        if (running) await Runner.RequestEditAsync();
        else await PlanDialog.ShowAsync(Dialogs, p);
    }

    async Task Delete(PracticePlan p)
    {
        if (!await ConfirmDialog.DeleteAsync(Dialogs, "plan", p.Name, "Your practice logs are kept.")) return;
        if (Runner.Plan?.Id == p.Id) await Runner.EndAsync();
        await Store.DeletePlanAsync(p);
        Snackbar.Add($"Deleted “{p.Name}”", Severity.Info);
    }

    async Task Run(PracticePlan p, int from = 0)
    {
        if (p.Steps.Any(s => s.Kind == PlanStepKind.Piece && Store.GetPiece(s.PieceId) == null))
            Snackbar.Add("Some steps refer to deleted pieces; skip them when they come up.", Severity.Warning);
        await Runner.StartAsync(p, from);
    }

    public void Dispose() { Store.Changed -= OnChanged; Runner.Changed -= OnChanged; }
}
