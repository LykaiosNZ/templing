@page "/settings"
@inject DataStore Store
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject MetronomeService Metro
@inject NavigationManager Nav
@inject UpdateCheck Updates
@inject Devices Devices
@implements IDisposable

<PageTitle>Settings · Templing</PageTitle>

<div class="page-head">
    <h1 class="page-title" tabindex="-1">Settings &amp; data</h1>
</div>

@DemoNotice

<div class="settings-list">
    <section aria-labelledby="set-practice">
        <h2 class="settings-heading" id="set-practice">Practice</h2>
        <div class="setting-row">
            <div class="setting-text"><div class="setting-title">Weekly goal</div></div>
            <div class="setting-control">
                <DurationInput Seconds="Store.Settings.WeeklyGoalMin * 60.0" SecondsChanged="async v => { Store.Settings.WeeklyGoalMin = (int)Math.Round((v ?? 0) / 60); await Save(); }"
                               AriaLabel="Weekly goal" StepSeconds="900" MaxSeconds="100 * 3600" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:140px" />
            </div>
        </div>
    </section>

    <section aria-labelledby="set-plans">
        <h2 class="settings-heading" id="set-plans">Plans</h2>
        <div class="setting-row">
            <div class="setting-text"><div class="setting-title">Log finished steps automatically</div></div>
            <div class="setting-control">
                <MudSwitch T="bool" @bind-Value="Store.Settings.AutoLogPlanSteps" @bind-Value:after="Save" Color="Color.Primary" aria-label="Log finished plan steps automatically" Class="ma-0" />
            </div>
        </div>
        <div class="setting-row">
            <div class="setting-text">
                <div class="setting-title">Start the next step automatically</div>
                <div class="setting-desc">Rests always start on their own.</div>
            </div>
            <div class="setting-control">
                <MudSwitch T="bool" @bind-Value="Store.Settings.AutoStartPlanSteps" @bind-Value:after="Save" Color="Color.Primary" aria-label="Start the next plan step automatically" Class="ma-0" />
            </div>
        </div>
        <div class="setting-row">
            <div class="setting-text"><div class="setting-title">Start steps automatically on Skip and Back</div></div>
            <div class="setting-control">
                <MudSwitch T="bool" @bind-Value="Store.Settings.AutoStartPlanStepsOnSkip" @bind-Value:after="Save" Color="Color.Primary" aria-label="Start plan steps automatically on Skip and Back" Class="ma-0" />
            </div>
        </div>
    </section>

    <section aria-labelledby="set-metronome">
        <h2 class="settings-heading" id="set-metronome">Metronome</h2>
        <div class="setting-row">
            <div class="setting-text">
                <div class="setting-title">Click sound</div>
                <div class="setting-desc">Pieces and custom metronomes can have their own.</div>
            </div>
            <div class="setting-control">
                <ClickSoundPicker Value="@ClickSounds.Resolve(Store.Settings.Metronome.Sound)" ValueChanged="SetClickSound" Label="@null" />
            </div>
        </div>
        @{ var m = Store.Settings.Metronome; }
        <div class="setting-row">
            <div class="setting-text"><div class="setting-title">Tempo slider</div></div>
            <div class="setting-control">
                <MudSwitch T="bool" @bind-Value="m.TempoSlider" @bind-Value:after="Save" Color="Color.Primary" aria-label="Tempo slider" Class="ma-0" />
            </div>
        </div>
        <div class="setting-row">
            <div class="setting-text"><div class="setting-title">Beat display</div></div>
            <div class="setting-control">
                <MudSelect T="BeatDisplayStyle" @bind-Value="m.BeatDisplay" @bind-Value:after="Save" aria-label="Beat display"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="setting-select">
                    <MudSelectItem T="BeatDisplayStyle" Value="BeatDisplayStyle.Strip">Strip</MudSelectItem>
                    <MudSelectItem T="BeatDisplayStyle" Value="BeatDisplayStyle.Ring">Ring</MudSelectItem>
                    <MudSelectItem T="BeatDisplayStyle" Value="BeatDisplayStyle.Both">Strip and ring</MudSelectItem>
                </MudSelect>
            </div>
        </div>
        <div class="setting-row">
            <div class="setting-text"><div class="setting-title">Fill</div></div>
            <div class="setting-control">
                <MudSelect T="BeatFill" @bind-Value="m.BeatFill" @bind-Value:after="Save" aria-label="Fill"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="setting-select">
                    <MudSelectItem T="BeatFill" Value="BeatFill.OnClick">On the click</MudSelectItem>
                    <MudSelectItem T="BeatFill" Value="BeatFill.Sweep">Sweep</MudSelectItem>
                </MudSelect>
            </div>
        </div>
        <div class="setting-row">
            <div class="setting-text"><div class="setting-title">New bar</div></div>
            <div class="setting-control">
                <MudSelect T="NewBarStyle" @bind-Value="m.NewBar" @bind-Value:after="Save" aria-label="New bar"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="setting-select">
                    <MudSelectItem T="NewBarStyle" Value="NewBarStyle.Clear">Clear</MudSelectItem>
                    <MudSelectItem T="NewBarStyle" Value="NewBarStyle.Fade">Fade</MudSelectItem>
                    <MudSelectItem T="NewBarStyle" Value="NewBarStyle.EmptyOut">Empty out every other bar</MudSelectItem>
                </MudSelect>
            </div>
        </div>
        <div class="setting-row">
            <div class="setting-text"><div class="setting-title">Pulse on each new bar</div></div>
            <div class="setting-control">
                <MudSwitch T="bool" @bind-Value="m.BarPulse" @bind-Value:after="Save" Color="Color.Primary" aria-label="Pulse on each new bar" Class="ma-0" />
            </div>
        </div>
        @if (m.BarPulse)
        {
            <div class="setting-row setting-row-sub">
                <div class="setting-text"><div class="setting-title">Pulse intensity</div></div>
                <div class="setting-control">
                    <MudSelect T="PulseIntensity" @bind-Value="m.BarPulseIntensity" @bind-Value:after="Save" aria-label="Pulse intensity"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="setting-select">
                        <MudSelectItem T="PulseIntensity" Value="PulseIntensity.Subtle">Subtle</MudSelectItem>
                        <MudSelectItem T="PulseIntensity" Value="PulseIntensity.Medium">Medium</MudSelectItem>
                        <MudSelectItem T="PulseIntensity" Value="PulseIntensity.Strong">Strong</MudSelectItem>
                    </MudSelect>
                </div>
            </div>
        }
        <div class="setting-row">
            <div class="setting-text"><div class="setting-title">Flash on each beat</div></div>
            <div class="setting-control">
                <MudSwitch T="bool" @bind-Value="m.Flash" @bind-Value:after="Save" Color="Color.Primary" aria-label="Flash on each beat" Class="ma-0" />
            </div>
        </div>
        <div class="setting-row">
            <div class="setting-text"><div class="setting-title">Mark the first beat</div></div>
            <div class="setting-control">
                <MudSwitch T="bool" @bind-Value="m.MarkFirstBeat" @bind-Value:after="Save" Color="Color.Primary" aria-label="Mark the first beat" Class="ma-0" />
            </div>
        </div>
        <div class="setting-row">
            <div class="setting-text"><div class="setting-title">Show subdivisions</div></div>
            <div class="setting-control">
                <MudSwitch T="bool" @bind-Value="m.ShowSubdivisions" @bind-Value:after="Save" Color="Color.Primary" aria-label="Show subdivisions" Class="ma-0" />
            </div>
        </div>
        @if (m.ShowSubdivisions)
        {
            <div class="setting-row setting-row-sub">
                <div class="setting-text"><div class="setting-title">Thinner subdivisions</div></div>
                <div class="setting-control">
                    <MudSwitch T="bool" @bind-Value="m.ThinSubdivisions" @bind-Value:after="Save" Color="Color.Primary" aria-label="Thinner subdivisions" Class="ma-0" />
                </div>
            </div>
        }
    </section>

    <section aria-labelledby="set-presets">
        <h2 class="settings-heading" id="set-presets">Interval presets</h2>
        <div class="setting-row setting-row-top">
            <div class="setting-text"><div class="setting-title">Metronome intervals</div></div>
            <div class="setting-control">
                <IntervalPresetsEditor List="Store.Settings.MetronomeIntervalPresets" Defaults="IntervalsEditor.MetronomeDefaults" Name="Metronome interval presets"
                                       ListChanged="async l => { Store.Settings.MetronomeIntervalPresets = l; await Save(); }" />
            </div>
        </div>
        <div class="setting-row setting-row-top">
            <div class="setting-text"><div class="setting-title">Timer countdown</div></div>
            <div class="setting-control">
                <IntervalPresetsEditor List="Store.Settings.TimerIntervalPresets" Defaults="IntervalsEditor.TimerDefaults" Name="Timer countdown presets"
                                       ListChanged="async l => { Store.Settings.TimerIntervalPresets = l; await Save(); }" />
            </div>
        </div>
    </section>

    <section aria-labelledby="set-colours">
        <h2 class="settings-heading" id="set-colours">Colours</h2>
        <ColoursEditor />
    </section>

    <section aria-labelledby="set-data">
        <h2 class="settings-heading" id="set-data">Data</h2>
        <div class="setting-row">
            <div class="setting-text">
                <div class="setting-title">Backup</div>
                <div class="setting-desc">Score files aren't included. Restore takes plain or compressed backups.</div>
            </div>
            <div class="setting-control">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.Download" OnClick="ExportJson" Disabled="_busy != null">@(_busy == Busy.Export ? "Exporting…" : "Export")</MudButton>
                <MudFileUpload T="IBrowserFile" @ref="_upload" FilesChanged="ImportJson" Accept=".json,.gz,application/json,application/gzip,application/x-gzip" Class="ma-0">
                    <CustomContent>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.Restore" OnClick="@context.OpenFilePickerAsync" Disabled="_busy != null">@(_busy switch { Busy.Read => "Reading…", Busy.Restore => "Restoring…", _ => "Restore…" })</MudButton>
                    </CustomContent>
                    <SelectedTemplate />
                </MudFileUpload>
            </div>
        </div>
        <div class="setting-row">
            <div class="setting-text">
                <div class="setting-title">Compress backups</div>
                <div class="setting-desc">Exports a .json.gz file, around a tenth of the size, handy for moving to another device.</div>
            </div>
            <div class="setting-control">
                <MudSwitch T="bool" @bind-Value="Store.Settings.CompressBackups" @bind-Value:after="Save" Color="Color.Primary" aria-label="Compress backups" Class="ma-0" />
            </div>
        </div>
        <div class="setting-row">
            <div class="setting-text"><div class="setting-title">Practice log</div></div>
            <div class="setting-control">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.TableView" OnClick="ExportCsv">Export CSV</MudButton>
            </div>
        </div>
        <div class="setting-row">
            <div class="setting-text">
                <div class="setting-title">Share anonymous usage stats</div>
                <div class="setting-desc">Counts which screens are opened, and when practice is logged, a piece added or a plan run, with <a href="https://umami.is" target="_blank" rel="noopener">Umami</a>. No cookies, and nothing from your library.</div>
            </div>
            <div class="setting-control">
                <MudSwitch T="bool" @bind-Value="Store.Settings.Analytics" @bind-Value:after="Save" Color="Color.Primary" aria-label="Share anonymous usage stats" Class="ma-0" />
            </div>
        </div>
        <div class="setting-row">
            <div class="setting-text"><div class="setting-title">Delete all data</div></div>
            <div class="setting-control">
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Rounded.DeleteForever" OnClick="ClearAll">Delete…</MudButton>
            </div>
        </div>
    </section>

    @DevicesPart

    <section aria-labelledby="set-about">
        <h2 class="settings-heading" id="set-about">About</h2>
        <div class="setting-row">
            <div class="setting-text"><div class="setting-title">Version</div></div>
            <div class="setting-control"><span class="setting-value" title="@AppInfo.InformationalVersion">@AppInfo.Version</span></div>
        </div>
        @if (Updates.AvailableDisplay is { } next)
        {
            <div class="setting-row">
                <div class="setting-text">
                    <div class="setting-title">New version available</div>
                    <div class="setting-desc" title="@Updates.Available">@next</div>
                </div>
                <div class="setting-control">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Refresh"
                               OnClick="@(() => Updates.ReloadAsync().AsTask())">Reload</MudButton>
                </div>
            </div>
        }
        <div class="setting-row">
            <div class="setting-text"><div class="setting-title">Source code</div></div>
            <div class="setting-control">
                <MudButton Variant="Variant.Outlined" StartIcon="@Mdi.Github" EndIcon="@Icons.Material.Rounded.OpenInNew"
                           Href="@AppInfo.RepositoryUrl" Target="_blank" rel="noopener">GitHub</MudButton>
            </div>
        </div>
    </section>
</div>

@code {
    // the demo build's note (DEMO_MODE; #if in markup isn't a directive, so it's here): the normal build doesn't contain it
#if DEMO_MODE
    private static readonly RenderFragment DemoNotice =
        @<MudAlert Severity="Severity.Info" Class="mb-4">
            This is the demo: sample data, kept in memory. It never touches the data you keep in this browser, and it starts
            afresh when you reload.
        </MudAlert>;
#else
    private static readonly RenderFragment? DemoNotice = null;
#endif

    // Settings > Devices (pairing, sending data between devices): not in the demo, whose data is only in memory
#if DEMO_MODE
    private RenderFragment? DevicesPart => null;
#else
    private RenderFragment DevicesPart => @<DevicesSection Restore="RestoreFileAsync" />;
#endif

    [SupplyParameterFromQuery(Name = "restored")] public int? Restored { get; set; }

    protected override void OnInitialized()
    {
        Updates.Changed += OnUpdate;
        if (Restored == 1)
        {
            Snackbar.Add($"Backup restored, including settings. You now have {Store.Pieces.Count} pieces and {Store.Logs.Count} log entries.", Severity.Success);
            Nav.NavigateTo("settings", replace: true);
        }
    }

    void OnUpdate() => InvokeAsync(StateHasChanged);
    public void Dispose() => Updates.Changed -= OnUpdate;

    Task Save() => Store.SaveSettingsAsync();

    async Task SetClickSound(string? id)
    {
        Store.Settings.Metronome.Sound = ClickSounds.Resolve(id);
        await Save();
        await Metro.ApplyAsync(persist: false);
    }

    // Export and restore hold the page (WebAssembly has one thread) for a moment with a lot of history:
    // the button says what's happening, and is shown before the work starts
    enum Busy { Export, Read, Restore }
    Busy? _busy;

    async Task ShowBusy(Busy? busy)
    {
        _busy = busy;
        StateHasChanged();
        if (busy != null) await Task.Delay(50); // let the browser paint it before the work blocks the thread
    }

    async Task ExportJson()
    {
        await ShowBusy(Busy.Export);
        try
        {
            var name = $"templing-backup-{DateTime.Today:yyyy-MM-dd}.json";
            if (Store.Settings.CompressBackups) await Store.DownloadAsync(name + ".gz", Backup.ExportGzip(Store), "application/gzip");
            else await Store.DownloadAsync(name, Backup.ExportUtf8(Store), "application/json");
        }
        finally { await ShowBusy(null); }
    }

    async Task ExportCsv() =>
        await Store.DownloadAsync($"templing-log-{DateTime.Today:yyyy-MM-dd}.csv", LogCsv.ExportLogCsv(Store), "text/csv");

    MudFileUpload<IBrowserFile>? _upload;
    const long MaxBackupBytes = 200_000_000;

    async Task ImportJson(IBrowserFile? picked)
    {
        if (picked == null) return;
        try
        {
            await ShowBusy(Busy.Read);
            // read it whole, in big chunks: each read is a trip to JS, and the default buffer made an 8 MB file take seconds
            using var bytes = new MemoryStream((int)Math.Min(picked.Size, MaxBackupBytes));
            await using (var stream = picked.OpenReadStream(MaxBackupBytes)) await stream.CopyToAsync(bytes, 1 << 20);
            var file = Backup.Parse(bytes.ToArray());
            await ShowBusy(null);
            await RestoreFileAsync(file, picked.Name);
        }
        catch (FormatException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);   // Backup.Parse: not a backup, damaged, too new or too old
        }
        catch (Exception)
        {
            Snackbar.Add("Couldn't restore that backup.", Severity.Error);
        }
        finally
        {
            await ShowBusy(null);
            // forget the picked file, so the same file can be chosen again and no file chip lingers
            if (_upload != null) await _upload.ClearAsync();
        }
    }

    /// <summary>Asks what to restore from a backup (read from a file, or sent by a paired device), then restores it.</summary>
    async Task RestoreFileAsync(Backup.BackupFile file, string name)
    {
        try
        {
            var includeSettings = await RestoreDialog.ShowAsync(Dialogs, file, name);
            if (includeSettings == null) return;
            if (includeSettings == true) await Metro.StopAsync();
            await ShowBusy(Busy.Restore);
            var summary = await Backup.RestoreAsync(Store, file, includeSettings.Value);
            if (includeSettings == true)
            {
                // services hold references into the old settings; reload so everything picks up the restored ones
                Nav.NavigateTo("settings?restored=1", forceLoad: true);
                return;
            }
            Snackbar.Add(summary, Severity.Success);
        }
        finally { await ShowBusy(null); }
    }

    async Task ClearAll()
    {
        var ok = await ConfirmDialog.ShowAsync(Dialogs, "Delete all data?",
            "Every piece, log entry, plan, custom metronome and paired device in this browser will be deleted. Export a backup first if you might want it back. This can't be undone.",
            "Delete everything", destructive: true);
        if (ok != true) return;
        await Store.ClearAllAsync();
        if (!AppInfo.Demo) await Devices.ResetAsync();
        Snackbar.Add("All data deleted", Severity.Info);
    }
}
