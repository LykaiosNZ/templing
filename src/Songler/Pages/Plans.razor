@page "/plans"
@implements IDisposable
@inject DataStore Store
@inject PlanRunner Runner
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Plans · Songler</PageTitle>

<div class="page-head">
    <h1 class="page-title" tabindex="-1">Plans</h1>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="New">New plan</MudButton>
</div>

@if (Store.Plans.Count == 0)
{
    <div class="empty-state">
        <MudIcon Icon="@Icons.Material.Rounded.ChecklistRtl" Style="font-size:3rem" />
        <MudText Typo="Typo.h6">No plans yet</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="New" Class="mt-2">Create a plan</MudButton>
    </div>
}
else
{
    @* One row per plan: name and totals; the row expands to its steps. The running plan is open and outlined. *@
    <div class="plan-rows" role="list">
        @foreach (var plan in Store.Plans.OrderByDescending(p => p.LastRun ?? p.Created))
        {
            var running = Runner.Active && Runner.Plan?.Id == plan.Id;
            var open = IsOpen(plan, running);
            var bodyId = $"plan-steps-{plan.Id}";
            var p = plan;
            <div class="plan-row @(open ? "open" : "") @(running ? "running" : "")" role="listitem">
                <div class="plr-head">
                    <button type="button" class="plr-toggle" aria-expanded="@(open ? "true" : "false")" aria-controls="@bodyId" @onclick="() => Toggle(p, running)">
                        <MudIcon Icon="@Icons.Material.Rounded.ExpandMore" Size="Size.Small" Class="er-chevron" />
                        <span class="plr-name">@plan.Name</span>
                        <span class="plr-meta">@Meta(plan, running)</span>
                    </button>
                    <div class="plr-actions">
                        <FavouriteToggle On="plan.Favourite" Name="@plan.Name" OnToggle="() => ToggleFavourite(p)" />
                        <MudTooltip Text="Edit">
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Rounded.Edit" aria-label="@($"Edit {plan.Name}")" OnClick="() => Edit(p)" />
                        </MudTooltip>
                        <MudTooltip Text="More">
                            <MudMenu Icon="@Icons.Material.Rounded.MoreVert" Size="Size.Small" Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" AriaLabel="@($"More for {plan.Name}")">
                                <MudMenuItem Icon="@Icons.Material.Rounded.ContentCopy" OnClick="() => Duplicate(p)">Duplicate</MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Rounded.Delete" OnClick="() => AfterMenu(() => Delete(p))">Delete…</MudMenuItem>
                            </MudMenu>
                        </MudTooltip>
                        @if (running)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Rounded.Stop" OnClick="() => Runner.EndAsync()" Class="plr-run" aria-label="@($"End {plan.Name}")">End plan</MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Rounded.PlayArrow" OnClick="() => Run(p)" Class="plr-run" aria-label="@($"Run {plan.Name}")">Run plan</MudButton>
                        }
                    </div>
                </div>
                @if (open)
                {
                    <ol class="plan-list" id="@bodyId">
                        @for (int i = 0; i < plan.Steps.Count; i++)
                        {
                            var s = plan.Steps[i];
                            var idx = i;
                            var missing = PlanStepSummary.IsMissing(s, Store);
                            <li class="@(s.Kind == PlanStepKind.Rest ? "rest" : "") @(missing ? "missing" : "") @(running && Runner.Index == idx ? "on" : "")">
                                <PlanStepSummary Step="s" Index="idx" />
                            </li>
                        }
                    </ol>
                }
            </div>
        }
    </div>
}

@code {
    // Rows the user opened or closed this visit; anything not listed follows the default (only the running plan is open)
    readonly Dictionary<string, bool> _open = new();
    bool IsOpen(PracticePlan p, bool running) => _open.TryGetValue(p.Id, out var o) ? o : running;
    void Toggle(PracticePlan p, bool running) => _open[p.Id] = !IsOpen(p, running);

    async Task ToggleFavourite(PracticePlan p) { p.Favourite = !p.Favourite; await Store.SavePlanAsync(p); }

    // MudMenu only closes once a menu item's handler finishes; start dialogs after it closes instead of awaiting them inside the click
    void AfterMenu(Func<Task> action) => _ = InvokeAsync(action);
    protected override void OnInitialized() { Store.Changed += OnChanged; Runner.Changed += OnChanged; }
    void OnChanged() => InvokeAsync(StateHasChanged);

    string Meta(PracticePlan p, bool running)
    {
        var n = p.Steps.Count;
        var parts = new List<string> { $"{n} step{(n == 1 ? "" : "s")}", StepDur(p.TotalMinutes) };
        if (running) parts.Add($"Step {Runner.Index + 1} of {n}");
        else parts.Add(p.LastRun is null ? "Not run yet" : $"Last run {Stats.Ago(p.LastRun, DateTime.Today)}");
        return string.Join(" · ", parts);
    }

    static string StepDur(double min) => Stats.DurationMin(min);

    async Task Duplicate(PracticePlan p)
    {
        var copy = System.Text.Json.JsonSerializer.Deserialize<PracticePlan>(System.Text.Json.JsonSerializer.Serialize(p, DataStore.Json), DataStore.Json)!;
        copy.Id = Guid.NewGuid().ToString("N");
        copy.Name = $"{p.Name} (copy)";
        copy.Created = DateTime.Now;
        copy.LastRun = null;
        await Store.SavePlanAsync(copy);
    }


    async Task New() => await PlanDialog.ShowAsync(Dialogs);
    async Task Edit(PracticePlan p) => await PlanDialog.ShowAsync(Dialogs, p);

    async Task Delete(PracticePlan p)
    {
        if (!await ConfirmDialog.DeleteAsync(Dialogs, "plan", p.Name, "Your practice logs are kept.")) return;
        if (Runner.Plan?.Id == p.Id) await Runner.EndAsync();
        await Store.DeletePlanAsync(p);
        Snackbar.Add($"Deleted “{p.Name}”", Severity.Info);
    }

    async Task Run(PracticePlan p)
    {
        if (p.Steps.Any(s => s.Kind == PlanStepKind.Piece && Store.GetPiece(s.PieceId) == null))
            Snackbar.Add("Some steps refer to deleted pieces; skip them when they come up.", Severity.Warning);
        await Runner.StartAsync(p);
    }

    public void Dispose() { Store.Changed -= OnChanged; Runner.Changed -= OnChanged; }
}
