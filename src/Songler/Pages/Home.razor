@page "/"
@implements IDisposable
@inject DataStore Store

<PageTitle>Dashboard · Songler</PageTitle>

<div class="page-head">
    <div>
        <MudText Typo="Typo.overline" Class="muted">@DateTime.Today.ToString("dddd d MMMM")</MudText>
        <h1 class="page-title" tabindex="-1">@Greeting</h1>
    </div>
</div>

@if (Store.Logs.Count == 0)
{
    <div class="empty-state">
        <MudIcon Icon="@Icons.Material.Rounded.Insights" Style="font-size:3rem" />
        <MudText Typo="Typo.h6">No practice logged yet</MudText>
        <MudText Class="muted">Start the metronome and log your session, or restore a backup in <a href="settings">Settings &amp; data</a>.</MudText>
    </div>
}
else
{
    <div class="tiles">
        <StatTile Label="This week" Seconds="_weekSec" Icon="@Icons.Material.Rounded.DateRange" Sub="@($"Goal {Stats.Duration(Store.Settings.WeeklyGoalMin * 60)}")">
            <GoalBar Progress="_weekPct" Class="mt-2" AriaLabel="Weekly goal" />
        </StatTile>
        <StatTile Label="Current streak" Value="@_streak.current.ToString()" Unit="@(_streak.current == 1 ? " day" : " days")" Icon="@Icons.Material.Rounded.LocalFireDepartment"
                  Sub="@(_streak.current == 0 && _lastDay is { } ld ? $"Last practised {Stats.Ago(ld, DateTime.Today)} · best {_streak.longest}" : $"Longest {_streak.longest} days")" />
        <StatTile Label="Days practised" Value="@_days.ToString()" Icon="@Icons.Material.Rounded.CalendarMonth" Sub="@($"{_last30} of the last 30")" />
        <StatTile Label="Total logged" Seconds="_totalSec" Icon="@Icons.Material.Rounded.Timer" Sub="@($"{Store.Logs.Count} entries")" />
    </div>

    <MudGrid Spacing="4" Class="mt-1">
        <MudItem xs="12" lg="8">
            <section class="card">
                <div class="card-head">
                    <h2 class="card-title">Practice calendar</h2>
                    <a href="stats" class="small">All stats →</a>
                </div>
                <Heatmap SecondsByDay="_byDay" Weeks="26" />
            </section>
            <section class="card mt-4">
                <h2 class="card-title">Weekly practice time</h2>
                <BarChart Labels="_weekLabels" Values="_weekValues" Minutes="true" LabelEvery="3" AriaLabel="Practice time per week, last 16 weeks" />
            </section>
        </MudItem>
        <MudItem xs="12" lg="4">
            <section class="card">
                <div class="card-head">
                    <h2 class="card-title">Goals in progress</h2>
                    <a href="library" class="small">Library →</a>
                </div>
                @if (_goals.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="muted">Nothing in progress. Everything you've practised lately is at its goal.</MudText>
                }
                <ul class="goal-list">
                    @foreach (var (piece, st) in _goals)
                    {
                        <li>
                            <a href="library/@piece.Id" class="goal-row">
                                <div class="goal-top">
                                    <span class="goal-name">@piece.Name</span>
                                    <span class="mono small">@(st.Last?.ToString("0"))/@piece.Goal?.ToString("0")@piece.Unit.Suffix()</span>
                                </div>
                                <GoalBar Progress="st.Progress" AriaLabel="@($"{piece.Name} progress")" />
                            </a>
                        </li>
                    }
                </ul>
            </section>
            <section class="card mt-4">
                <div class="card-head">
                    <h2 class="card-title">Recent sessions</h2>
                    <a href="history" class="small">History →</a>
                </div>
                <ul class="recent-list">
                    @foreach (var day in _recent)
                    {
                        <li>
                            <div class="recent-day">@Stats.Ago(day.Key, DateTime.Today) <span class="muted">· @Stats.Duration(day.Sum(l => l.DurationSec ?? 0))</span></div>
                            <div class="recent-pieces">
                                @foreach (var l in day)
                                {
                                    <span class="recent-chip">@l.PieceName <span class="mono">@l.ValueText</span></span>
                                }
                            </div>
                        </li>
                    }
                </ul>
            </section>
        </MudItem>
    </MudGrid>
}

@code {
    int _weekSec, _totalSec, _days, _last30;
    double _weekPct;
    (int current, int longest) _streak;
    Dictionary<DateTime, int> _byDay = new();
    HashSet<DateTime> _practiced = new();
    List<string> _weekLabels = new();
    List<double> _weekValues = new();
    List<(Piece, PieceStats)> _goals = new();
    List<IGrouping<DateTime, PracticeLog>> _recent = new();
    DateTime? _lastDay;


    string Greeting => DateTime.Now.Hour switch { < 12 => "Good morning", < 18 => "Good afternoon", _ => "Good evening" };

    protected override void OnInitialized() { Store.Changed += OnChanged; Refresh(); }
    void OnChanged() { Refresh(); InvokeAsync(StateHasChanged); }

    void Refresh()
    {
        var today = DateTime.Today;
        var logs = Store.Logs;
        _byDay = Stats.SecondsByDay(logs);
        _practiced = Stats.DaysPracticed(logs);
        var ws = Stats.WeekStart(today);
        _weekSec = logs.Where(l => l.Date >= ws).Sum(l => l.DurationSec ?? 0);
        _weekPct = Store.Settings.WeeklyGoalMin > 0 ? _weekSec / 60.0 / Store.Settings.WeeklyGoalMin : 0;
        _totalSec = logs.Sum(l => l.DurationSec ?? 0);
        _days = _practiced.Count;
        _last30 = _practiced.Count(d => d > today.AddDays(-30));
        _streak = Stats.Streaks(logs, today);
        var weeks = Stats.WeeklySeconds(logs, today, 16);
        _weekLabels = Stats.WeekLabels(weeks);
        _weekValues = weeks.Select(w => w.sec / 60.0).ToList();
        _goals = Store.Pieces.Where(i => !i.Archived && i.Goal.HasValue)
            .Select(i => (i, Stats.ForPiece(i, logs)))
            .Where(x => x.Item2.LastDate >= today.AddDays(-30) && x.Item2.Progress is < 1)
            .OrderByDescending(x => x.Item2.Progress)
            .Take(8).ToList();
        _lastDay = _practiced.Count > 0 ? _practiced.Max() : null;
        _recent = logs.Where(l => l.Date >= today.AddDays(-14)).OrderByDescending(l => l.Date).GroupBy(l => l.Date.Date).Take(3).ToList();
    }

    public void Dispose() => Store.Changed -= OnChanged;
}
