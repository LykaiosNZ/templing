@page "/metronome"
@page "/metronome/free"
@page "/metronome/item/{ItemId}"
@page "/metronome/item/{ItemId}/{SectionId}"
@page "/metronome/preset/{PresetId}"
@implements IDisposable
@inject MetronomeService Metro
@inject DataStore Store
@inject NavigationManager Nav
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>@(Metro.Source == MetronomeSource.Free ? "Free metronome" : $"{Metro.Title} · Metronome") · Songler</PageTitle>

<div class="page-head">
    <div>
        @if (Metro.Source != MetronomeSource.Free)
        {
            <MudText Typo="Typo.overline" Class="muted">@SourceLabel</MudText>
        }
        <h1 class="page-title" tabindex="-1">@(Metro.Source == MetronomeSource.Free ? "Free metronome" : Metro.Title)</h1>
        @if (Metro.Item is { } item && Metro.Source == MetronomeSource.Item)
        {
            var st = Stats.ForItem(item, Store.Logs);
            <MudText Typo="Typo.body2" Class="muted">
                Last @(st.Last?.ToString("0") ?? "—")@item.Unit.Suffix() · Best @(st.Best?.ToString("0") ?? "—")@item.Unit.Suffix()
                @if (item.Goal is { } g) { <span> · Goal @g.ToString("0")@item.Unit.Suffix()</span> }
                · <a href="library/@item.Id">View progress</a>
            </MudText>
            <FeelHint Item="item" />
        }
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <MudMenu Label="Load…" StartIcon="@Icons.Material.Rounded.FolderOpen" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" aria-label="Load metronome source">
            <MudMenuItem Href="metronome/free" Icon="@Mdi.Metronome">Free metronome</MudMenuItem>
            @if (Store.Presets.Count > 0)
            {
                <MudDivider />
                <MudText Typo="Typo.overline" Class="px-4 muted">Custom metronomes</MudText>
                @foreach (var p in Store.Presets.OrderBy(p => p.Name))
                {
                    <MudMenuItem Href="@($"metronome/preset/{p.Id}")" Icon="@Icons.Material.Rounded.Tune">@p.Name</MudMenuItem>
                }
            }
            <MudDivider />
            <MudText Typo="Typo.overline" Class="px-4 muted">Library</MudText>
            @foreach (var i in Store.Items.Where(i => !i.Archived))
            {
                <MudMenuItem Href="@($"metronome/item/{i.Id}")" Icon="@i.Type.Icon()">@i.Name</MudMenuItem>
            }
        </MudMenu>
        @if (Metro.Source == MetronomeSource.Preset)
        {
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.ViewAgenda" OnClick="EditPresetSections">Edit sections…</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.Save" OnClick="SavePreset">Save</MudButton>
            <MudIconButton Icon="@Icons.Material.Rounded.Delete" Variant="Variant.Outlined" aria-label="Delete custom metronome" OnClick="DeletePreset" />
        }
        else if (Metro.Source == MetronomeSource.Free)
        {
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.Save" OnClick="SavePreset">Save as custom</MudButton>
        }
    </div>
</div>

<MudGrid Spacing="4">
    <MudItem xs="12" lg="7">
        <section class="stage @(Metro.IsRunning ? "running" : "") phase-@Metro.State.phase" aria-label="Metronome controls">
            @if (Metro.Sections.Count > 1)
            {
                <div class="section-picker">
                    <MudTooltip Text="Previous section">
                        <MudIconButton Icon="@Icons.Material.Rounded.SkipPrevious" aria-label="Previous section" OnClick="() => Metro.PrevStepAsync()" />
                    </MudTooltip>
                    <MudSelect T="int" Value="CurStep" ValueChanged="i => Metro.SetStepAsync(i)" ToStringFunc="SectionLabel" Label="Section"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="section-select" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
                        @for (int i = 0; i < Metro.Sections.Count; i++)
                        {
                            var idx = i;
                            var sec = Metro.Sections[i];
                            <MudSelectItem T="int" Value="idx">
                                <div class="sec-opt">
                                    <span class="sec-opt-name">@(idx + 1). @sec.Name</span>
                                    <span class="sec-opt-meta">@sec.Bpm.ToString("0") bpm · @sec.Meter@(sec.Length > 0 ? $" · {sec.Length} bars" : "")</span>
                                </div>
                            </MudSelectItem>
                        }
                    </MudSelect>
                    <MudTooltip Text="Next section">
                        <MudIconButton Icon="@Icons.Material.Rounded.SkipNext" aria-label="Next section" OnClick="() => Metro.NextStepAsync()" />
                    </MudTooltip>
                </div>
            }

            <div class="tempo-row">
                <MudIconButton Icon="@Icons.Material.Rounded.Remove" Variant="Variant.Outlined" Size="Size.Large" aria-label="Slower" OnClick="() => Metro.NudgeAsync(-1)" />
                <div class="tempo-display" aria-live="polite">
                    <div id="metro-pulse" class="pulse" aria-hidden="true"></div>
                    <div class="tempo-value">@Metro.Value.ToString("0")<span class="tempo-unit">@(Metro.Unit == TempoUnit.Percent ? "%" : "")</span></div>
                    <div class="tempo-sub">
                        @if (Metro.Unit == TempoUnit.Percent)
                        {
                            <span>@Metro.PlayingBpm.ToString("0") bpm</span>
                        }
                        else
                        {
                            <span>bpm</span>
                        }
                        <span> · @Metro.PlayingSection.Meter</span>
                        <span> · @SubName(Metro.PlayingSection.Subdivision)</span>
                        @if (Metro.Source != MetronomeSource.Item && Metro.Sections.Count > 1 && Math.Abs(Metro.Factor - 1) > 0.001 && !Metro.IsRunning)
                        {
                            <MudLink Class="ml-2" OnClick="() => Metro.ResetFactorAsync()" Typo="Typo.body2">reset ×@Metro.Factor.ToString("0.00")</MudLink>
                        }
                    </div>
                </div>
                <MudIconButton Icon="@Icons.Material.Rounded.Add" Variant="Variant.Outlined" Size="Size.Large" aria-label="Faster" OnClick="() => Metro.NudgeAsync(1)" />
            </div>

            <div class="tempo-slider">
                <MudSlider T="double" Value="Metro.Value" ValueChanged="v => Metro.SetValueAsync(v)" Min="Metro.Min" Max="@(Metro.Unit == TempoUnit.Percent ? 150 : 300)" Step="1"
                           Color="Color.Primary" aria-label="Tempo" />
            </div>

            <div id="metro-beats" class="beats" aria-hidden="true">
                @for (int b = 0; b < (Metro.IsRunning ? Metro.State.beats : Metro.PlayingSection.BeatsPerBar); b++)
                {
                    <span class="beat-dot @(b == 0 && Metro.Settings.AccentFirst ? "accent" : "")"></span>
                }
            </div>

            <div class="status-line" role="status" aria-live="polite">
                @if (Metro.IsRunning)
                {
                    @switch (Metro.State.phase)
                    {
                        case "countin":
                            <span class="phase countin">Count-in @Metro.State.count</span>
                            break;
                        case "rest":
                            <span class="phase rest">Rest · @Stats.Clock(Metro.State.remaining ?? 0)</span>
                            break;
                        default:
                            <span class="phase work">Playing</span>
                            <span class="muted">Bar @(Metro.State.barInPart + 1)@(Metro.PlayingSection.Length > 0 ? $"/{Metro.PlayingSection.Length}" : "") · @Metro.State.beats/@Metro.State.unit</span>
                            @if (Metro.State.remaining is { } rem)
                            {
                                <span class="muted">· @Stats.Clock(rem) left</span>
                            }
                            break;
                    }
                    @if (Metro.EffectiveIntervals.Enabled)
                    {
                        <span class="muted">· Round @Metro.State.round@(Metro.EffectiveIntervals.Rounds > 0 ? $"/{Metro.EffectiveIntervals.Rounds}" : "")</span>
                    }
                }
            </div>

            @if (Metro.Training.Enabled)
            {
                var tr = Metro.Training;
                var prog = Metro.IsRunning ? (Metro.State.trainingProgress ?? 0) : 0;
                <div class="training-bar">
                    <span>@tr.Start.ToString("0")</span>
                    <MudProgressLinear Value="@(prog * 100)" Color="Color.Primary" Rounded="true" Size="Size.Medium" aria-label="Speed trainer progress" />
                    <span>@tr.End.ToString("0")@(Metro.Unit == TempoUnit.Percent ? "%" : "")</span>
                </div>
                @if (TrainingNextText is { } next)
                {
                    <div class="training-next">@next</div>
                }
            }

            <div class="transport">
                <MudTooltip Text="Restart section">
                    <MudIconButton Icon="@Icons.Material.Rounded.Replay" aria-label="Restart section" OnClick="() => Metro.RestartSectionAsync()" />
                </MudTooltip>
                <button class="play-btn @(Metro.IsRunning ? "on" : "")" @onclick="() => Metro.ToggleAsync()" aria-label="@(Metro.IsRunning ? "Stop" : "Start")">
                    <MudIcon Icon="@(Metro.IsRunning ? Icons.Material.Rounded.Stop : Icons.Material.Rounded.PlayArrow)" Style="font-size:2.6rem" />
                </button>
                <MudTooltip Text="Tap tempo">
                    <MudButton Variant="Variant.Outlined" OnClick="() => Metro.TapAsync()" aria-label="Tap tempo" Class="tap-btn">Tap</MudButton>
                </MudTooltip>
            </div>

            <div class="quick-toggles" role="group" aria-label="Options">
                <MudTooltip Text="@($"Count-in: {(Metro.Settings.CountIn ? "on" : "off")}")">
                    <MudIconButton Icon="@Icons.Material.Rounded.HourglassTop" Class="@ToggleClass(Metro.Settings.CountIn)" aria-label="Count-in" aria-pressed="@Pressed(Metro.Settings.CountIn)"
                                   OnClick="() => Toggle(() => Metro.Settings.CountIn = !Metro.Settings.CountIn)" />
                </MudTooltip>
                <MudTooltip Text="@($"Speed trainer: {(Metro.Training.Enabled ? "on" : "off")}")">
                    <MudIconButton Icon="@Icons.Material.Rounded.TrendingUp" Class="@ToggleClass(Metro.Training.Enabled)" aria-label="Speed trainer" aria-pressed="@Pressed(Metro.Training.Enabled)"
                                   OnClick="() => Toggle(() => Metro.Training.Enabled = !Metro.Training.Enabled)" />
                </MudTooltip>
                <MudTooltip Text="@($"Intervals: {(Metro.Settings.Interval.Enabled ? "on" : "off")}")">
                    <MudIconButton Icon="@Icons.Material.Rounded.Timelapse" Class="@ToggleClass(Metro.Settings.Interval.Enabled)" aria-label="Intervals" aria-pressed="@Pressed(Metro.Settings.Interval.Enabled)"
                                   OnClick="() => Toggle(() => Metro.Settings.Interval.Enabled = !Metro.Settings.Interval.Enabled)" />
                </MudTooltip>
                @if (Metro.Sections.Count > 1)
                {
                    <MudTooltip Text="@($"Play through sections: {(Metro.PlayThrough ? "on" : "off")}")">
                        <MudIconButton Icon="@Icons.Material.Rounded.PlaylistPlay" Class="@ToggleClass(Metro.PlayThrough)" aria-label="Play through sections" aria-pressed="@Pressed(Metro.PlayThrough)"
                                       OnClick="() => Toggle(() => Metro.PlayThrough = !Metro.PlayThrough)" />
                    </MudTooltip>
                }
            </div>
        </section>

        <section class="card mt-4 session-card" aria-label="Session">
            <div class="card-head">
                <div class="d-flex align-center gap-1">
                    <h2 class="card-title">This session</h2>
                    <MudTooltip Text="Only time the click is playing counts. Count-ins, rests and pauses are excluded.">
                        <MudIcon Icon="@Icons.Material.Rounded.Info" Size="Size.Small" Class="muted" aria-label="How active time is counted" />
                    </MudTooltip>
                </div>
                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Rounded.RestartAlt" OnClick="() => Metro.ResetSession()" Disabled="Metro.SessionActiveSec < 1">Reset</MudButton>
            </div>
            <div class="session-stats">
                <StatTile Label="Active time" Value="@Stats.Clock(Metro.SessionActiveSec)" Icon="@Icons.Material.Rounded.Timer" />
                <StatTile Label="Tempo" Value="@SessionRange" Icon="@Icons.Material.Rounded.Speed" />
                <div class="session-log">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.AddTask" OnClick="LogSession" FullWidth="true">Log session</MudButton>
                </div>
            </div>
        </section>
    </MudItem>

    <MudItem xs="12" lg="5">
        <section class="card" aria-label="Metronome settings">
            <MudToggleGroup T="string" @bind-Value="_panel" Color="Color.Primary" Size="Size.Small" Outlined="true" CheckMark="false" Class="settings-switcher" aria-label="Settings">
                <MudToggleItem Value="@("trainer")"><span class="seg-label">Trainer<span class="@DotClass(Metro.Training.Enabled)" title="@OnOff(Metro.Training.Enabled)" aria-label="@OnOff(Metro.Training.Enabled)"></span></span></MudToggleItem>
                <MudToggleItem Value="@("intervals")"><span class="seg-label">Intervals<span class="@DotClass(Metro.Settings.Interval.Enabled)" title="@OnOff(Metro.Settings.Interval.Enabled)" aria-label="@OnOff(Metro.Settings.Interval.Enabled)"></span></span></MudToggleItem>
                <MudToggleItem Value="@("sound")"><span class="seg-label">Sound</span></MudToggleItem>
            </MudToggleGroup>
            <div class="settings-panel">
            @if (_panel == "trainer")
            {
                    @if (Metro.TrainingPinned)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">Set by your plan for this step. Changes here only affect this step.</MudAlert>
                    }
                    var tr = Metro.Training; var u = Metro.Unit == TempoUnit.Percent ? "%" : "bpm";
                    <div class="form-grid">
                        <MudNumericField T="double" @bind-Value="tr.Start" @bind-Value:after="Apply" Label="@($"Start ({u})")" Min="Metro.Min" Max="Metro.Max" />
                        <MudNumericField T="double" @bind-Value="tr.End" @bind-Value:after="Apply" Label="@($"End ({u})")" Min="Metro.Min" Max="Metro.Max" />
                    </div>
                    <MudToggleGroup T="RampMode" @bind-Value="tr.Mode" @bind-Value:after="Apply" Color="Color.Primary" Size="Size.Small" Outlined="true" Class="my-3">
                        <MudToggleItem Value="RampMode.OverTime" Text="Over a time period" />
                        <MudToggleItem Value="RampMode.EveryNBars" Text="Step every N bars" />
                    </MudToggleGroup>
                    @if (tr.Mode == RampMode.OverTime)
                    {
                        <DurationInput Seconds="tr.DurationMin * 60" SecondsChanged="async v => { tr.DurationMin = (v ?? 300) / 60; await Apply(); }" Label="Over (time playing)"
                                       MinSeconds="15" MaxSeconds="7200" />
                    }
                    else
                    {
                        <div class="form-grid">
                            <MudNumericField T="double" @bind-Value="tr.Increment" @bind-Value:after="Apply" Label="@($"Change by ({u})")" Min="0.5" Max="50" />
                            <MudNumericField T="int" @bind-Value="tr.EveryBars" @bind-Value:after="Apply" Label="Every (bars)" Min="1" Max="64" />
                        </div>
                    }
                    <MudCheckBox T="bool" @bind-Value="tr.StopAtEnd" @bind-Value:after="Apply" Color="Color.Primary" Label="Stop at end" />
                    <MudText Typo="Typo.caption" Class="muted d-block mt-2">@TrainerSummary</MudText>
            }
            else if (_panel == "intervals")
            {
                    @if (Metro.StepPinned)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">Your plan sets the intervals for this step. Changes here apply after the plan.</MudAlert>
                    }
                    var iv = Metro.Settings.Interval;
                    <div class="d-flex gap-2 flex-wrap mb-2">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => SetInterval(5, 1, 2)">5 · 1 · 5</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => SetInterval(10, 0, 1)">10 min</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => SetInterval(2, 0.5, 4)">4 × 2 min</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => SetInterval(0.5, 0.25, 8)">8 × 30 s</MudButton>
                    </div>
                    <div class="form-grid three">
                        <DurationInput Seconds="iv.WorkMin * 60" SecondsChanged="async v => { iv.WorkMin = (v ?? 15) / 60; await Apply(); }" Label="Work" MinSeconds="15" MaxSeconds="7200" />
                        <DurationInput Seconds="iv.RestMin * 60" SecondsChanged="async v => { iv.RestMin = (v ?? 0) / 60; await Apply(); }" Label="Rest" MaxSeconds="3600" />
                        <MudNumericField T="int" @bind-Value="iv.Rounds" @bind-Value:after="Apply" Label="Rounds" Min="0" Max="99" HelperText="0 = endless" />
                    </div>
                    <MudCheckBox T="bool" @bind-Value="iv.VoiceCues" @bind-Value:after="Apply" Color="Color.Primary" Label="Audio cues (3-2-1 pips before each change)" />
                    <MudText Typo="Typo.caption" Class="muted d-block mt-2">
                        Total active time: @Stats.Duration((int)(iv.WorkMin * 60 * Math.Max(1, iv.Rounds)))@(iv.Rounds == 0 ? " per round" : "")
                    </MudText>
            }
            else
            {
                    var s = Metro.Settings;
                    @if (Metro.Source == MetronomeSource.Free)
                    {
                        var fs = Metro.Sections[0];
                        <div class="d-flex gap-3 flex-wrap mb-3">
                            <MudNumericField T="int" @bind-Value="fs.BeatsPerBar" @bind-Value:after="Apply" Label="Beats per bar" Min="1" Max="32" Style="max-width:120px" />
                            <MudSelect T="int" @bind-Value="fs.BeatUnit" @bind-Value:after="Apply" Label="Beat unit" Style="max-width:100px">
                                @foreach (var bu in new[] { 2, 4, 8, 16 }) { <MudSelectItem T="int" Value="bu">/@bu</MudSelectItem> }
                            </MudSelect>
                            <MudSelect T="int" @bind-Value="fs.Subdivision" @bind-Value:after="Apply" Label="Clicks" Style="max-width:140px">
                                <MudSelectItem T="int" Value="1">Beats</MudSelectItem>
                                <MudSelectItem T="int" Value="2">8ths</MudSelectItem>
                                <MudSelectItem T="int" Value="3">Triplets</MudSelectItem>
                                <MudSelectItem T="int" Value="4">16ths</MudSelectItem>
                                <MudSelectItem T="int" Value="6">Sextuplets</MudSelectItem>
                            </MudSelect>
                        </div>
                    }
                    <MudSelect T="int" @bind-Value="s.CountInBars" @bind-Value:after="Apply" Label="Count-in length" Style="max-width:200px" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.HourglassTop"
                               AdornmentColor="@(s.CountIn ? Color.Primary : Color.Default)" AdornmentAriaLabel="@($"Count-in {OnOff(s.CountIn).ToLower()}")">
                        <MudSelectItem T="int" Value="1">1 bar</MudSelectItem>
                        <MudSelectItem T="int" Value="2">2 bars</MudSelectItem>
                    </MudSelect>
                    <MudSelect T="string" @bind-Value="s.Sound" @bind-Value:after="SoundChanged" Label="Click sound" Class="mt-3" Style="max-width:200px">
                        <MudSelectItem T="string" Value="@("click")">Click</MudSelectItem>
                        <MudSelectItem T="string" Value="@("wood")">Woodblock</MudSelectItem>
                        <MudSelectItem T="string" Value="@("beep")">Beep</MudSelectItem>
                    </MudSelect>
                    <MudText Typo="Typo.body2" Class="mt-4">Volume</MudText>
                    <MudSlider T="double" @bind-Value="s.Volume" @bind-Value:after="Apply" Min="0" Max="1.5" Step="0.05" Color="Color.Primary" aria-label="Volume" />
                    <MudSwitch T="bool" @bind-Value="s.AccentFirst" @bind-Value:after="Apply" Color="Color.Primary" Label="Accent the first beat of the bar" />
                    <MudSwitch T="bool" @bind-Value="s.Flash" @bind-Value:after="Apply" Color="Color.Primary" Label="Visual flash on each beat" />
            }
            </div>
        </section>
    </MudItem>
</MudGrid>

@if (Metro.Source == MetronomeSource.Item && Metro.Item is { ScoreFileId: not null } scoreItem)
{
    <div class="mt-4">
        <TabView Item="scoreItem" Part="Metro.PlayingSection" Dark="Store.Settings.DarkMode" />
    </div>
}

@code {
    [Parameter] public string? ItemId { get; set; }
    [Parameter] public string? SectionId { get; set; }
    [Parameter] public string? PresetId { get; set; }
    string _panel = "trainer";

    int CurStep => Metro.IsRunning ? Metro.State.step : Metro.CurrentStep;
    string SectionLabel(int i) => i >= 0 && i < Metro.Sections.Count ? $"{i + 1}. {Metro.Sections[i].Name}" : "";
    static string ToggleClass(bool on) => on ? "opt-toggle on" : "opt-toggle";
    static string Pressed(bool on) => on ? "true" : "false";
    static string DotClass(bool on) => on ? "seg-dot on" : "seg-dot";
    static string OnOff(bool on) => on ? "On" : "Off";

    double Factor => Metro.IsRunning ? Metro.State.factor : Metro.Factor;

    string SourceLabel => Metro.Source switch
    {
        MetronomeSource.Item => Metro.Item?.Type.Label() ?? "",
        MetronomeSource.Preset => "Custom",
        _ => "Free"
    };

    string SessionRange
    {
        get
        {
            if (Metro.SessionMax is null) return "—";
            var suf = Metro.Unit == TempoUnit.Percent ? "%" : "";
            var lo = Math.Round(Metro.SessionMin ?? 0); var hi = Math.Round(Metro.SessionMax.Value);
            return lo < hi ? $"{lo:0}–{hi:0}{suf}" : $"{hi:0}{suf}";
        }
    }

    string? TrainingNextText
    {
        get
        {
            var n = Metro.IsRunning ? Metro.State.trainingNext : null;
            if (n is null) return null;
            var tr = Metro.Training; var u = Metro.Unit == TempoUnit.Percent ? "%" : "";
            var dir = tr.End >= tr.Start ? "+" : "−";
            var step = tr.Mode == RampMode.EveryNBars ? $"{dir}{Math.Abs(tr.Increment):0.#}{u}" : $"{dir}1{u}";
            string when = n.bars is int b && b > 1 ? $"{b} bars"
                        : n.beats is int bt ? $"{bt} beat{(bt == 1 ? "" : "s")}"
                        : Stats.Clock(Math.Ceiling(n.sec ?? 0));
            return $"Next {step} in {when}";
        }
    }

    string TrainerSummary
    {
        get
        {
            var tr = Metro.Training; var u = Metro.Unit == TempoUnit.Percent ? "%" : " bpm";
            if (tr.Mode == RampMode.OverTime)
                return $"From {tr.Start:0} to {tr.End:0}{u} over {tr.DurationMin:0.#} min of playing, then {(tr.StopAtEnd ? "stop" : "hold")}.";
            var steps = Math.Ceiling(Math.Abs(tr.End - tr.Start) / Math.Max(0.5, tr.Increment));
            var beats = steps * tr.EveryBars * Metro.RefSection.BeatsPerBar;
            var avgBpm = Metro.Unit == TempoUnit.Percent ? Metro.RefSection.Bpm * (tr.Start + tr.End) / 200 : (tr.Start + tr.End) / 2;
            return $"{tr.Increment:0.#}{u} every {tr.EveryBars} bars · ≈{Stats.Clock(beats * 60 / Math.Max(20, avgBpm))} to reach {tr.End:0}{u}.";
        }
    }

    static string SubName(int s) => s switch { 1 => "beats", 2 => "8ths", 3 => "triplets", 4 => "16ths", 6 => "sextuplets", _ => $"{s}/beat" };

    protected override async Task OnParametersSetAsync()
    {
        if (ItemId != null)
        {
            var item = Store.GetItem(ItemId);
            if (item == null) { Nav.NavigateTo("metronome"); return; }
            await Metro.LoadItemAsync(item, SectionId);
        }
        else if (PresetId != null)
        {
            var p = Store.Presets.FirstOrDefault(x => x.Id == PresetId);
            if (p == null) { Nav.NavigateTo("metronome"); return; }
            if (Metro.Preset?.Id != p.Id || Metro.Source != MetronomeSource.Preset) await Metro.LoadPresetAsync(p);
        }
        else if (Nav.Uri.EndsWith("/metronome/free")) await Metro.LoadFreeAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        Metro.Changed += OnChanged;
        // coming back from the practice timer: turn the click back on
        if (!Metro.IsRunning && Metro.Silent) await Metro.SetSilentAsync(false);
    }
    void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Metro.Changed -= OnChanged;

    Task Apply() => Metro.ApplyAsync();

    async Task SoundChanged() { await Metro.ApplyAsync(); await Metro.PreviewSoundAsync(); }

    async Task Toggle(Action a) { a(); await Metro.ApplyAsync(); }

    async Task SetInterval(double work, double rest, int rounds)
    {
        var iv = Metro.Settings.Interval;
        iv.WorkMin = work; iv.RestMin = rest; iv.Rounds = rounds; iv.Enabled = true;
        await Metro.ApplyAsync();
    }

    async Task LogSession()
    {
        await Metro.StopAsync();
        var log = Metro.BuildSessionLog();
        if (await LogDialog.ShowAsync(Dialogs, log, isNew: true))
        {
            Metro.ResetSession();
            Snackbar.Add("Session logged", Severity.Success);
        }
    }

    async Task SavePreset()
    {
        if (Metro.Source == MetronomeSource.Preset && Metro.Preset is { } p)
        {
            p.Sections = Metro.Sections.Select(s => s.Clone()).ToList();
            p.PlayThrough = Metro.PlayThrough;
            await Store.SavePresetAsync(p);
            Snackbar.Add($"Saved “{p.Name}”", Severity.Success);
            return;
        }
        var name = await PromptDialog.ShowAsync(Dialogs, "Save custom metronome", "Name", "My metronome");
        if (name == null) return;
        var preset = Metro.ToPreset(name);
        await Store.SavePresetAsync(preset);
        Snackbar.Add($"Saved “{name}”", Severity.Success);
        Nav.NavigateTo($"metronome/preset/{preset.Id}");
    }

    async Task DeletePreset()
    {
        if (Metro.Preset is not { } p) return;
        var ok = await Dialogs.ShowMessageBoxAsync("Delete custom metronome?", $"“{p.Name}” will be removed.", "Delete", cancelText: "Cancel");
        if (ok != true) return;
        await Store.DeletePresetAsync(p);
        Nav.NavigateTo("metronome/free");
    }

    async Task EditPresetSections()
    {
        var r = await SectionsDialog.ShowAsync(Dialogs, Metro.Sections, Metro.PlayThrough, Metro.Loop);
        if (r == null) return;
        await Metro.ReplaceSectionsAsync(r.Sections, r.PlayThrough, r.Loop);
    }
}
