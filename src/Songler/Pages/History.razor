@page "/history"
@implements IDisposable
@inject DataStore Store
@inject IDialogService Dialogs

<PageTitle>History · Songler</PageTitle>

<div class="page-head">
    <div>
        <h1 class="page-title" tabindex="-1">History</h1>
        <MudText Typo="Typo.body2" Class="muted">@_logs.Count entries · @Stats.Duration(_logs.Sum(l => l.DurationSec ?? 0)) logged</MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.AddTask" OnClick="Add">Log practice</MudButton>
</div>

<div class="toolbar">
    <MudSelect T="string" @bind-Value="_item" @bind-Value:after="Refresh" Label="Item" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:240px">
        @foreach (var i in Store.Items) { <MudSelectItem T="string" Value="@i.Id">@i.Name</MudSelectItem> }
    </MudSelect>
    <MudSelect T="int" @bind-Value="_range" @bind-Value:after="Refresh" Label="Period" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:180px">
        <MudSelectItem T="int" Value="7">Last 7 days</MudSelectItem>
        <MudSelectItem T="int" Value="30">Last 30 days</MudSelectItem>
        <MudSelectItem T="int" Value="90">Last 90 days</MudSelectItem>
        <MudSelectItem T="int" Value="0">All time</MudSelectItem>
    </MudSelect>
    <MudTextField @bind-Value="_search" @bind-Value:after="Refresh" Placeholder="Search notes" Immediate="true" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Search" aria-label="Search notes" />
</div>

<section class="card">
    @* key forces paging reset when filters change *@
    <LogTable @key="_version" Logs="_logs" ShowItem="true" PageSize="60" />
</section>

@code {
    string? _item, _search;
    int _range;
    int _version;
    List<PracticeLog> _logs = new();

    protected override void OnInitialized() { Store.Changed += OnChanged; Refresh(); }
    void OnChanged() { Refresh(); InvokeAsync(StateHasChanged); }

    void Refresh()
    {
        IEnumerable<PracticeLog> q = Store.Logs;
        if (_item != null) q = q.Where(l => l.ItemId == _item);
        if (_range > 0) q = q.Where(l => l.Date > DateTime.Today.AddDays(-_range));
        if (!string.IsNullOrWhiteSpace(_search)) q = q.Where(l => (l.Notes ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase) || l.ItemName.Contains(_search, StringComparison.OrdinalIgnoreCase));
        _logs = q.OrderByDescending(l => l.Date).ThenBy(l => l.ItemName).ToList();
        _version++;
    }

    async Task Add()
    {
        var item = Store.GetItem(_item);
        await LogDialog.ShowAsync(Dialogs, new PracticeLog { ItemId = item?.Id, ItemName = item?.Name ?? "", Unit = item?.Unit ?? TempoUnit.Bpm }, true);
    }

    public void Dispose() => Store.Changed -= OnChanged;
}
