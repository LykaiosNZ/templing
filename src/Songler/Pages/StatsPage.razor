@page "/stats"
@implements IDisposable
@inject DataStore Store

<PageTitle>Stats · Songler</PageTitle>

<div class="page-head">
    <div>
        <h1 class="page-title" tabindex="-1">Stats</h1>
        <MudText Typo="Typo.body2" Class="muted">Time counts active practice only (rests excluded). Early entries without a time still count as practice days.</MudText>
    </div>
    <MudToggleGroup T="int" @bind-Value="_period" @bind-Value:after="Refresh" Color="Color.Primary" Size="Size.Small" Outlined="true" aria-label="Period">
        <MudToggleItem Value="30" Text="30 days" />
        <MudToggleItem Value="90" Text="90 days" />
        <MudToggleItem Value="365" Text="Year" />
        <MudToggleItem Value="0" Text="All" />
    </MudToggleGroup>
</div>

<div class="tiles">
    <StatTile Label="Practice time" Value="@Stats.Duration(_totalSec)" Icon="@Icons.Material.Rounded.Timer" Sub="@($"{_timedDays} timed days")" />
    <StatTile Label="Days practised" Value="@_days.ToString()" Icon="@Icons.Material.Rounded.CalendarMonth" Sub="@(_spanDays > 0 ? $"{(double)_days / _spanDays:P0} of days" : null)" />
    <StatTile Label="Avg per day" Value="@Stats.Duration(_timedDays > 0 ? _totalSec / _timedDays : 0)" Icon="@Icons.Material.Rounded.AvTimer" Sub="on days with time logged" />
    <StatTile Label="Items practised" Value="@_itemCount.ToString()" Icon="@Icons.Material.Rounded.LibraryMusic" Sub="@($"{_logs.Count} entries")" />
    <StatTile Label="Longest streak" Value="@_streak.longest.ToString()" Unit=" days" Icon="@Icons.Material.Rounded.LocalFireDepartment" Sub="@($"Current {_streak.current}")" />
</div>

<MudGrid Spacing="4" Class="mt-1">
    <MudItem xs="12">
        <section class="card">
            <h2 class="card-title">Last 12 months</h2>
            <Heatmap SecondsByDay="_byDayAll" Practiced="_practicedAll" Weeks="53" />
        </section>
    </MudItem>
    <MudItem xs="12" lg="8">
        <section class="card">
            <h2 class="card-title">Minutes per week</h2>
            <BarChart Labels="_weekLabels" TipLabels="_weekTips" Values="_weekValues" ValueFormat="@(v => Stats.Duration((int)(v * 60)))" AxisFormat="@(v => $"{v:0}m")"
                      HighlightLast="true" LabelEvery="@Math.Max(1, _weekValues.Count / 8)" AriaLabel="Minutes per week" />
        </section>
    </MudItem>
    <MudItem xs="12" lg="4">
        <section class="card">
            <h2 class="card-title">By day of week</h2>
            <BarChart Labels="_dowLabels" Values="_dowValues" ValueFormat="@(v => $"{v:0} days")" AriaLabel="Practice days by weekday" Height="260" Width="400" />
        </section>
    </MudItem>
    <MudItem xs="12" md="6" lg="4">
        <section class="card">
            <h2 class="card-title">Time by item</h2>
            <HBars Rows="_byItem" AriaLabel="Practice time by item" />
        </section>
    </MudItem>
    <MudItem xs="12" md="6" lg="4">
        <section class="card">
            <h2 class="card-title">Biggest gains</h2>
            <MudText Typo="Typo.caption" Class="muted d-block mb-2">First recorded tempo → best in this period</MudText>
            <HBars Rows="_gains" AriaLabel="Tempo improvement by item" />
        </section>
    </MudItem>
    <MudItem xs="12" md="6" lg="4">
        <section class="card">
            <h2 class="card-title">Goal progress</h2>
            <HBars Rows="_progress" Max="1" AriaLabel="Progress toward goal by item" />
        </section>
        <section class="card mt-4">
            <h2 class="card-title">By type</h2>
            <HBars Rows="_byType" AriaLabel="Practice time by type" />
        </section>
    </MudItem>
</MudGrid>

@code {
    int _period = 90;
    List<PracticeLog> _logs = new();
    int _totalSec, _days, _timedDays, _itemCount, _spanDays;
    (int current, int longest) _streak;
    Dictionary<DateTime, int> _byDayAll = new();
    HashSet<DateTime> _practicedAll = new();
    List<string> _weekLabels = new(), _weekTips = new(), _dowLabels = new();
    List<double> _weekValues = new(), _dowValues = new();
    List<HBars.Row> _byItem = new(), _gains = new(), _progress = new(), _byType = new();

    protected override void OnInitialized() { Store.Changed += OnChanged; Refresh(); }
    void OnChanged() { Refresh(); InvokeAsync(StateHasChanged); }

    void Refresh()
    {
        var today = DateTime.Today;
        var from = _period > 0 ? today.AddDays(-_period + 1) : (Store.Logs.Count > 0 ? Store.Logs.Min(l => l.Date) : today);
        _spanDays = (int)(today - from.Date).TotalDays + 1;
        _logs = Store.Logs.Where(l => l.Date >= from).ToList();
        _totalSec = _logs.Sum(l => l.DurationSec ?? 0);
        var days = Stats.DaysPracticed(_logs);
        _days = days.Count;
        _timedDays = _logs.Where(l => l.DurationSec > 0).Select(l => l.Date.Date).Distinct().Count();
        _itemCount = _logs.Select(l => l.ItemName).Distinct().Count();
        _streak = Stats.Streaks(Store.Logs, today);
        _byDayAll = Stats.SecondsByDay(Store.Logs);
        _practicedAll = Stats.DaysPracticed(Store.Logs);

        var weeks = Stats.WeeklySeconds(_logs, today, Math.Clamp((int)Math.Ceiling(_spanDays / 7.0), 4, 104));
        _weekLabels = Stats.WeekLabels(weeks);
        _weekTips = Stats.WeekTips(weeks);
        _weekValues = weeks.Select(w => w.sec / 60.0).ToList();

        var order = new[] { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday };
        _dowLabels = order.Select(d => d.ToString()[..3]).ToList();
        _dowValues = order.Select(d => (double)days.Count(x => x.DayOfWeek == d)).ToList();

        _byItem = _logs.GroupBy(l => (l.ItemId, l.ItemName))
            .Select(g => (g.Key, sec: g.Sum(l => l.DurationSec ?? 0)))
            .Where(x => x.sec > 0).OrderByDescending(x => x.sec).Take(12)
            .Select(x => new HBars.Row(x.Key.ItemName, x.sec, Stats.Duration(x.sec), x.Key.ItemId != null ? $"library/{x.Key.ItemId}" : null)).ToList();

        _byType = _logs.GroupBy(l => Store.GetItem(l.ItemId)?.Type.Label() ?? "Free practice")
            .Select(g => (g.Key, sec: g.Sum(l => l.DurationSec ?? 0))).Where(x => x.sec > 0).OrderByDescending(x => x.sec)
            .Select(x => new HBars.Row(x.Key, x.sec, Stats.Duration(x.sec))).ToList();

        _gains = new();
        _progress = new();
        foreach (var item in Store.Items)
        {
            var pts = _logs.Where(l => l.ItemId == item.Id && l.Unit == item.Unit && l.Value.HasValue).OrderBy(l => l.Date).ToList();
            if (pts.Count >= 2)
            {
                var first = pts[0].Value!.Value; var best = pts.Max(p => p.Value!.Value);
                var gain = best - first;
                if (gain > 0) _gains.Add(new HBars.Row(item.Name, first > 0 ? gain / first : 0, $"{first:0} → {best:0}{item.Unit.Suffix()} (+{(first > 0 ? gain / first : 0):P0})", $"library/{item.Id}"));
            }
            var st = Stats.ForItem(item, Store.Logs);
            if (!item.Archived && st.Progress is { } p && st.LastDate >= from)
                _progress.Add(new HBars.Row(item.Name, Math.Min(1, p), $"{p:P0}", $"library/{item.Id}", p >= 1 ? "var(--good)" : null));
        }
        _gains = _gains.OrderByDescending(g => g.Value).Take(10).ToList();
        _progress = _progress.OrderByDescending(g => g.Value).ToList();
    }

    public void Dispose() => Store.Changed -= OnChanged;
}
