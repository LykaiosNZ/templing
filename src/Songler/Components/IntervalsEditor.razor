@* Work / rest interval settings, shared by the Metronome (its Intervals section) and the Timer (its Countdown). *@
@inject MetronomeService Metro

@if (Metro.StepPinned)
{
    <MudAlert Severity="Severity.Info" Dense="true">Your plan sets the intervals for this step. Changes here apply after the plan.</MudAlert>
}
@{ var iv = Settings; }
@* an action, not a value: it always reads "Load preset" and fills in the fields below *@
<MudSelect T="int?" Value="null" ValueChanged="Load" Label="Load preset" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
    @for (int i = 0; i < Presets.Count; i++)
    {
        var idx = i;
        var label = Label(Presets[i]);
        <MudSelectItem T="int?" Value="idx">@label</MudSelectItem>
    }
</MudSelect>
<div class="form-grid three">
    <DurationInput Seconds="iv.WorkMin * 60" SecondsChanged="async v => { iv.WorkMin = (v ?? 15) / 60; await Apply(); }" Label="Work" MinSeconds="15" MaxSeconds="7200" Variant="Variant.Outlined" Margin="Margin.Dense" />
    <DurationInput Seconds="iv.RestMin * 60" SecondsChanged="async v => { iv.RestMin = (v ?? 0) / 60; await Apply(); }" Label="Rest" MaxSeconds="3600" Variant="Variant.Outlined" Margin="Margin.Dense" />
    <MudNumericField T="int" @bind-Value="iv.Rounds" @bind-Value:after="Apply" Label="Rounds" Min="0" Max="99" HelperText="0 = endless" Variant="Variant.Outlined" Margin="Margin.Dense" />
</div>
<MudSwitch T="bool" @bind-Value="iv.VoiceCues" @bind-Value:after="Apply" Color="Color.Primary" Label="Audio cues" Class="rail-line-switch" />

@code {
    public record Preset(double Work, double Rest, int Rounds);

    public static readonly Preset[] MetronomePresets =
    {
        new(10, 0, 1), new(15, 0, 1), new(5, 1, 2), new(10, 2, 3), new(2, 0.5, 4), new(0.5, 0.25, 8),
    };

    public static readonly Preset[] TimerPresets =
    {
        new(5, 0, 1), new(10, 0, 1), new(15, 0, 1), new(20, 0, 1), new(10, 2, 3), new(2, 0.5, 4),
    };

    [Parameter, EditorRequired] public IntervalSettings Settings { get; set; } = default!;
    [Parameter] public IReadOnlyList<Preset> Presets { get; set; } = MetronomePresets;

    static string Label(Preset p)
    {
        static string D(double min) => min < 1 ? $"{min * 60:0} sec" : $"{min:0.#} min";
        var work = p.Rounds == 1 ? D(p.Work) : $"{p.Rounds} × {D(p.Work)}";
        return p.Rest > 0 && p.Rounds != 1 ? $"{work} · {D(p.Rest)} rest" : work;
    }

    async Task Load(int? i)
    {
        if (i is not { } idx || idx < 0 || idx >= Presets.Count) return;
        var p = Presets[idx];
        var iv = Settings;
        iv.WorkMin = p.Work; iv.RestMin = p.Rest; iv.Rounds = p.Rounds;
        await Apply();
    }

    Task Apply() => Metro.ApplyAsync();
}
