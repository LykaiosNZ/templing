@implements IDisposable
@inject MetronomeService Metro
@inject NavigationManager Nav

<div class="mini-player @(Metro.IsRunning ? "running" : "")" role="group" aria-label="Metronome">
    <MudIconButton Size="Size.Small" Icon="@(Metro.IsRunning ? Icons.Material.Rounded.Stop : Icons.Material.Rounded.PlayArrow)"
                   Color="Color.Primary" Variant="Variant.Filled" aria-label="@(Metro.IsRunning ? "Stop metronome" : "Start metronome")"
                   OnClick="() => Metro.ToggleAsync()" />
    <a href="@Href" class="mini-info" aria-label="Open metronome">
        <span class="mini-title">@Metro.Title</span>
        <span class="mini-tempo">
            @Metro.Value.ToString("0")@(Metro.Unit == TempoUnit.Percent ? "%" : "")
            <span class="muted">@(Metro.Unit == TempoUnit.Percent ? $"· {Metro.PlayingBpm:0} bpm" : "bpm")</span>
            @if (Metro.IsRunning && Metro.State.phase == "rest")
            {
                <span class="phase rest">rest @Stats.Clock(Metro.State.remaining ?? 0)</span>
            }
            else if (Metro.SessionActiveSec > 1)
            {
                <span class="muted">· @Stats.Clock(Metro.SessionActiveSec)</span>
            }
        </span>
    </a>
</div>

@code {
    string Href => Metro.Source switch
    {
        MetronomeSource.Item => $"metronome/item/{Metro.Item?.Id}",
        MetronomeSource.Preset => $"metronome/preset/{Metro.Preset?.Id}",
        _ => "metronome"
    };

    protected override void OnInitialized() => Metro.Changed += OnChanged;
    void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Metro.Changed -= OnChanged;
}
