@* One-line summary of a section: number, name, then tempo · meter · division · length ("16 bars", "loop", "from the score").
   Used by the sections editor's collapsed rows. *@

<span class="pl-num">@(Index + 1).</span>
@if (Section.FromScore)
{
    <MudIcon Icon="@Icons.Material.Rounded.QueueMusic" Class="pl-icon" title="From the score" aria-label="From the score" />
}
<span class="pl-name">@(string.IsNullOrWhiteSpace(Section.Name) ? "Untitled" : Section.Name)</span>
<span class="pl-meta">@Section.Bpm.ToString("0") bpm · @Section.Meter · <DivisionIcon Subdivision="Section.Subdivision" BeatUnit="Section.BeatUnit" /> · @Length(Section)</span>

@code {
    [Parameter, EditorRequired] public Section Section { get; set; } = default!;
    [Parameter] public int Index { get; set; }

    static string Length(Section s) => s.Length > 0 ? $"{s.Length} bar{(s.Length == 1 ? "" : "s")}" : "loop";
}
