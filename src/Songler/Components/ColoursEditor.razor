@* Settings > Colours: one row per colour slot (ThemeColours.Slots) for the mode in use; changes apply as you pick.
   The mode toggle switches the app itself, so what you edit is what you see. *@
@using Songler.Layout
@using MudBlazor.Utilities
@inject DataStore Store
@inject IDialogService Dialogs
@implements IDisposable

<div class="setting-row">
    <div class="setting-text"><div class="setting-title">Mode</div></div>
    <div class="setting-control">
        <MudToggleGroup T="bool" Value="Dark" ValueChanged="SetDark" Color="Color.Primary" Size="Size.Small" Outlined="true" CheckMark="false" Class="mode-toggle" aria-label="Mode">
            <MudToggleItem Value="false" Text="Light" />
            <MudToggleItem Value="true" Text="Dark" />
        </MudToggleGroup>
    </div>
</div>
@foreach (var slot in ThemeColours.Slots)
{
    var key = slot.Key;
    var label = slot.Label;
    var value = ThemeColours.Get(Store.Settings.Colours, key, Dark);
    var custom = ThemeColours.IsCustom(Store.Settings.Colours, key, Dark);
    <div class="setting-row">
        <div class="setting-text">
            <div class="setting-title">@label</div>
        </div>
        <div class="setting-control colour-control">
            @if (custom)
            {
                <MudTooltip Text="Use the built-in colour">
                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Rounded.Undo" aria-label="@($"Use the built-in {label.ToLowerInvariant()} colour")" OnClick="() => Reset(key)" />
                </MudTooltip>
            }
            <span class="colour-swatch" style="background:@value" aria-hidden="true"></span>
            <MudColorPicker Value="new MudColor(value)" ValueChanged="c => Set(key, c)" ShowAlpha="false" Palette="ThemeColours.Palette(key, Dark)"
                            ThrottleInterval="120" Variant="Variant.Outlined" Margin="Margin.Dense" Class="colour-picker"
                            aria-label="@label" />
        </div>
    </div>
}
@if (ThemeColours.AnyCustom(Store.Settings.Colours))
{
    <div class="setting-row">
        <div class="setting-text"><div class="setting-title">Built-in colours</div></div>
        <div class="setting-control">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.Restore" OnClick="ResetAll">Reset…</MudButton>
        </div>
    </div>
}

@code {
    bool Dark => Store.Settings.DarkMode;

    // the app bar's light/dark button changes the mode too
    protected override void OnInitialized() => Store.Changed += OnChanged;
    void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Store.Changed -= OnChanged;

    async Task SetDark(bool dark)
    {
        Store.Settings.DarkMode = dark;
        await Store.SaveSettingsAsync();
    }

    async Task Set(string key, MudColor colour)
    {
        var hex = colour.ToString(MudColorOutputFormats.Hex).ToLowerInvariant();
        var slot = ThemeColours.Slots.First(s => s.Key == key);
        var map = (Store.Settings.Colours ??= new CustomColours()).For(Dark);
        // picking the built-in colour again is the same as resetting it
        if (string.Equals(hex, Dark ? slot.Dark : slot.Light, StringComparison.OrdinalIgnoreCase)) map.Remove(key);
        else if (map.TryGetValue(key, out var old) && old == hex) return;
        else map[key] = hex;
        await Save();
    }

    async Task Reset(string key)
    {
        Store.Settings.Colours?.For(Dark).Remove(key);
        await Save();
    }

    async Task ResetAll()
    {
        if (await ConfirmDialog.ShowAsync(Dialogs, "Reset colours?", "Light and dark mode go back to the built-in colours.", "Reset") != true) return;
        Store.Settings.Colours = null;
        await Store.SaveSettingsAsync();
    }

    Task Save()
    {
        if (Store.Settings.Colours is { Light.Count: 0, Dark.Count: 0 }) Store.Settings.Colours = null;
        return Store.SaveSettingsAsync();
    }
}
