@inject DataStore Store
@inject IDialogService Dialogs

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsNew ? "Add to library" : $"Edit {Item.Name}")</MudText>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-column gap-4">
            @* the error shows once the name has been typed and cleared, or Save was pressed; not on open or when focus moves *@
            <MudTextField T="string" Value="_m.Name" ValueChanged="v => { _m.Name = v; _nameTouched = true; }" Label="Name" AutoFocus="true" Immediate="true"
                          Error="@(_nameTouched && string.IsNullOrWhiteSpace(_m.Name))" ErrorText="Enter a name" />
            <div>
                <MudText Typo="Typo.subtitle2" Class="mb-1">Type</MudText>
                <MudToggleGroup T="ItemType" Value="_m.Type" ValueChanged="TypeChanged" Color="Color.Primary" Size="Size.Small" Outlined="true" CheckMark="false" aria-label="Type">
                    @foreach (var t in ItemTypeExt.Ordered)
                    {
                        <MudToggleItem Value="t">
                            <span class="d-inline-flex align-center gap-1"><MudIcon Icon="@t.Icon()" Size="Size.Small" />@t.Label()</span>
                        </MudToggleItem>
                    }
                </MudToggleGroup>
            </div>
            <div class="d-flex gap-4 align-end flex-wrap">
                <div>
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Measure progress in</MudText>
                    <MudToggleGroup T="TempoUnit" @bind-Value="_m.Unit" Color="Color.Primary" Size="Size.Small" Outlined="true" CheckMark="true" Style="width:320px">
                        <MudToggleItem Value="TempoUnit.Bpm" Text="BPM" />
                        <MudToggleItem Value="TempoUnit.Percent" Text="% of full tempo" />
                    </MudToggleGroup>
                </div>
                <MudNumericField T="double?" @bind-Value="_m.Goal" Label="@($"Goal ({(_m.Unit == TempoUnit.Percent ? "%" : "bpm")})")" Min="1" Max="400" Style="max-width:160px" />
            </div>
            <div>
                <div class="d-flex align-center gap-2 mb-2 flex-wrap">
                    <MudText Typo="Typo.subtitle2">Sections</MudText>
                    <MudSpacer />
                    @if (_m.ScoreFileName != null)
                    {
                        <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Rounded.MusicNote" OnClose="DetachScore">@_m.ScoreFileName</MudChip>
                    }
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.QueueMusic" OnClick="ImportScore">
                        @(_m.ScoreFileId == null ? ScoreImportDialog.Title + "…" : "Re-import from score file…")
                    </MudButton>
                </div>
                @if (_m.Type == ItemType.Song)
                {
                    <div class="d-flex flex-wrap gap-1 mb-2 align-center" role="group" aria-label="Add a section">
                        @foreach (var part in ItemTypeExt.SongParts)
                        {
                            var name = part;
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Rounded.Add" OnClick="() => AddPart(name)">@name</MudChip>
                        }
                    </div>
                }
                <SectionsEditor Sections="_m.Sections" BpmLabel="@(_m.Unit == TempoUnit.Percent ? "Full BPM" : "BPM")" OnChanged="StateHasChanged" />
            </div>
            <MudTextField @bind-Value="_m.Link" Label="Link" />
            <MudTextField @bind-Value="_m.Notes" Label="Notes" Lines="2" Sizing="InputSizing.Auto" MaxLines="8" />
            @if (!IsNew)
            {
                <MudSwitch T="bool" @bind-Value="_m.Archived" Color="Color.Primary" Label="Archived" />
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="string.IsNullOrWhiteSpace(_m.Name)" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public PracticeItem Item { get; set; } = new();
    [Parameter] public bool IsNew { get; set; }
    PracticeItem _m = new();
    bool _nameTouched;

    public static async Task<PracticeItem?> ShowAsync(IDialogService dialogs, PracticeItem? item = null)
    {
        var p = new DialogParameters<ItemDialog> { { x => x.Item, item ?? new PracticeItem() }, { x => x.IsNew, item == null } };
        var r = await dialogs.ShowAsync<ItemDialog>(item == null ? "Add piece" : "Edit piece", p,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true, Position = DialogPosition.TopCenter });
        var res = await r.Result;
        return res is { Canceled: false } ? res.Data as PracticeItem : null;
    }

    protected override void OnInitialized()
    {
        // edit a copy so Cancel discards changes
        _m = System.Text.Json.JsonSerializer.Deserialize<PracticeItem>(System.Text.Json.JsonSerializer.Serialize(Item, DataStore.Json), DataStore.Json)!;
    }

    void TypeChanged(ItemType t)
    {
        var was = _m.Type;
        _m.Type = t;
        // sensible defaults when creating: songs are measured as % of the real tempo
        if (IsNew && t == ItemType.Song && was != ItemType.Song)
        {
            _m.Unit = TempoUnit.Percent;
            _m.Goal ??= 100;
        }
    }

    void AddPart(string name)
    {
        var last = _m.Sections.LastOrDefault();
        // replace the untouched default section rather than leaving "Main" lying around
        if (_m.Sections.Count == 1 && last is { Name: "Main" } && IsNew) { last.Name = Unique(name); return; }
        _m.Sections.Add(new Section
        {
            Name = Unique(name), Bpm = last?.Bpm ?? 120, BeatsPerBar = last?.BeatsPerBar ?? 4,
            BeatUnit = last?.BeatUnit ?? 4, Subdivision = last?.Subdivision ?? 1, Bars = last?.Bars ?? 0
        });
    }

    string Unique(string name)
    {
        if (!_m.Sections.Any(s => s.Name == name)) return name;
        for (int i = 2; ; i++) if (!_m.Sections.Any(s => s.Name == $"{name} {i}")) return $"{name} {i}";
    }

    async Task ImportScore()
    {
        // only warn about replacing sections when there's something real to replace
        var replacing = !IsNew || _m.ScoreFileId != null || _m.Sections.Count > 1 || _m.Sections.FirstOrDefault()?.Name != "Main";
        var r = await ScoreImportDialog.ShowAsync(Dialogs, forExisting: true, replacing: replacing);
        if (r == null) return;
        _m.Sections = r.Sections;
        _m.ScoreFileId = r.FileId;
        _m.ScoreFileName = r.FileName;
        _m.ScoreTrack = r.Track;
        if (IsNew)
        {
            if (string.IsNullOrWhiteSpace(_m.Name)) _m.Name = r.Name;
            _m.Type = ItemType.Song; _m.Unit = TempoUnit.Percent; _m.Goal ??= 100;
        }
    }

    void DetachScore()
    {
        _m.ScoreFileId = null; _m.ScoreFileName = null;
        foreach (var s in _m.Sections) { s.Bars = s.Length; s.ScoreBars = null; }
    }

    async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_m.Name)) { _nameTouched = true; return; }
        _m.Name = _m.Name.Trim();
        if (_m.Sections.Count == 0) _m.Sections.Add(new Section());
        await Store.SaveItemAsync(_m);
        Dialog.Close(DialogResult.Ok(_m));
    }
}
