@* Tempo over time on MudChart's time-series line: each day's top tempo, plus the goal as a faint flat line. *@
@using MudBlazor.Charts
@inject DataStore Store

<div class="viz" role="img" aria-label="@AriaLabel">
    @if (Points.Count == 0)
    {
        <div class="viz-empty">No tempo data yet</div>
    }
    else
    {
        <MudChart T="double" ChartType="ChartType.Timeseries" ChartSeries="_series" ChartOptions="_options"
                  Width="100%" Height="@($"{Height}px")" MatchBoundsToSize="true" />
    }
</div>

@code {
    [Parameter] public List<TempoPoint> Points { get; set; } = new();
    [Parameter] public double? Goal { get; set; }
    [Parameter] public TempoUnit Unit { get; set; }
    [Parameter] public int Height { get; set; } = 260;
    [Parameter] public string AriaLabel { get; set; } = "Tempo progress chart";

    List<ChartSeries<double>> _series = new();
    TimeSeriesChartOptions _options = new();

    protected override void OnParametersSet()
    {
        if (Points.Count == 0) return;
        var dark = Store.Settings.DarkMode;
        var tempo = new ChartSeries<double>
        {
            Name = "Tempo",
            Data = Points.Select(p => new TimeValue<double>(p.Date, p.Value)).ToArray(),
        };
        _series = [tempo];
        var palette = new List<string> { ChartColors.Series(dark) };
        var overrides = new Dictionary<IChartSeries, SeriesDisplayOverride>();
        if (Goal is { } g)
        {
            var first = Points.Min(p => p.Date); var last = Points.Max(p => p.Date);
            if (last == first) last = first.AddDays(1);
            var goal = new ChartSeries<double> { Name = "Goal", Data = new[] { new TimeValue<double>(first, g), new TimeValue<double>(last, g) } };
            _series.Add(goal);
            palette.Add(ChartColors.Good(dark));
            overrides[goal] = new SeriesDisplayOverride { StrokeOpacity = 0.6 };
        }
        var span = Points.Max(p => p.Date) - Points.Min(p => p.Date);
        var suffix = Unit == TempoUnit.Percent ? "%" : " bpm";
        _options = new TimeSeriesChartOptions
        {
            ShowLegend = false,
            ShowDataMarkers = true,
            LineStrokeWidth = 2,
            ChartPalette = palette.ToArray(),
            SeriesDisplayOverrides = overrides,
            TimeLabelFormat = "d MMM",
            TimeLabelSpacing = TimeSpan.FromDays(Math.Max(1, Math.Ceiling(span.TotalDays / 6))),
            TimeLabelSpacingRounding = true,
            TooltipTimeLabelFormat = "ddd d MMM yyyy",
            YAxisTicks = 0,
            MaxNumYAxisTicks = 6,
            YAxisToStringFunc = v => $"{v:0}{suffix}",
            TooltipTitleFormat = "{{Y_AXIS_VALUE}}",
            TooltipSubtitleFormat = "{{X_VALUE}}",
        };
    }
}
