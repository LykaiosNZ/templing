@* Hover tooltip for the SVG charts. It's HTML on top of the chart (inside a `.viz-plot` wrapper around the svg),
   not SVG, so it stays the same size however wide the chart scales and grows to fit its text.
   Position is given in the chart's viewBox units and converted to percentages. *@

<div class="chart-tip @HAlign @(Below ? "below" : "above")" style="left:@P(X / ViewWidth)%; top:@P(Y / ViewHeight)%" aria-hidden="true">
    @if (!string.IsNullOrEmpty(Label)) { <div class="chart-tip-label">@Label</div> }
    <div class="chart-tip-value">@Value</div>
    @if (!string.IsNullOrEmpty(Note)) { <div class="chart-tip-note">@Note</div> }
</div>

@code {
    /// <summary>Anchor point in viewBox units: the tip sits above it (or below, with <see cref="Below"/>).</summary>
    [Parameter] public double X { get; set; }
    [Parameter] public double Y { get; set; }
    [Parameter] public double ViewWidth { get; set; } = 1;
    [Parameter] public double ViewHeight { get; set; } = 1;
    [Parameter] public bool Below { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string? Note { get; set; }

    // near the edges, hang the tip off the anchor instead of centring it, so it stays inside the chart
    string HAlign => X / ViewWidth < 0.2 ? "start" : X / ViewWidth > 0.8 ? "end" : "center";

    static string P(double frac) => (Math.Clamp(frac, 0, 1) * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}
