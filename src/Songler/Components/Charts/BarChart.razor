@* Single-series column chart on MudChart. Tooltips are MudChart's own, written with the same formatter as the axis. *@
@inject DataStore Store

<div class="viz" role="img" aria-label="@AriaLabel">
    @if (Values.Count == 0 || Values.All(v => v <= 0))
    {
        <div class="viz-empty">No data yet</div>
    }
    else
    {
        <MudChart T="double" ChartType="ChartType.Bar" ChartSeries="_series" ChartLabels="_labels" ChartOptions="_options"
                  Width="100%" Height="@($"{Height}px")" MatchBoundsToSize="true" />
    }
</div>

@code {
    [Parameter] public List<string> Labels { get; set; } = new();
    [Parameter] public List<double> Values { get; set; } = new();
    /// <summary>Values are minutes: the axis steps in round durations and labels read "30 min", "1 hr 30 min".</summary>
    [Parameter] public bool Minutes { get; set; }
    /// <summary>Axis and tooltip text for a value (ignored when <see cref="Minutes"/> is set).</summary>
    [Parameter] public Func<double, string> Format { get; set; } = v => v.ToString("0");
    [Parameter] public int Height { get; set; } = 240;
    [Parameter] public int LabelEvery { get; set; } = 1;
    [Parameter] public string AriaLabel { get; set; } = "Bar chart";

    List<ChartSeries<double>> _series = new();
    string[] _labels = [];
    BarChartOptions _options = new();

    protected override void OnParametersSet()
    {
        _series = [new() { Name = AriaLabel, Data = Values.ToArray() }];
        _labels = Labels.ToArray();
        var hi = Values.DefaultIfEmpty(0).Max();
        _options = new BarChartOptions
        {
            ShowLegend = false,
            ChartPalette = [ChartColors.Series(Store.Settings.DarkMode)],
            BarWidthRatio = 0.7,
            XAxisLabelInterval = Math.Max(1, LabelEvery),
            YAxisTicks = Minutes ? MinuteStep(hi) : 0,
            MaxNumYAxisTicks = 6,
            YAxisToStringFunc = Minutes ? (v => Stats.Duration((int)Math.Round(v * 60))) : Format,
            TooltipTitleFormat = "{{Y_AXIS_VALUE}}",
            TooltipSubtitleFormat = "{{X_VALUE}}",
        };
    }

    // round duration steps (15 min … 2 hr) giving about four ticks
    static int MinuteStep(double max)
    {
        foreach (var step in new[] { 5, 10, 15, 30, 60, 120, 180, 240, 300, 600 })
            if (max / step <= 5) return step;
        return 600;
    }
}
