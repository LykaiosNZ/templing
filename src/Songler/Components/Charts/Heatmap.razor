@* Practice calendar on MudChart's HeatMap: one row per weekday, one column per week, minutes practised per day. *@
@inject DataStore Store

<div class="viz heatmap" role="img" aria-label="@AriaLabel">
    <MudChart T="double" ChartType="ChartType.HeatMap" ChartSeries="_series" ChartLabels="_labels" ChartOptions="_options"
              Width="100%" Height="@($"{Height}px")" MatchBoundsToSize="true" />
</div>

@code {
    [Parameter] public Dictionary<DateTime, int> SecondsByDay { get; set; } = new();
    [Parameter] public int Weeks { get; set; } = 26;
    [Parameter] public int Height { get; set; } = 190;
    [Parameter] public DateTime Today { get; set; } = DateTime.Today;
    [Parameter] public string AriaLabel { get; set; } = "Practice calendar";

    static readonly string[] Days = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
    List<ChartSeries<double>> _series = new();
    string[] _labels = [];
    HeatMapChartOptions _options = new();

    protected override void OnParametersSet()
    {
        var start = Stats.WeekStart(Today).AddDays(-7 * (Weeks - 1));
        _series = Days.Select((name, d) => new ChartSeries<double>
        {
            Name = name,
            Data = Enumerable.Range(0, Weeks).Select(w => SecondsByDay.GetValueOrDefault(start.AddDays(w * 7 + d)) / 60.0).ToArray(),
        }).ToList();
        // a month name over the first week that starts in that month
        _labels = Enumerable.Range(0, Weeks).Select(w =>
        {
            var first = start.AddDays(w * 7);
            return w == 0 || first.Day <= 7 ? first.ToString("MMM") : "";
        }).ToArray();
        _options = new HeatMapChartOptions
        {
            ChartPalette = ChartColors.Heat(Store.Settings.DarkMode),
            ShowLabels = false,
            ShowLegend = true,
            ShowToolTips = true,
            ValueFormatString = "F0",
            TooltipTitleFormat = "{{Y_VALUE}} min",
            TooltipSubtitleFormat = "{{SERIES_NAME}}",
            XAxisLabelPosition = XAxisLabelPosition.Top,
        };
    }
}
