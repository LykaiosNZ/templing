@inject DataStore Store
@inject IDialogService Dialogs

@if (Logs.Count == 0)
{
    <MudText Class="muted pa-4">No entries yet.</MudText>
}
else
{
    <div class="log-table-wrap hide-phone">
        <table class="log-table">
            <thead>
                <tr>
                    <th scope="col">Date</th>
                    @if (ShowItem) { <th scope="col">Item</th> }
                    else if (_hasParts) { <th scope="col">Part</th> }
                    <th scope="col" class="num">Tempo</th>
                    <th scope="col" class="num">Time</th>
                    <th scope="col">Feel</th>
                    <th scope="col">Notes</th>
                    <th scope="col"><span class="sr-only">Edit</span></th>
                </tr>
            </thead>
            <tbody>
                @{ DateTime? prev = null; }
                @foreach (var l in Logs.Take(_shown))
                {
                    var newDay = prev != l.Date.Date;
                    prev = l.Date.Date;
                    var item = Store.GetItem(l.ItemId);
                    var section = item?.Sections.Count > 1 ? item.Sections.FirstOrDefault(s => s.Id == l.SectionId)?.Name : null;
                    <tr class="@(newDay ? "day-start" : "")">
                        <td class="date">@(newDay ? l.Date.ToString("ddd d MMM yy") : "")</td>
                        @if (ShowItem)
                        {
                            <td>
                                @if (item != null) { <a href="library/@item.Id">@l.ItemName</a> } else { <span>@l.ItemName</span> }
                                @if (section != null) { <span class="muted small"> · @section</span> }
                            </td>
                        }
                        else if (_hasParts)
                        {
                            <td class="@(section == null ? "muted small" : "")">@(section ?? "Full run-through")</td>
                        }
                        <td class="num mono">@l.ValueText</td>
                        <td class="num mono">@(l.DurationSec is { } d ? Stats.Duration(d) : "—")</td>
                        <td>
                            @if (Effort.Get(l.Effort) is { } feel)
                            {
                                <span class="feel-pill" style="--feel:@feel.Color" title="@feel.Advice">@feel.Label</span>
                            }
                        </td>
                        <td class="notes">@l.Notes</td>
                        <td class="act"><MudIconButton Size="Size.Small" Icon="@Icons.Material.Rounded.Edit" aria-label="@($"Edit entry {l.ItemName} {l.Date:d MMM}")" OnClick="() => Edit(l)" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @* phones: compact rows instead of a wide table *@
    <div class="log-cards show-phone-block">
        @foreach (var day in Logs.Take(_shown).GroupBy(l => l.Date.Date))
        {
            <div class="log-day">
                <div class="log-day-head">@day.Key.ToString("ddd d MMM yy")</div>
                @foreach (var l in day)
                {
                    var item = Store.GetItem(l.ItemId);
                    var section = item?.Sections.Count > 1 ? item.Sections.FirstOrDefault(s => s.Id == l.SectionId)?.Name : null;
                    var what = ShowItem ? l.ItemName + (section != null ? $" · {section}" : "") : _hasParts ? section ?? "Full run-through" : null;
                    <div class="log-row">
                        <div class="log-row-main">
                            @if (what != null) { <span class="log-what">@what</span> }
                            <span class="mono">@l.ValueText</span>
                            <span class="mono muted">@(l.DurationSec is { } d ? Stats.Duration(d) : "—")</span>
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Rounded.Edit" Class="log-edit" aria-label="@($"Edit entry {l.ItemName} {l.Date:d MMM}")" OnClick="() => Edit(l)" />
                        </div>
                        @if (Effort.Get(l.Effort) is { } feel || !string.IsNullOrWhiteSpace(l.Notes))
                        {
                            <div class="log-row-sub">
                                @if (Effort.Get(l.Effort) is { } f2) { <span class="feel-pill" style="--feel:@f2.Color">@f2.Label</span> }
                                @if (!string.IsNullOrWhiteSpace(l.Notes)) { <span class="muted">@l.Notes</span> }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
    @if (Logs.Count > _shown)
    {
        <MudButton Variant="Variant.Text" OnClick="() => _shown += PageSize" Class="mt-2">Show more (@(Logs.Count - _shown) left)</MudButton>
    }
}

@code {
    [Parameter] public List<PracticeLog> Logs { get; set; } = new();
    [Parameter] public bool ShowItem { get; set; } = true;
    [Parameter] public int PageSize { get; set; } = 40;
    int _shown;

    bool _hasParts;

    protected override void OnInitialized() => _shown = PageSize;

    // single-item view: show a Part column when the item is split into sections
    protected override void OnParametersSet() =>
        _hasParts = !ShowItem && Logs.Select(l => l.ItemId).Distinct().Any(id => Store.GetItem(id)?.Sections.Count > 1);

    async Task Edit(PracticeLog l)
    {
        // edit a copy so cancel is clean
        var copy = System.Text.Json.JsonSerializer.Deserialize<PracticeLog>(System.Text.Json.JsonSerializer.Serialize(l, DataStore.Json), DataStore.Json)!;
        await LogDialog.ShowAsync(Dialogs, copy, false);
    }
}
