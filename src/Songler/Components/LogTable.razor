@inject DataStore Store
@inject IDialogService Dialogs

@if (Logs.Count == 0)
{
    <MudText Class="muted pa-4">No entries yet.</MudText>
}
else
{
    <div class="log-table-wrap">
        <table class="log-table">
            <thead>
                <tr>
                    <th scope="col">Date</th>
                    @if (ShowItem) { <th scope="col">Item</th> }
                    <th scope="col" class="num">Tempo</th>
                    <th scope="col" class="num">Time</th>
                    <th scope="col">Notes</th>
                    <th scope="col"><span class="sr-only">Edit</span></th>
                </tr>
            </thead>
            <tbody>
                @{ DateTime? prev = null; }
                @foreach (var l in Logs.Take(_shown))
                {
                    var newDay = prev != l.Date.Date;
                    prev = l.Date.Date;
                    var item = Store.GetItem(l.ItemId);
                    var section = item?.Sections.Count > 1 ? item.Sections.FirstOrDefault(s => s.Id == l.SectionId)?.Name : null;
                    <tr class="@(newDay ? "day-start" : "")">
                        <td class="date">@(newDay ? l.Date.ToString("ddd d MMM yy") : "")</td>
                        @if (ShowItem)
                        {
                            <td>
                                @if (item != null) { <a href="library/@item.Id">@l.ItemName</a> } else { <span>@l.ItemName</span> }
                                @if (section != null) { <span class="muted small"> · @section</span> }
                            </td>
                        }
                        <td class="num mono">@l.ValueText@if (!ShowItem && section != null) { <span class="muted small"> @section</span> }</td>
                        <td class="num mono">@(l.DurationSec is { } d ? Stats.Duration(d) : "—")</td>
                        <td class="notes">@l.Notes</td>
                        <td class="act"><MudIconButton Size="Size.Small" Icon="@Icons.Material.Rounded.Edit" aria-label="@($"Edit entry {l.ItemName} {l.Date:d MMM}")" OnClick="() => Edit(l)" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Logs.Count > _shown)
    {
        <MudButton Variant="Variant.Text" OnClick="() => _shown += PageSize" Class="mt-2">Show more (@(Logs.Count - _shown) left)</MudButton>
    }
}

@code {
    [Parameter] public List<PracticeLog> Logs { get; set; } = new();
    [Parameter] public bool ShowItem { get; set; } = true;
    [Parameter] public int PageSize { get; set; } = 40;
    int _shown;

    protected override void OnInitialized() => _shown = PageSize;

    async Task Edit(PracticeLog l)
    {
        // edit a copy so cancel is clean
        var copy = System.Text.Json.JsonSerializer.Deserialize<PracticeLog>(System.Text.Json.JsonSerializer.Serialize(l, DataStore.Json), DataStore.Json)!;
        await LogDialog.ShowAsync(Dialogs, copy, false);
    }
}
