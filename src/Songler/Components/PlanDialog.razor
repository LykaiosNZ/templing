@inject DataStore Store

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsNew ? "New plan" : $"Edit {Plan.Name}")</MudText>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-column gap-3">
            <MudTextField T="string" Value="_m.Name" ValueChanged="v => { _m.Name = v; _nameTouched = true; }" Label="Name" Placeholder="My routine" AutoFocus="@IsNew" Immediate="true"
                          Error="@(_nameTouched && string.IsNullOrWhiteSpace(_m.Name))" ErrorText="Enter a name" />
            <div class="d-flex justify-space-between align-center flex-wrap gap-2">
                <MudText Typo="Typo.subtitle2">Steps (@_m.Steps.Count) · @Stats.Duration((int)(_m.TotalMinutes * 60)) total</MudText>
                <div class="d-flex gap-2">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.Add" OnClick="AddPiece">Add practice step</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.SelfImprovement" OnClick="AddRest">Add rest</MudButton>
                </div>
            </div>
            @if (_m.Steps.Count > 0)
            {
            <div class="plan-steps" role="list">
                @for (int i = 0; i < _m.Steps.Count; i++)
                {
                    var idx = i;
                    var s = _m.Steps[i];
                    var piece = Store.GetPiece(s.PieceId);
                    var open = _open.Contains(s.Id);
                    var missing = PlanStepSummary.IsMissing(s, Store);
                    <div class="edit-row @(s.Kind == PlanStepKind.Rest ? "rest" : "") @(open ? "open" : "") @(missing ? "missing" : "") @(s.Id == _drag.DraggingId ? "dragging" : "")" role="listitem" @key="s.Id"
                         data-drag-row @ondragover:preventDefault="true" @ondragenter="() => DragEnter(idx)" @ondrop="_drag.Drop" @ondrop:preventDefault="true">
                        <div class="er-head">
                            <span class="er-drag" draggable="true" data-drag-handle aria-hidden="true"
                                  @ondragstart="() => _drag.Start(s)" @ondragend="() => _drag.End()">
                                <MudIcon Icon="@Icons.Material.Rounded.DragIndicator" Size="Size.Small" />
                            </span>
                            <button type="button" class="er-summary" aria-expanded="@(open ? "true" : "false")" aria-controls="@($"er-body-{s.Id}")" @onclick="() => Toggle(s)">
                                <MudIcon Icon="@Icons.Material.Rounded.ExpandMore" Size="Size.Small" Class="er-chevron" />
                                <PlanStepSummary Step="s" Index="idx" />
                            </button>
                            <span class="er-actions">
                                <MudTooltip Text="Move up">
                                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Rounded.ArrowUpward" Disabled="idx == 0" aria-label="@($"Move step {idx + 1} up")" OnClick="() => Move(idx, -1)" />
                                </MudTooltip>
                                <MudTooltip Text="Move down">
                                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Rounded.ArrowDownward" Disabled="idx == _m.Steps.Count - 1" aria-label="@($"Move step {idx + 1} down")" OnClick="() => Move(idx, 1)" />
                                </MudTooltip>
                                <MudTooltip Text="Duplicate">
                                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Rounded.ContentCopy" aria-label="@($"Duplicate step {idx + 1}")" OnClick="() => Duplicate(idx)" />
                                </MudTooltip>
                                <MudTooltip Text="Remove">
                                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Rounded.Close" aria-label="@($"Remove step {idx + 1}")" OnClick="() => _m.Steps.RemoveAt(idx)" />
                                </MudTooltip>
                            </span>
                        </div>
                        @if (open)
                        {
                            <div class="er-body" id="@($"er-body-{s.Id}")">
                                @if (s.Kind == PlanStepKind.Rest)
                                {
                                    <DurationInput Seconds="s.Minutes * 60" SecondsChanged="v => s.Minutes = (v ?? 120) / 60" Label="Length" MinSeconds="15" MaxSeconds="3600" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ps-dur-field" />
                                }
                                else
                                {
                                    <MudSelect T="string" @bind-Value="s.PieceId" @bind-Value:after="() => s.SectionId = null" Label="Piece" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="ps-piece">
                                        @foreach (var it in Store.PiecesByRecent(keepId: s.PieceId)) { <MudSelectItem T="string" Value="@it.Id">@it.Name</MudSelectItem> }
                                    </MudSelect>
                                    @if (piece is { } it2 && it2.Sections.Count > 1)
                                    {
                                        <MudSelect T="string" Value="@(s.SectionId ?? "")" ValueChanged="v => s.SectionId = string.IsNullOrEmpty(v) ? null : v" Label="Section" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="ps-part">
                                            <MudSelectItem T="string" Value="@("")">Full run-through</MudSelectItem>
                                            @foreach (var sec in it2.Sections) { <MudSelectItem T="string" Value="@sec.Id">@sec.Name</MudSelectItem> }
                                        </MudSelect>
                                    }
                                    <MudToggleGroup T="StepMode" @bind-Value="s.Mode" Color="Color.Primary" Size="Size.Small" Outlined="true" CheckMark="false" Class="ps-mode" aria-label="Practise with">
                                        <MudToggleItem Value="StepMode.Metronome"><span class="d-inline-flex align-center gap-1"><MudIcon Icon="@Mdi.Metronome" Size="Size.Small" />Metronome</span></MudToggleItem>
                                        <MudToggleItem Value="StepMode.Timer"><span class="d-inline-flex align-center gap-1"><MudIcon Icon="@Icons.Material.Rounded.HourglassBottom" Size="Size.Small" />Timer</span></MudToggleItem>
                                    </MudToggleGroup>
                                    <DurationInput Seconds="s.Minutes * 60" SecondsChanged="v => s.Minutes = (v ?? 600) / 60" Label="Work" MinSeconds="15" MaxSeconds="7200" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ps-dur-field" />
                                    <MudNumericField T="int" @bind-Value="s.Rounds" Label="Rounds" Min="1" Max="20" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ps-num-field" />
                                    @if (s.Rounds > 1)
                                    {
                                        <DurationInput Seconds="s.RestMin * 60" SecondsChanged="v => s.RestMin = (v ?? 0) / 60" Label="Rest" MaxSeconds="1800" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ps-dur-field" />
                                    }
                                    @if (s.Mode == StepMode.Metronome)
                                    {
                                        var u = piece?.Unit == TempoUnit.Percent ? "%" : "bpm";
                                        <div class="ps-tempo">
                                            <MudTooltip Text="@($"Speed trainer: {(s.Trainer ? "on" : "off")}")">
                                                <MudIconButton Icon="@Icons.Material.Rounded.TrendingUp" Size="Size.Small" Class="@(s.Trainer ? "opt-toggle on" : "opt-toggle")" aria-label="Speed trainer"
                                                               aria-pressed="@(s.Trainer ? "true" : "false")" OnClick="() => ToggleTrainer(s, piece)" />
                                            </MudTooltip>
                                            @if (s.Trainer)
                                            {
                                                <MudNumericField T="double" @bind-Value="s.TrainerStart" Label="@($"From ({u})")" Min="10" Max="400" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ps-num-field" />
                                                <MudNumericField T="double" @bind-Value="s.TrainerEnd" Label="@($"To ({u})")" Min="10" Max="400" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ps-num-field" />
                                                var ts = s.TrainerSettings();
                                                <MudNumericField T="int" Value="ts.StepCount" ValueChanged="v => s.TrainerSteps = v" Label="Steps" Min="1" Max="ts.MaxSteps"
                                                                 Variant="Variant.Outlined" Margin="Margin.Dense" Class="ps-num-field" />
                                                <MudToggleGroup T="RampMode" @bind-Value="s.TrainerMode" Color="Color.Primary" Size="Size.Small" Outlined="true" CheckMark="false" Class="ps-ramp">
                                                    <MudToggleItem Value="RampMode.OverTime" Text="Over the step" />
                                                    <MudToggleItem Value="RampMode.EveryNBars" Text="Every N bars" />
                                                </MudToggleGroup>
                                                @if (s.TrainerMode == RampMode.EveryNBars)
                                                {
                                                    <MudNumericField T="int" @bind-Value="s.TrainerEveryBars" Label="Every (bars)" Min="1" Max="64" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ps-num-field" />
                                                }
                                            }
                                            else
                                            {
                                                <MudNumericField T="double?" @bind-Value="s.StartTempo" Label="@($"Start tempo ({u})")" Min="10" Max="400" Clearable="true"
                                                                 Placeholder="piece's start" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ps-start-field" />
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            </div>
            }
        </div>
    </DialogContent>
    <DialogActions>
        @if (SaveBlocker is { } why)
        {
            <MudText Typo="Typo.body2" Class="muted ml-2">@why</MudText>
        }
        <MudSpacer />
        <MudButton OnClick="() => Dialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="@(SaveBlocker != null)">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>
    /// Switching a step's trainer on starts it at the piece's Start at and ends at its goal, unless From/To were
    /// already changed from the defaults (80 → 120).
    /// </summary>
    static void ToggleTrainer(PlanStep s, Piece? piece)
    {
        if (!s.Trainer && piece != null && s.TrainerStart == 80 && s.TrainerEnd == 120)
        {
            if (piece.StartTempo is { } start) s.TrainerStart = start;
            if (piece.Goal is { } goal && goal > s.TrainerStart) s.TrainerEnd = goal;
        }
        s.Trainer = !s.Trainer;
    }

    [CascadingParameter] public IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public PracticePlan Plan { get; set; } = new();
    [Parameter] public bool IsNew { get; set; }
    PracticePlan _m = new();
    bool _nameTouched;
    // steps whose fields are showing; the rest show as one-line summaries
    readonly HashSet<string> _open = new();

    /// <summary>Why Save is disabled, said next to it (null = can save).</summary>
    string? SaveBlocker
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_m.Name)) return "Add a name";
            if (_m.Steps.Count == 0) return "Add a step";
            var noPiece = _m.Steps.Select((s, i) => (s, i)).Where(x => x.s.Kind == PlanStepKind.Piece && x.s.PieceId == null).Select(x => x.i + 1).ToList();
            return noPiece.Count switch
            {
                0 => null,
                1 => $"Select a piece for step {noPiece[0]}",
                _ => $"Select a piece for steps {string.Join(", ", noPiece.SkipLast(1))} and {noPiece[^1]}"
            };
        }
    }

    // drag to reorder (the up/down buttons stay for keyboard and touch); see DragReorder
    DragReorder<PlanStep>? _dragger;
    DragReorder<PlanStep> _drag => _dragger ??= new(() => _m.Steps, s => s.Id);

    void DragEnter(int i) { if (!_drag.Enter(i)) _skipRender = true; }

    bool _skipRender;
    protected override bool ShouldRender()
    {
        if (!_skipRender) return true;
        _skipRender = false;
        return false;
    }

    void Toggle(PlanStep s) { if (!_open.Remove(s.Id)) _open.Add(s.Id); }
    void OpenOnly(PlanStep s) { _open.Clear(); _open.Add(s.Id); }

    public static async Task<PracticePlan?> ShowAsync(IDialogService dialogs, PracticePlan? plan = null)
    {
        var p = new DialogParameters<PlanDialog> { { x => x.Plan, plan ?? new PracticePlan() }, { x => x.IsNew, plan == null } };
        var r = await dialogs.ShowAsync<PlanDialog>("Plan", p, new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true, Position = DialogPosition.TopCenter });
        var res = await r.Result;
        return res is { Canceled: false } ? res.Data as PracticePlan : null;
    }

    protected override void OnInitialized()
    {
        _m = System.Text.Json.JsonSerializer.Deserialize<PracticePlan>(System.Text.Json.JsonSerializer.Serialize(Plan, DataStore.Json), DataStore.Json)!;
        if (IsNew) _m.Name = "";
    }

    void AddPiece()
    {
        var last = _m.Steps.LastOrDefault(s => s.Kind == PlanStepKind.Piece);
        var step = new PlanStep { Kind = PlanStepKind.Piece, Mode = last?.Mode ?? StepMode.Metronome, Minutes = last?.Minutes ?? 10, Rounds = last?.Rounds ?? 1, RestMin = last?.RestMin ?? 0 };
        _m.Steps.Add(step);
        OpenOnly(step);
    }

    void AddRest()
    {
        var step = new PlanStep { Kind = PlanStepKind.Rest, Minutes = 2 };
        _m.Steps.Add(step);
        OpenOnly(step);
    }

    void Move(int i, int d)
    {
        var j = i + d;
        (_m.Steps[i], _m.Steps[j]) = (_m.Steps[j], _m.Steps[i]);
    }

    void Duplicate(int i)
    {
        var s = _m.Steps[i];
        var copy = new PlanStep
        {
            Kind = s.Kind, PieceId = s.PieceId, SectionId = s.SectionId, Mode = s.Mode, Minutes = s.Minutes, Rounds = s.Rounds, RestMin = s.RestMin,
            StartTempo = s.StartTempo, Trainer = s.Trainer, TrainerStart = s.TrainerStart, TrainerEnd = s.TrainerEnd,
            TrainerMode = s.TrainerMode, TrainerSteps = s.TrainerSteps, TrainerEveryBars = s.TrainerEveryBars,
        };
        _m.Steps.Insert(i + 1, copy);
        OpenOnly(copy);
    }

    async Task Save()
    {
        if (SaveBlocker != null) return;
        _m.Name = _m.Name.Trim();
        await Store.SavePlanAsync(_m);
        Dialog.Close(DialogResult.Ok(_m));
    }
}
