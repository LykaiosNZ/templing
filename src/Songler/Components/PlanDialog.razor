@inject DataStore Store

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsNew ? "New plan" : $"Edit {Plan.Name}")</MudText>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-column gap-3">
            <MudTextField @bind-Value="_m.Name" Label="Plan name" AutoFocus="true" Immediate="true" />
            <div class="d-flex justify-space-between align-center flex-wrap gap-2">
                <MudText Typo="Typo.subtitle2">Steps (@_m.Steps.Count) · @Stats.Duration((int)(_m.TotalMinutes * 60)) total</MudText>
                <div class="d-flex gap-2">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.Add" OnClick="AddItem">Add practice step</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.SelfImprovement" OnClick="AddRest">Add rest</MudButton>
                </div>
            </div>
            <div class="plan-steps" role="list">
                @for (int i = 0; i < _m.Steps.Count; i++)
                {
                    var idx = i;
                    var s = _m.Steps[i];
                    var item = Store.GetItem(s.ItemId);
                    <div class="plan-step-row @(s.Kind == PlanStepKind.Rest ? "rest" : "")" role="listitem" @key="s.Id">
                        <span class="ps-num">@(idx + 1)</span>
                        @if (s.Kind == PlanStepKind.Rest)
                        {
                            <span class="ps-rest"><MudIcon Icon="@Icons.Material.Rounded.SelfImprovement" Size="Size.Small" /> Rest</span>
                            <DurationInput Seconds="s.Minutes * 60" SecondsChanged="v => s.Minutes = (v ?? 120) / 60" Label="Length" MinSeconds="15" MaxSeconds="3600" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ps-dur-field" />
                        }
                        else
                        {
                            <MudSelect T="string" @bind-Value="s.ItemId" @bind-Value:after="() => s.SectionId = null" Label="Item" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ps-item">
                                @foreach (var it in Store.Items.Where(x => !x.Archived || x.Id == s.ItemId)) { <MudSelectItem T="string" Value="@it.Id">@it.Name</MudSelectItem> }
                            </MudSelect>
                            @if (item is { } it2 && it2.Sections.Count > 1)
                            {
                                <MudSelect T="string" @bind-Value="s.SectionId" Label="@(it2.Type == ItemType.Song ? "Part" : "Section")" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ps-part">
                                    @foreach (var sec in it2.Sections) { <MudSelectItem T="string" Value="@sec.Id">@sec.Name</MudSelectItem> }
                                </MudSelect>
                            }
                            <MudSelect T="StepMode" @bind-Value="s.Mode" Label="With" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ps-mode">
                                <MudSelectItem T="StepMode" Value="StepMode.Metronome">Metronome</MudSelectItem>
                                <MudSelectItem T="StepMode" Value="StepMode.Timer">Timer (no click)</MudSelectItem>
                            </MudSelect>
                            <DurationInput Seconds="s.Minutes * 60" SecondsChanged="v => s.Minutes = (v ?? 600) / 60" Label="Work" MinSeconds="15" MaxSeconds="7200" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ps-dur-field" />
                            <MudNumericField T="int" @bind-Value="s.Rounds" Label="Rounds" Min="1" Max="20" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ps-num-field" />
                            <DurationInput Seconds="s.RestMin * 60" SecondsChanged="v => s.RestMin = (v ?? 0) / 60" Label="Rest" MaxSeconds="1800" Disabled="s.Rounds < 2" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ps-dur-field" />
                            @if (s.Mode == StepMode.Metronome)
                            {
                                var u = item?.Unit == TempoUnit.Percent ? "%" : "bpm";
                                <div class="ps-tempo">
                                    <MudSwitch T="bool" @bind-Value="s.Trainer" Color="Color.Primary" Label="Speed trainer" Class="ps-switch" />
                                    @if (s.Trainer)
                                    {
                                        <MudNumericField T="double" @bind-Value="s.TrainerStart" Label="@($"From ({u})")" Min="10" Max="400" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ps-num-field" />
                                        <MudNumericField T="double" @bind-Value="s.TrainerEnd" Label="@($"To ({u})")" Min="10" Max="400" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ps-num-field" />
                                        <MudText Typo="Typo.caption" Class="muted">over the step's @Stats.Duration((int)(s.WorkMinutes * 60)) of playing, then holds</MudText>
                                    }
                                    else
                                    {
                                        <MudNumericField T="double?" @bind-Value="s.StartTempo" Label="@($"Start tempo ({u})")" Min="10" Max="400" Clearable="true"
                                                         Placeholder="last logged" Variant="Variant.Outlined" Margin="Margin.Dense" Class="ps-start-field" />
                                        <MudText Typo="Typo.caption" Class="muted">change it as you go with ↑ / ↓</MudText>
                                    }
                                </div>
                            }
                        }
                        <span class="ps-actions">
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Rounded.ArrowUpward" Disabled="idx == 0" aria-label="@($"Move step {idx + 1} up")" OnClick="() => Move(idx, -1)" />
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Rounded.ArrowDownward" Disabled="idx == _m.Steps.Count - 1" aria-label="@($"Move step {idx + 1} down")" OnClick="() => Move(idx, 1)" />
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Rounded.ContentCopy" aria-label="@($"Duplicate step {idx + 1}")" OnClick="() => Duplicate(idx)" />
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Rounded.Close" aria-label="@($"Remove step {idx + 1}")" OnClick="() => _m.Steps.RemoveAt(idx)" />
                        </span>
                    </div>
                }
                @if (_m.Steps.Count == 0)
                {
                    <MudText Class="muted pa-4">Add steps in the order you practise them: warm-up, exercises, then songs.</MudText>
                }
            </div>
            <MudText Typo="Typo.caption" Class="muted">
                Tip: a step with 2 rounds of 5 min and 1 min rest is a 5 · 1 · 5 interval. Use <em>Timer</em> for anything you play along to in Guitar Pro.
            </MudText>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="@(string.IsNullOrWhiteSpace(_m.Name) || _m.Steps.Count == 0 || _m.Steps.Any(s => s.Kind == PlanStepKind.Item && s.ItemId == null))">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public PracticePlan Plan { get; set; } = new();
    [Parameter] public bool IsNew { get; set; }
    PracticePlan _m = new();

    public static async Task<PracticePlan?> ShowAsync(IDialogService dialogs, PracticePlan? plan = null)
    {
        var p = new DialogParameters<PlanDialog> { { x => x.Plan, plan ?? new PracticePlan() }, { x => x.IsNew, plan == null } };
        var r = await dialogs.ShowAsync<PlanDialog>("Plan", p, new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true });
        var res = await r.Result;
        return res is { Canceled: false } ? res.Data as PracticePlan : null;
    }

    protected override void OnInitialized() =>
        _m = System.Text.Json.JsonSerializer.Deserialize<PracticePlan>(System.Text.Json.JsonSerializer.Serialize(Plan, DataStore.Json), DataStore.Json)!;

    void AddItem()
    {
        var last = _m.Steps.LastOrDefault(s => s.Kind == PlanStepKind.Item);
        _m.Steps.Add(new PlanStep { Kind = PlanStepKind.Item, Mode = last?.Mode ?? StepMode.Metronome, Minutes = last?.Minutes ?? 10, Rounds = last?.Rounds ?? 1, RestMin = last?.RestMin ?? 0 });
    }

    void AddRest() => _m.Steps.Add(new PlanStep { Kind = PlanStepKind.Rest, Minutes = 2 });

    void Move(int i, int d)
    {
        var j = i + d;
        (_m.Steps[i], _m.Steps[j]) = (_m.Steps[j], _m.Steps[i]);
    }

    void Duplicate(int i)
    {
        var s = _m.Steps[i];
        _m.Steps.Insert(i + 1, new PlanStep
        {
            Kind = s.Kind, ItemId = s.ItemId, SectionId = s.SectionId, Mode = s.Mode, Minutes = s.Minutes, Rounds = s.Rounds, RestMin = s.RestMin,
            StartTempo = s.StartTempo, Trainer = s.Trainer, TrainerStart = s.TrainerStart, TrainerEnd = s.TrainerEnd
        });
    }

    async Task Save()
    {
        _m.Name = _m.Name.Trim();
        await Store.SavePlanAsync(_m);
        Dialog.Close(DialogResult.Ok(_m));
    }
}
