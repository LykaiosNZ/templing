@inherits LayoutComponentBase
@implements IDisposable
@inject DataStore Store
@inject MetronomeService Metro
@inject Shortcuts Keys
@inject NavigationManager Nav
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject PlanRunner Runner

<MudThemeProvider Theme="@_theme" IsDarkMode="@_dark" />
@if (_css.Length > 0)
{
    @* the user's colours (Settings > Colours) over the tokens in songler.css *@
    <style>@((MarkupString)_css)</style>
}
<MudPopoverProvider />
<MudDialogProvider CloseOnEscapeKey="true" BackdropClick="true" />
<MudSnackbarProvider />

<a class="skip-link" href="#main">Skip to content</a>

@if (!_ready)
{
    <BootScreen />
}
else
{
    <MudLayout Class="@(_dark ? "theme-dark" : "theme-light")">
        <MudAppBar Elevation="0" Dense="false" Class="app-bar">
            <MudTooltip Text="Menu">
                <MudIconButton Icon="@Icons.Material.Rounded.Menu" Color="Color.Inherit" Edge="Edge.Start"
                               aria-label="Toggle navigation" OnClick="@(() => _drawer = !_drawer)" />
            </MudTooltip>
            <a href="" class="brand" aria-label="Songler home">
                <span class="brand-mark" aria-hidden="true">♪</span>
                <span class="brand-name">Songler</span>
            </a>
            <MudSpacer />
            <MudTooltip Text="Log practice">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Rounded.AddTask" Color="Color.Inherit"
                           Class="hide-phone appbar-log" OnClick="QuickLog">Log</MudButton>
                <MudIconButton Icon="@Icons.Material.Rounded.AddTask" Color="Color.Inherit" aria-label="Log practice" Class="show-phone" OnClick="QuickLog" />
            </MudTooltip>
            <MudTooltip Text="Keyboard shortcuts">
                <MudIconButton Icon="@Icons.Material.Rounded.Keyboard" Color="Color.Inherit" aria-label="Keyboard shortcuts" OnClick="ShowShortcuts" />
            </MudTooltip>
            <MudTooltip Text="@(_dark ? "Light mode" : "Dark mode")">
                <MudIconButton Icon="@(_dark ? Icons.Material.Rounded.LightMode : Icons.Material.Rounded.DarkMode)" Color="Color.Inherit"
                               aria-label="Toggle dark mode" OnClick="ToggleDark" />
            </MudTooltip>
        </MudAppBar>
        <MudDrawer @bind-Open="_drawer" ClipMode="DrawerClipMode.Always" Elevation="0" Variant="DrawerVariant.Responsive" Class="app-drawer">
            <MudNavMenu Rounded="true" Margin="Margin.Dense" Color="Color.Primary" Class="pa-2" aria-label="Main">
                <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Rounded.SpaceDashboard">Dashboard</MudNavLink>
                <MudNavLink Href="library" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Rounded.LibraryMusic">Library</MudNavLink>
                <div class="nav-heading stat-label" role="presentation">Practice</div>
                <MudNavLink Href="metronome" Match="NavLinkMatch.Prefix" Icon="@Mdi.Metronome">Metronome</MudNavLink>
                <MudNavLink Href="timer" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Rounded.HourglassBottom">Timer</MudNavLink>
                <MudNavLink Href="plans" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Rounded.ChecklistRtl">Plans</MudNavLink>
                <div class="nav-heading stat-label" role="presentation">Progress</div>
                <MudNavLink Href="history" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Rounded.History">History</MudNavLink>
                <MudNavLink Href="stats" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Rounded.Insights">Stats</MudNavLink>
                <MudDivider Class="my-2" />
                <MudNavLink Href="settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Rounded.Settings">Settings &amp; data</MudNavLink>
            </MudNavMenu>
        </MudDrawer>
        <MudMainContent>
            <main id="main" tabindex="-1">
                <PlanBar />
                <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6 px-4 px-md-8">
                    @Body
                </MudContainer>
            </main>
        </MudMainContent>
    </MudLayout>
}

@code {
    private bool _drawer = true;
    private bool _dark = true;
    private bool _ready;
    private MudTheme _theme = AppTheme.Create();
    private string _css = "";
    private string? _coloursKey;
    private readonly List<IDisposable> _keys = new();

    protected override async Task OnInitializedAsync()
    {
        await Store.EnsureLoadedAsync();
        _dark = Store.Settings.DarkMode;
        ApplyColours();
        Store.Changed += OnStoreChanged;
        await Keys.InitAsync();
        await Metro.InitAsync();
        await Runner.RestoreAsync(); // resume a plan that was running before a refresh
        RegisterGlobalKeys();
        _ready = true;
    }

    private void RegisterGlobalKeys()
    {
        void Go(Hotkey key, string url) => _keys.Add(Keys.Register(this, key, () => Nav.NavigateTo(url)));
        Go(Hotkeys.GoDashboard, ""); Go(Hotkeys.GoLibrary, "library"); Go(Hotkeys.GoMetronome, "metronome"); Go(Hotkeys.GoTimer, "timer");
        Go(Hotkeys.GoPlans, "plans"); Go(Hotkeys.GoHistory, "history"); Go(Hotkeys.GoStats, "stats"); Go(Hotkeys.GoSettings, "settings");
        _keys.Add(Keys.Register(this, Hotkeys.Help, ShowShortcuts));
        _keys.Add(Keys.Register(this, Hotkeys.LogPractice, QuickLog));
        _keys.Add(Keys.Register(this, Hotkeys.SearchLibrary, async () =>
        {
            if (!Nav.ToBaseRelativePath(Nav.Uri).StartsWith("library", StringComparison.OrdinalIgnoreCase)) Nav.NavigateTo("library");
            await Keys.FocusAsync("#library-search"); // waits for the field to render
        }));
        // the practice keys (Space, tempo…) belong to the Metronome and Timer pages: see PracticeKeys
    }

    private async Task QuickLog()
    {
        var log = new PracticeLog { Date = DateTime.Today };
        if (Metro.Source == MetronomeSource.Piece && Metro.Piece != null) { log = Metro.BuildSessionLog(); }
        if (await LogDialog.ShowAsync(Dialogs, log, isNew: true)) Snackbar.Add("Practice logged", Severity.Success);
    }

    private async Task ShowShortcuts() =>
        await Dialogs.ShowAsync<ShortcutsDialog>("Keyboard shortcuts", new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });

    private async Task ToggleDark()
    {
        _dark = !_dark;
        Store.Settings.DarkMode = _dark;
        await Store.SaveSettingsAsync();
    }

    // Rebuild the theme only when the custom colours actually changed (Store.Changed fires for every write)
    private bool ApplyColours()
    {
        var c = Store.Settings.Colours;
        var key = c == null ? "" : System.Text.Json.JsonSerializer.Serialize(c, DataStore.Json);
        if (key == _coloursKey) return false;
        _coloursKey = key;
        _theme = ThemeColours.Theme(c);
        _css = ThemeColours.Css(c);
        return true;
    }

    private void OnStoreChanged()
    {
        var dark = Store.Settings.DarkMode;
        if (ApplyColours() | dark != _dark) { _dark = dark; InvokeAsync(StateHasChanged); }
    }

    public void Dispose()
    {
        Store.Changed -= OnStoreChanged;
        Keys.Unregister(this);
    }
}
