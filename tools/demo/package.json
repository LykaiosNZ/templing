{
  "name": "templing-demo",
  "private": true,
  "description": "A scripted run-through of Templing's demo build (-p:Demo=true) with Puppeteer, for recording demo videos. See walkthrough.mjs.",
  "type": "module",
  "scripts": {
    "walkthrough": "node walkthrough.mjs",
    "record": "node walkthrough.mjs --headless --speed 4 --record templing-demo.webm",
    "record:gif": "node walkthrough.mjs --headless --speed 4 --gif templing-demo.gif",
    "record:mp4": "node walkthrough.mjs --headless --speed 4 --mp4 templing-demo.mp4",
    "record:groups": "node walkthrough.mjs --headless --speed 4 --scenes groups --mp4 templing-groups.mp4"
  },
  "devDependencies": {
    "ffmpeg-static": "5.3.0",
    "puppeteer-core": "24.43.1"
  }
}
