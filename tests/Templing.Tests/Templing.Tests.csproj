<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- the fake JS runtime is called everywhere; the app turns this analyzer off too -->
    <NoWarn>$(NoWarn);BL0016</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Templing.Models" />
    <Using Include="Templing.Services" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Templing\Templing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- sample backups, one per format: BackupTests restores each -->
    <None Include="Backups\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

</Project>
